<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">AssetCatalog</string>
          <string name="Source"><![CDATA[-- AssetCatalog: reads the Buildables folder and measures every Model in
-- it, producing the list the build menu shows and the placement system
-- uses. Server and client both run this over the same folder, so they
-- always agree on sizes.
--
-- Drop ANY Model into ReplicatedStorage/Buildables and it shows up in
-- the build menu automatically — that's the whole convention. Optional
-- extras (set as Attributes on the Model):
--   SpawnsInmate (boolean): marks the asset as housing for one prisoner.
--   Category (string): which bottom-bar button it lives under
--     ("Walls & Doors", "Flooring", "Objects", or any new name you like —
--     unknown names become new toolbar buttons automatically).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local AssetCatalog = {}

-- Returns two views of the same data:
--   byName: { ["Wall"] = asset, ... }        (for lookups)
--   ordered: { asset, asset, ... }           (alphabetical, for the menu)
-- Each asset: { name, model, size, pivotOffset, cellsW, cellsD, spawnsInmate }
function AssetCatalog.load(folder)
	local byName = {}
	local ordered = {}

	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			local boxCF, boxSize = model:GetBoundingBox()
			-- The tiny 0.05 forgiveness means a model exactly GridSize
			-- studs wide counts as 1 square, not accidentally 2.
			local asset = {
				name = model.Name,
				model = model,
				size = boxSize,
				-- Where the model's pivot sits relative to its bounding
				-- box — lets placement rest ANY model on the ground, no
				-- matter how it was built or grouped.
				pivotOffset = boxCF:ToObjectSpace(model:GetPivot()),
				cellsW = math.max(1, math.ceil((boxSize.X - 0.05) / Config.GridSize)),
				cellsD = math.max(1, math.ceil((boxSize.Z - 0.05) / Config.GridSize)),
				spawnsInmate = model:GetAttribute("SpawnsInmate") == true,
				door = model:GetAttribute("Door") == true,
				price = (function()
					local raw = model:GetAttribute("Price")
					if type(raw) == "number" and raw >= 0 then
						return math.floor(raw)
					end
					local categoryName = model:GetAttribute("Category")
					return Config.DefaultPrices[categoryName] or Config.FallbackPrice
				end)(),
				category = (function()
					local raw = model:GetAttribute("Category")
					return (type(raw) == "string" and raw ~= "") and raw or "Objects"
				end)(),
			}
			byName[asset.name] = asset
			table.insert(ordered, asset)
		end
	end

	table.sort(ordered, function(a, b)
		return a.name < b.name
	end)

	return byName, ordered
end

return AssetCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Config: every tunable number and naming convention in one place.
--
-- The two IMPORTANT CONVENTIONS the map-maker (you!) uses in Studio:
--   * Workspace -> a folder named "PlotZones" holding flat, anchored
--     Parts. Each Part is one player's build area. Your map, your rules —
--     the code finds them wherever you put them.
--   * ReplicatedStorage -> a folder named "Buildables" holding Models.
--     Every Model in it automatically appears in the build menu.
-- Full guide: docs/BUILDING_ASSETS.md

local Config = {}

-- Money ------------------------------------------------------------------

Config.StartingCash = 3000

-- Owner switches: FreeBuild ignores all prices; InstantBuild skips the
-- workman/blueprint construction (handy while designing your map).
Config.FreeBuild = false
Config.InstantBuild = false

-- Bulldozing refunds this fraction of the price. Undo refunds 100%.
Config.RefundRate = 0.5

-- Every GrantInterval seconds, each HOUSED prisoner pays their grant.
-- (Waiting handcuffed at the gate pays nothing — house them!)
Config.GrantInterval = 30
Config.GrantPerPrisoner = 60

-- One in-game day, in real seconds (the top-bar clock and DAY counter).
Config.DayLength = 600

-- An asset's price = its "Price" attribute, else its category's default.
Config.DefaultLandPrice = 2000 -- buyable parcels without a Price attribute

Config.DefaultPrices = {
	["Walls & Doors"] = 40,
	["Flooring"] = 10,
	["Objects"] = 250,
}
Config.FallbackPrice = 50

-- Construction -----------------------------------------------------------

-- Placements start as transparent blueprints; workmen walk over and
-- build them (Prison Architect's whole vibe). Workmen are STAFF now —
-- every prison opens with this many on payroll, and more are hired
-- (click-placed) from the Staff tab.
Config.StartingWorkmen = 2
Config.WorkerSpeed = 6 -- studs/sec walking to the job
Config.BuildTimeBase = 1 -- seconds per job...
Config.BuildTimePerCell = 0.5 -- ...plus this per grid square of footprint
Config.WorkerNames = { "Hammer Hank", "Nailgun Ned", "Plank Paul", "Rivet Rita", "Sawdust Sam", "Bolt Betty" }


-- Building ---------------------------------------------------------------

-- Placement grid size in studs. Everything snaps to this. Assets bigger
-- than one grid square automatically take up more squares.
Config.GridSize = 4

-- Rotation happens in steps of 90 degrees (0, 90, 180, 270).

-- Folder names the code looks for (the conventions described up top).
Config.ZonesFolderName = "PlotZones"
Config.BuildablesFolderName = "Buildables"

-- Set attribute "NoPlaceholders" = true on your Buildables folder once
-- you have your own assets and want Claude's placeholder models gone.

-- Regime (the prison's daily schedule) -----------------------------------

-- In-game hours (one day = Config.DayLength real seconds). Prisoners
-- follow this: walking to bed, the canteen, the yard...
Config.Regime = {
	{ from = 0, to = 7, activity = "Sleep" },
	{ from = 7, to = 9, activity = "Eat" },
	{ from = 9, to = 12, activity = "Yard" },
	{ from = 12, to = 13, activity = "Eat" },
	{ from = 13, to = 17, activity = "FreeTime" },
	{ from = 17, to = 19, activity = "Eat" },
	{ from = 19, to = 24, activity = "Sleep" },
}

function Config.activityAt(hour)
	for _, slot in ipairs(Config.Regime) do
		if hour >= slot.from and hour < slot.to then
			return slot.activity
		end
	end
	return "FreeTime"
end

-- Needs -------------------------------------------------------------------

-- 100 = satisfied, 0 = desperate. Decay is per real second; regen only
-- happens in the right place at the right time (canteen during Eat, bed
-- during Sleep, shower/yard during free time...).
Config.NeedDecay = { food = 0.11, sleep = 0.083, hygiene = 0.083, recreation = 0.11 }
Config.NeedRegen = { food = 1.2, sleep = 0.6, hygiene = 1.5, recreation = 0.8 }
Config.SafetyRegen = 0.5 -- with enough guards...
Config.SafetyDecay = 0.15 -- ...without
Config.GuardsPerPrisoners = 4 -- 1 guard covers 4 prisoners
Config.NeedTick = 3 -- seconds between behavior/needs updates

-- Unrest: rises while needs sit below 30, falls when they're met.
-- High unrest cuts grant income (and feeds Phase 5's riots/escapes).
Config.UnrestRise = 0.35
Config.UnrestFall = 0.2

-- Staff -------------------------------------------------------------------

-- Hiring is free; wages charge continuously (per WageInterval slice of a
-- day). Can't pay? Someone quits — cheapest first, workmen last (they're
-- the crew that builds everything). PA's staff menu order: Workman first.
Config.StaffTypes = {
	{ id = "Workman", wage = 40, outfit = "worker" },
	{ id = "Guard", wage = 150, outfit = "guard" },
	{ id = "Cook", wage = 100, outfit = "cook" },
	{ id = "Janitor", wage = 80, outfit = "janitor" },
}
Config.WageInterval = 30
Config.MaxStaffPerType = 10

-- Toolbar categories -----------------------------------------------------

-- The Prison Architect bottom-left toolbar. Assets declare theirs with a
-- "Category" attribute (defaults to "Objects"); a category the code has
-- never seen just becomes a new tab automatically.
Config.AssetCategories = { "Walls & Doors", "Flooring", "Objects" }

-- PA's remaining tabs, rendered dark like its locked tools — each one
-- lights up when its phase ships. icon = a PAIcons drawing name.
Config.ComingSoon = {
	{ icon = "utilities", name = "Utilities", note = "Utilities — pipes & power come in a later phase" },
	{ icon = "deployment", name = "Deployment", note = "Deployment — guard patrol zones come with Phase 5 (security)" },
	{ icon = "logistics", name = "Logistics", note = "Logistics — food & supply routing comes in a later phase" },
	{ icon = "intelligence", name = "Intelligence", note = "Intelligence — informants & contraband come with Phase 5" },
	{ icon = "quickbuild", name = "Quick Build", note = "Quick Build — one-click premade rooms come in a later phase" },
	{ icon = "planning", name = "Planning", note = "Planning — sketch layouts for free comes in a later phase" },
}

-- Security (Phase 5) ------------------------------------------------------

-- Guards patrol on their own: an idle guard rolls PatrolChance every
-- PatrolInterval seconds and wanders to a random walkable square.
Config.PatrolInterval = 5
Config.PatrolChance = 0.5
Config.PatrolSpeed = 4 -- studs/sec on patrol (they RUN during a chase)

-- Escapes: each check, every housed prisoner rolls a chance built from
-- prison-wide unrest plus their own desperation (worst need < 20). The
-- runner sprints for the plot's front row along the walk grid — through
-- doors, never through walls — so a sealed prison keeps everyone in.
Config.EscapeCheckInterval = 6
Config.EscapeUnrestFactor = 0.15 -- per-check chance at 100% unrest
Config.EscapeDesperationChance = 0.06 -- extra for desperate prisoners
Config.EscapeCooldown = 45 -- seconds before the same prisoner retries
Config.EscapeRunSpeed = 5.5 -- studs/sec (faster than an escort walk)
Config.EscapeFine = 500 -- the fine when one gets away

-- A free (or patrolling) guard chases: they aim for a point 70% along
-- the runner's path and win if they can reach it nearly in time.
Config.InterceptFraction = 0.7
Config.GuardCatchGrace = 1.5 -- seconds of slack the guard is allowed

-- Emergencies.
Config.RollCallCooldown = 45 -- seconds between roll calls
Config.LockdownCalm = 0.5 -- unrest drop per second while locked down

-- Foundations ------------------------------------------------------------

-- The 🏗️ tool: drag a rectangle, walls go up around the edge with floor
-- inside (add a door yourself afterward, like PA). It builds using these
-- assets from the Buildables folder — rename here if yours differ.
Config.FoundationWallAsset = "Wall"
Config.FoundationFloorAsset = "Floor Tile"
Config.FoundationMinSize = 3 -- squares per side (needs an interior)
Config.FoundationMaxArea = 400 -- squares per drag

-- Doors ------------------------------------------------------------------

-- Assets with attribute Door = true open for the WARDEN when they walk
-- close (inmates and strangers stay blocked). Parts named "DoorPanel"
-- inside the model are what slides down; no panel named -> the whole
-- model fades open instead.
Config.DoorOpenDistance = 8 -- studs
Config.DoorCheckInterval = 0.25 -- seconds between proximity checks

-- Room requirements ------------------------------------------------------

-- Painted rooms show what they still need, PA-style. "enclosed" means
-- every square just outside the room is filled by a "Walls & Doors"
-- asset (or a Door). attrCounts counts placed objects inside the room
-- carrying that attribute. minCells is the minimum painted size.
Config.RoomRequirements = {
	Cell = { enclosed = true, minCells = 4, attrCounts = { SpawnsInmate = 1 } },
	Canteen = { enclosed = true, minCells = 9 },
	Kitchen = { enclosed = true, minCells = 6 },
	Yard = { minCells = 9 },
	Shower = { enclosed = true, minCells = 4 },
	Workshop = { enclosed = true, minCells = 9 },
	Office = { enclosed = true, minCells = 4 },
	Storage = { enclosed = true, minCells = 4 },
}

-- Friendly names for attrCounts requirements in the floor labels.
Config.RequirementText = {
	SpawnsInmate = "bed",
}

-- Rooms ------------------------------------------------------------------

-- Room types for the room painter (pick one, then drag a rectangle).
-- Colors are the floor-overlay tint players see.
Config.RoomTypes = {
	{ name = "Cell", color = Color3.fromRGB(255, 140, 60) },
	{ name = "Canteen", color = Color3.fromRGB(255, 220, 90) },
	{ name = "Kitchen", color = Color3.fromRGB(235, 90, 80) },
	{ name = "Yard", color = Color3.fromRGB(110, 210, 110) },
	{ name = "Shower", color = Color3.fromRGB(100, 180, 255) },
	{ name = "Workshop", color = Color3.fromRGB(190, 140, 90) },
	{ name = "Office", color = Color3.fromRGB(190, 120, 220) },
	{ name = "Storage", color = Color3.fromRGB(160, 160, 160) },
}

-- Intake -----------------------------------------------------------------

-- Prisoners arrive at the FRONT of the plot (the +Z side of the zone
-- Part — rotate the Part in Studio to choose which side that is),
-- handcuffed, and wait until an empty housing asset exists. Then they're
-- escorted in, uncuffed, and start living there.
Config.MaxWaiting = 6 -- how many can crowd the front gate
Config.IntakeInterval = 12 -- seconds between auto-intake arrivals
Config.EscortSpeed = 4.5 -- studs/sec while being walked to a cell

-- Inmate life ------------------------------------------------------------

Config.WanderRadius = 3.5 -- how far a housed inmate roams from home
Config.WalkSpeed = 3.5 -- studs/sec while wandering

-- Saving ----------------------------------------------------------------

-- How often (seconds) layouts auto-save, on top of saving when a player
-- leaves. Roblox limits DataStore writes, so keep this >= 60.
Config.AutosaveInterval = 60

-- Fallback test map ------------------------------------------------------

-- Only used when Workspace has no PlotZones folder yet: the code builds
-- a simple flat test map so the game always runs. The moment your real
-- map (with a PlotZones folder) exists, none of this happens.
Config.FallbackZoneCount = 2
Config.FallbackZoneSize = 240

-- Flavor ----------------------------------------------------------------

-- Inmate names for assets that spawn an inmate (SpawnsInmate attribute).
Config.InmateNames = {
	"Sneaky Pete", "Tunnel Tim", "Fingers McGee", "Slippery Sam",
	"Crowbar Carl", "Ladder Larry", "Muddy Marv", "Wall-Eye Wally",
	"Shovel Steve", "Grapple Gus", "Lockpick Lou", "Vent-Crawl Vince",
	"Bedsheet Bill", "Spoon Simon", "Laundry Lee", "Big House Bruno",
	"Quiet Quentin", "Two-Step Tony", "Gopher Gil", "Fence-Hop Fred",
	"Papers Pablo", "Half-Inch Hank",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Format: tiny helpers for turning numbers into friendly text,
-- shared by the server (buy-pad price tags) and the client (cash HUD).

local Format = {}

-- 1234567 -> "1,234,567"
function Format.thousands(n)
	local s = tostring(math.floor(n + 0.5))
	while true do
		local replaced
		s, replaced = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		if replaced == 0 then
			break
		end
	end
	return s
end

-- 1234567 -> "$1,234,567"
function Format.money(n)
	return "$" .. Format.thousands(n)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">GridMath</string>
          <string name="Source"><![CDATA[-- GridMath: the snapping math, shared by server and client so the ghost
-- preview on your screen and the server's final placement always agree.
--
-- Grid coordinates are integers: (0, 0) is one corner of a plot zone,
-- and each step is Config.GridSize studs. An asset occupies a rectangle
-- of w x d grid squares; (gx, gz) is the rectangle's smallest corner.
-- Zones can sit anywhere in the map at any rotation — all math happens
-- in the zone's own local space, so grids stay straight on rotated zones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local GRID = Config.GridSize

local GridMath = {}

-- Measure a zone Part once: how many grid squares fit, and the CFrame of
-- the grid's corner on the zone's TOP surface.
function GridMath.zoneInfo(zonePart)
	local size = zonePart.Size
	local cols = math.max(1, math.floor(size.X / GRID))
	local rows = math.max(1, math.floor(size.Z / GRID))
	local corner = zonePart.CFrame * CFrame.new(-cols * GRID / 2, size.Y / 2, -rows * GRID / 2)
	return {
		part = zonePart,
		corner = corner,
		cols = cols,
		rows = rows,
	}
end

-- An asset's footprint in grid squares, after rotation (a 1x3 wall
-- turned 90 degrees occupies 3x1).
function GridMath.footprint(asset, rot)
	if rot % 2 == 0 then
		return asset.cellsW, asset.cellsD
	end
	return asset.cellsD, asset.cellsW
end

-- World-space CFrame of the CENTER of a w x d footprint whose corner is
-- at grid square (gx, gz), sitting on the zone's top surface.
function GridMath.regionCenter(zoneInfo, gx, gz, w, d)
	return zoneInfo.corner * CFrame.new((gx + w / 2) * GRID, 0, (gz + d / 2) * GRID)
end

-- Convert a world position (wherever the player is pointing) into the
-- nearest valid grid corner for a w x d footprint, clamped inside the zone.
function GridMath.worldToCell(zoneInfo, worldPos, w, d)
	local localPos = zoneInfo.corner:PointToObjectSpace(worldPos)
	local gx = math.floor(localPos.X / GRID - w / 2 + 0.5)
	local gz = math.floor(localPos.Z / GRID - d / 2 + 0.5)
	gx = math.clamp(gx, 0, math.max(0, zoneInfo.cols - w))
	gz = math.clamp(gz, 0, math.max(0, zoneInfo.rows - d))
	return gx, gz
end

function GridMath.inBounds(zoneInfo, gx, gz, w, d)
	return gx >= 0 and gz >= 0 and gx + w <= zoneInfo.cols and gz + d <= zoneInfo.rows
end

-- Which grid squares a flat marker Part covers (land parcels, lock
-- overlays). The part must not be rotated relative to its zone.
function GridMath.partRect(zoneInfo, part)
	local localPos = zoneInfo.corner:PointToObjectSpace(part.Position)
	local halfX, halfZ = part.Size.X / 2, part.Size.Z / 2
	local x1 = math.floor((localPos.X - halfX) / GRID + 0.05)
	local z1 = math.floor((localPos.Z - halfZ) / GRID + 0.05)
	local x2 = math.ceil((localPos.X + halfX) / GRID - 0.05) - 1
	local z2 = math.ceil((localPos.Z + halfZ) / GRID - 0.05) - 1
	x1 = math.clamp(x1, 0, zoneInfo.cols - 1)
	z1 = math.clamp(z1, 0, zoneInfo.rows - 1)
	x2 = math.clamp(math.max(x1, x2), 0, zoneInfo.cols - 1)
	z2 = math.clamp(math.max(z1, z2), 0, zoneInfo.rows - 1)
	return x1, z1, x2, z2
end

-- Turn a drag from square (x1,z1) to (x2,z2) into a straight line of
-- squares along the dominant axis (PA-style wall dragging). Returns the
-- line's start square, the axis ("x" or "z"), and how many squares.
function GridMath.lineCells(x1, z1, x2, z2)
	local dx, dz = x2 - x1, z2 - z1
	if math.abs(dx) >= math.abs(dz) then
		return math.min(x1, x2), z1, "x", math.abs(dx) + 1
	end
	return x1, math.min(z1, z2), "z", math.abs(dz) + 1
end

-- The final world CFrame for a placed asset: footprint center, raised by
-- half the asset's height, spun by the rotation, then adjusted by the
-- asset's own pivot offset so ANY model lands resting on the ground.
function GridMath.placementPivot(zoneInfo, asset, gx, gz, rot)
	local w, d = GridMath.footprint(asset, rot)
	local center = GridMath.regionCenter(zoneInfo, gx, gz, w, d)
	local boundingBoxTarget = center
		* CFrame.Angles(0, math.rad(rot * 90), 0)
		* CFrame.new(0, asset.size.Y / 2, 0)
	return boundingBoxTarget * asset.pivotOffset, center * CFrame.Angles(0, math.rad(rot * 90), 0)
end

return GridMath
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Lockdown server bootstrap — first thing the game runs.
-- Creates the RemoteFunctions (the "ask the server" phone lines the
-- client UIs use), starts every system in order, and wires the
-- cross-system hooks in one visible place.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

-- Every request returns { ok = true, ... } or { ok = false, err = "why" }.
for _, name in ipairs({
	"PlaceRequest",
	"PlaceLineRequest",
	"PlaceRectRequest",
	"FoundationRequest",
	"DeleteRequest",
	"DeleteManyRequest",
	"DeleteRectRequest",
	"MoveRequest",
	"RoomPaintRequest",
	"IntakeRequest",
	"StaffRequest",
	"EmergencyRequest",
}) do
	local remote = Instance.new("RemoteFunction")
	remote.Name = name
	remote.Parent = remotes
end

remotes.Parent = ReplicatedStorage

local SaveService = require(script.SaveService)
local TimeService = require(script.TimeService)
local EconomyService = require(script.EconomyService)
local Buildables = require(script.Buildables)
local DoorService = require(script.DoorService)
local PathService = require(script.PathService)
local ConstructionService = require(script.ConstructionService)
local PlacementService = require(script.PlacementService)
local RoomService = require(script.RoomService)
local IntakeService = require(script.IntakeService)
local StaffService = require(script.StaffService)
local NeedsService = require(script.NeedsService)
local SecurityService = require(script.SecurityService)
local PlotService = require(script.PlotService)

SaveService.init()
TimeService.init()
EconomyService.init()
Buildables.init()
DoorService.init()
ConstructionService.init()
PlacementService.init()
RoomService.init()
IntakeService.init()
StaffService.init()
NeedsService.init()
SecurityService.init()
PlotService.init()

-- Cross-system wiring, all in one visible place:
-- PathService walks the same occupancy grid placements live on...
PathService.setCellLookup(PlacementService.cellAsset)
-- ...finished construction changes capacity and room validity...
ConstructionService.onCompleted(function(player)
	RoomService.poke(player)
	IntakeService.poke(player)
end)
-- ...and so does moving something...
PlacementService.onMoved(function(player)
	RoomService.poke(player)
	IntakeService.poke(player)
end)
-- ...and capacity = beds in ✓-ready Cell rooms, so room changes matter.
RoomService.onRoomsChanged(function(player)
	IntakeService.poke(player)
end)

print("[Lockdown] Server ready — Phase 5: security, escapes, emergencies")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Buildables</string>
          <string name="Source"><![CDATA[-- Buildables: makes sure the asset folder exists and, until you've made
-- your own models, fills it with simple placeholder assets so the build
-- menu is never empty.
--
-- How replacing works (see docs/BUILDING_ASSETS.md):
--   * Your Models in ReplicatedStorage/Buildables always win — a
--     placeholder is only added if no model with that name exists yet.
--   * Done with placeholders entirely? Set attribute NoPlaceholders =
--     true on the Buildables folder and they all stay away.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local AssetCatalog = require(ReplicatedStorage.Shared.AssetCatalog)

local Buildables = {}

local GRAY = Color3.fromRGB(200, 198, 190)
local DARK = Color3.fromRGB(95, 95, 100)
local METAL = Color3.fromRGB(35, 35, 40)

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Concrete
	p.Color = GRAY
	for key, value in pairs(props) do
		p[key] = value
	end
	p.Parent = parent
	return p
end

-- Each builder positions its parts with the model's bottom at Y = 0 and
-- its footprint centered on the origin. The catalog measures the result,
-- so these are just "build it roughly right and it works".
local PLACEHOLDERS = {
	{
		-- A full grid square of solid wall, Prison Architect style — wall
		-- runs tile with no gaps, corners just work.
		name = "Wall",
		category = "Walls & Doors",
		price = 40,
		build = function(model)
			part({ Size = Vector3.new(4, 8, 4), CFrame = CFrame.new(0, 4, 0) }, model)
		end,
	},
	{
		name = "Floor Tile",
		category = "Flooring",
		price = 10,
		build = function(model)
			part({ Size = Vector3.new(4, 0.4, 4), CFrame = CFrame.new(0, 0.2, 0), Color = DARK }, model)
		end,
	},
	{
		name = "Fence",
		category = "Walls & Doors",
		price = 30,
		build = function(model)
			for i = 0, 4 do
				part({
					Size = Vector3.new(0.3, 6, 0.3),
					CFrame = CFrame.new(-1.8 + i * 0.9, 3, 0),
					Material = Enum.Material.Metal,
					Color = METAL,
				}, model)
			end
			part({
				Size = Vector3.new(4, 0.3, 0.3),
				CFrame = CFrame.new(0, 5.85, 0),
				Material = Enum.Material.Metal,
				Color = METAL,
			}, model)
		end,
	},
	{
		-- Same width and thinness as the Fence, so a door drops cleanly
		-- into a fence run.
		name = "Security Door",
		category = "Walls & Doors",
		price = 150,
		build = function(model)
			part({ Size = Vector3.new(0.4, 8, 0.4), CFrame = CFrame.new(-1.8, 4, 0) }, model)
			part({ Size = Vector3.new(0.4, 8, 0.4), CFrame = CFrame.new(1.8, 4, 0) }, model)
			part({ Size = Vector3.new(4, 0.5, 0.4), CFrame = CFrame.new(0, 7.75, 0) }, model)
			-- The sliding slab: DoorService animates parts with this name.
			part({
				Name = "DoorPanel",
				Size = Vector3.new(3.2, 7, 0.4),
				CFrame = CFrame.new(0, 3.5, 0),
				Material = Enum.Material.DiamondPlate,
				Color = Color3.fromRGB(91, 105, 117),
			}, model)
			model:SetAttribute("Door", true)
		end,
	},
	{
		-- Cells aren't prefab objects anymore — you BUILD them: walls, a
		-- door, floor, paint the Cell room, and put a Bed inside. The bed
		-- is what houses a prisoner (SpawnsInmate), but only once its Cell
		-- room shows ✓ ready.
		name = "Bed",
		category = "Objects",
		price = 150,
		build = function(model)
			part({
				Size = Vector3.new(3.4, 0.6, 7),
				CFrame = CFrame.new(0, 0.5, 0),
				Material = Enum.Material.Metal,
				Color = Color3.fromRGB(70, 70, 75),
			}, model)
			part({
				Size = Vector3.new(3.2, 0.6, 6.6),
				CFrame = CFrame.new(0, 1.1, 0),
				Material = Enum.Material.Fabric,
				Color = Color3.fromRGB(235, 235, 230),
			}, model)
			part({
				Size = Vector3.new(2.6, 0.35, 1.5),
				CFrame = CFrame.new(0, 1.55, -2.4),
				Material = Enum.Material.Fabric,
				Color = Color3.fromRGB(255, 170, 60),
			}, model)
			model:SetAttribute("SpawnsInmate", true)
		end,
	},
	{
		name = "Guard Tower",
		category = "Objects",
		price = 400,
		build = function(model)
			for _, offset in ipairs({ { -3, -3 }, { 3, -3 }, { -3, 3 }, { 3, 3 } }) do
				part({
					Size = Vector3.new(1, 10, 1),
					CFrame = CFrame.new(offset[1], 5, offset[2]),
					Material = Enum.Material.Metal,
					Color = METAL,
				}, model)
			end
			part({ Size = Vector3.new(8, 1, 8), CFrame = CFrame.new(0, 10.5, 0), Color = DARK }, model)
			for _, offset in ipairs({ { -3.5, -3.5 }, { 3.5, -3.5 }, { -3.5, 3.5 }, { 3.5, 3.5 } }) do
				part({
					Size = Vector3.new(0.5, 4, 0.5),
					CFrame = CFrame.new(offset[1], 13, offset[2]),
					Material = Enum.Material.Metal,
					Color = METAL,
				}, model)
			end
			part({ Size = Vector3.new(9, 0.8, 9), CFrame = CFrame.new(0, 15.4, 0), Color = GRAY }, model)
		end,
	},
}

local catalogByName = nil
local catalogOrdered = nil

function Buildables.init()
	local folder = ReplicatedStorage:FindFirstChild(Config.BuildablesFolderName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Config.BuildablesFolderName
		folder.Parent = ReplicatedStorage
	end

	if folder:GetAttribute("NoPlaceholders") ~= true then
		for _, def in ipairs(PLACEHOLDERS) do
			if not folder:FindFirstChild(def.name) then
				local model = Instance.new("Model")
				model.Name = def.name
				def.build(model)
				model:SetAttribute("Placeholder", true)
				model:SetAttribute("Category", def.category)
				model:SetAttribute("Price", def.price)
				model.Parent = folder
			end
		end
	end

	catalogByName, catalogOrdered = AssetCatalog.load(folder)
	print(("[Lockdown] Build menu loaded: %d assets"):format(#catalogOrdered))
end

function Buildables.get(name)
	return catalogByName[name]
end

return Buildables
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ConstructionService</string>
          <string name="Source"><![CDATA[-- ConstructionService: Prison Architect's construction feel. Placements
-- arrive as BLUEPRINTS — see-through, blue-glowing, non-solid — and the
-- WORKMEN ON STAFF walk over (pathfinding around walls, through doors)
-- and hammer them into real objects. The crew is whatever StaffService
-- says it is: hire more workmen under Staff and blueprints go up faster;
-- lose them all to an unpaid payroll and construction simply stops.
--
-- A blueprint isn't functional yet: doors don't work, housing doesn't
-- count as capacity, and it doesn't satisfy room requirements until a
-- workman finishes it. Bulldozing a blueprint refunds in full.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DoorService = require(script.Parent.DoorService)
local PathService = require(script.Parent.PathService)
local StaffService = require(script.Parent.StaffService)

local ConstructionService = {}

local PIVOT_HEIGHT = 3 -- rig pivot rides 3 studs above the feet

-- player -> { zone, busy = {model = true}, queue = { {model, asset, saved} } }
local records = {}
local completionListeners = {} -- fns(player, model, asset)

local function ghostify(model)
	local saved = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(saved, {
				part = descendant,
				transparency = descendant.Transparency,
				canCollide = descendant.CanCollide,
			})
			descendant.Transparency = math.clamp(descendant.Transparency + 0.6, 0.6, 1)
			descendant.CanCollide = false
		end
	end
	local glow = Instance.new("Highlight")
	glow.Name = "BlueprintGlow"
	glow.FillColor = Color3.fromRGB(90, 160, 255)
	glow.FillTransparency = 0.75
	glow.OutlineColor = Color3.fromRGB(120, 190, 255)
	glow.Adornee = model
	glow.Parent = model
	return saved
end

local function completeBlueprint(player, job)
	local model = job.model
	if model.Parent == nil then
		return
	end
	for _, entry in ipairs(job.saved) do
		if entry.part.Parent ~= nil then
			entry.part.Transparency = entry.transparency
			entry.part.CanCollide = entry.canCollide
		end
	end
	local glow = model:FindFirstChild("BlueprintGlow")
	if glow then
		glow:Destroy()
	end
	model:SetAttribute("Blueprint", nil)

	-- Now it's real: doors start working, housing counts, rooms re-check.
	if job.asset.door then
		DoorService.register(model, player)
	end
	for _, fn in ipairs(completionListeners) do
		task.spawn(fn, player, model, job.asset)
	end

	-- A little "ta-da": green flash + a thunk.
	local flash = Instance.new("Highlight")
	flash.FillColor = Color3.fromRGB(120, 255, 140)
	flash.FillTransparency = 0.5
	flash.OutlineColor = Color3.fromRGB(120, 255, 140)
	flash.Adornee = model
	flash.Parent = model
	Debris:AddItem(flash, 0.35)
	local root = model:FindFirstChildWhichIsA("BasePart")
	if root then
		local sound = Instance.new("Sound")
		sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
		sound.Volume = 0.4
		sound.Parent = root
		sound:Play()
		Debris:AddItem(sound, 2)
	end
end

-- Called by PlacementService for every non-instant placement.
function ConstructionService.queueBlueprint(player, _zone, model, asset)
	local rec = records[player]
	if not rec then
		-- No crew (shouldn't happen) — build it instantly rather than never.
		if asset.door then
			DoorService.register(model, player)
		end
		return
	end
	model:SetAttribute("Blueprint", true)
	local saved = ghostify(model)
	table.insert(rec.queue, { model = model, asset = asset, saved = saved })
end

function ConstructionService.onCompleted(fn)
	table.insert(completionListeners, fn)
end

-- Wiring (called by PlotService) ------------------------------------------

function ConstructionService.assignPlayer(player, zone)
	-- The workman models themselves live with StaffService — this record
	-- only tracks the job queue and who's mid-hammer.
	records[player] = { zone = zone, busy = {}, queue = {} }
end

function ConstructionService.releasePlayer(player)
	records[player] = nil
end

function ConstructionService.init()
	task.spawn(function()
		while true do
			task.wait(0.6)
			for player, rec in pairs(records) do
				-- Drop finished/bulldozed jobs off the front of the queue.
				while rec.queue[1] and rec.queue[1].model.Parent == nil do
					table.remove(rec.queue, 1)
				end
				if #rec.queue == 0 then
					continue
				end

				-- Prune busy marks for workmen who quit/were fired mid-job.
				for model in pairs(rec.busy) do
					if model.Parent == nil then
						rec.busy[model] = nil
					end
				end

				-- The crew is the Workmen on staff, right now.
				for _, workman in ipairs(StaffService.getStaff(player, "Workman")) do
					local job = table.remove(rec.queue, 1)
					if not job then
						break
					end
					if rec.busy[workman] then
						-- Not available: put the job back for the next one.
						table.insert(rec.queue, 1, job)
						continue
					end
					if job.model.Parent == nil then
						continue
					end

					-- Pathfind to the blueprint. Unreachable? Requeue at the
					-- back and try again later (build a door!).
					local footprint = {
						gx = job.model:GetAttribute("GX") or 0,
						gz = job.model:GetAttribute("GZ") or 0,
						w = 1,
						d = 1,
					}
					local boxCF, boxSize = job.model:GetBoundingBox()
					footprint.w = math.max(1, math.round(boxSize.X / Config.GridSize))
					footprint.d = math.max(1, math.round(boxSize.Z / Config.GridSize))
					local targetPos = Vector3.new(
						boxCF.Position.X,
						rec.zone.part.Position.Y + rec.zone.part.Size.Y / 2,
						boxCF.Position.Z
					)
					local fromPos = workman:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0)
					local route = PathService.findRoute(rec.zone, fromPos, footprint, targetPos)
					if not route then
						table.insert(rec.queue, job)
						continue
					end
					-- Walk to the square BESIDE the job, never into it — the
					-- route's final point is the blueprint's center, and ending
					-- the walk there desynced client/server (the teleport bug).
					if #route > 1 then
						table.remove(route)
					end

					rec.busy[workman] = true
					local duration = PathService.startWalk(workman, route, Config.WorkerSpeed)
					local cells = footprint.w * footprint.d
					local buildTime = Config.BuildTimeBase + Config.BuildTimePerCell * cells

					task.spawn(function()
						task.wait(duration)
						if workman.Parent == nil then
							-- They quit mid-walk: the job goes back on the pile.
							table.insert(rec.queue, 1, job)
							return
						end
						-- Arrive next to the job and start hammering.
						local stand = route[#route]
						local standCF
						if (stand - targetPos).Magnitude > 0.05 then
							standCF = CFrame.lookAt(stand, targetPos)
						else
							standCF = CFrame.new(stand)
						end
						PathService.finishWalk(workman, standCF * CFrame.new(0, PIVOT_HEIGHT, 0))
						workman:SetAttribute("Working", true)
						task.wait(buildTime)
						workman:SetAttribute("Working", nil)
						if job.model.Parent ~= nil then
							completeBlueprint(player, job)
						end
						rec.busy[workman] = nil
					end)
				end
			end
		end
	end)
end

return ConstructionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DoorService</string>
          <string name="Source"><![CDATA[-- DoorService: makes placed Door assets actually work. When the WARDEN
-- (the plot's owner) walks up, the door's panels slide down into the
-- floor and stop colliding; walk away and it closes. Inmates and other
-- players never trigger it — a closed door is the first real security
-- boundary in the game.
--
-- Conventions (docs/BUILDING_ASSETS.md): the asset has attribute
-- Door = true; parts named "DoorPanel" are what slides. If a door model
-- has no DoorPanel parts, the whole model fades open instead — ugly but
-- functional, so any door the map-maker builds works on day one.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)

local DoorService = {}

local doors = {} -- model -> { player, panels = {part -> closedCF}, fadeAll, open, position }

local TWEEN = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function DoorService.register(model, player)
	local panels = {}
	local found = false
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Name == "DoorPanel" then
			panels[descendant] = descendant.CFrame
			found = true
		end
	end
	if not found then
		-- Fallback: no named panel, so the whole model will fade/unblock.
		for _, descendant in ipairs(model:GetDescendants()) do
			if descendant:IsA("BasePart") then
				panels[descendant] = descendant.CFrame
			end
		end
	end

	doors[model] = {
		player = player,
		panels = panels,
		fadeAll = not found,
		open = false,
		position = model:GetPivot().Position,
	}
	model.Destroying:Connect(function()
		doors[model] = nil
	end)
end

-- Re-measure after the Move tool relocates a door.
function DoorService.updatePosition(model)
	local door = doors[model]
	if door then
		door.position = model:GetPivot().Position
		for part in pairs(door.panels) do
			door.panels[part] = door.open
				and part.CFrame * CFrame.new(0, part.Size.Y * 0.92, 0)
				or part.CFrame
		end
	end
end

local function setOpen(model, door, shouldOpen)
	door.open = shouldOpen
	model:SetAttribute("DoorOpen", shouldOpen)
	for part, closedCF in pairs(door.panels) do
		part.CanCollide = not shouldOpen
		if door.fadeAll then
			TweenService:Create(part, TWEEN, {
				Transparency = shouldOpen and 0.8 or 0,
			}):Play()
		else
			-- Slide down into the floor, leaving a sliver visible.
			local target = shouldOpen
				and closedCF * CFrame.new(0, -(part.Size.Y * 0.92), 0)
				or closedCF
			TweenService:Create(part, TWEEN, { CFrame = target }):Play()
		end
	end
end

function DoorService.init()
	task.spawn(function()
		while true do
			task.wait(Config.DoorCheckInterval)
			-- NPCs mid-walk (escorted prisoners, workmen on the way to a
			-- job) also open doors — a guard is implied. Their live position
			-- must be computed from the walk attributes: the client animates
			-- the walk, so server-side part positions are stale until it ends.
			local now = workspace:GetServerTimeNow()
			local walkers = {}
			for _, npc in ipairs(CollectionService:GetTagged("Inmate")) do
				local start = npc:GetAttribute("EscortStart")
				if start ~= nil then
					local duration = npc:GetAttribute("EscortDur") or 1
					local alpha = math.clamp((now - start) / duration, 0, 1)
					local pathString = npc:GetAttribute("EscortPath")
					if type(pathString) == "string" then
						-- Decode the waypoints and find the point at `alpha`
						-- along the path's total length.
						local y = npc:GetAttribute("EscortY") or 0
						local points = {}
						for pair in string.gmatch(pathString, "[^|]+") do
							local xs, zs = string.match(pair, "([^,]+),([^,]+)")
							local x, z = tonumber(xs), tonumber(zs)
							if x and z then
								table.insert(points, Vector3.new(x, y, z))
							end
						end
						if #points >= 2 then
							local total = 0
							for i = 2, #points do
								total += (points[i] - points[i - 1]).Magnitude
							end
							local walked = alpha * total
							for i = 2, #points do
								local seg = (points[i] - points[i - 1]).Magnitude
								if walked <= seg or i == #points then
									local t = seg > 0 and math.clamp(walked / seg, 0, 1) or 1
									table.insert(walkers, points[i - 1]:Lerp(points[i], t))
									break
								end
								walked -= seg
							end
						end
					else
						local from = npc:GetAttribute("EscortFrom")
						local to = npc:GetAttribute("EscortTo")
						if typeof(from) == "Vector3" and typeof(to) == "Vector3" then
							table.insert(walkers, from:Lerp(to, alpha))
						end
					end
				end
			end

			for model, door in pairs(doors) do
				local character = door.player and door.player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local shouldOpen = root ~= nil
					and (root.Position - door.position).Magnitude < Config.DoorOpenDistance
				if not shouldOpen then
					for _, pos in ipairs(walkers) do
						if (pos - door.position).Magnitude < Config.DoorOpenDistance then
							shouldOpen = true
							break
						end
					end
				end
				if shouldOpen ~= door.open then
					setOpen(model, door, shouldOpen)
				end
			end
		end
	end)
end

return DoorService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- EconomyService: the money. Server-authoritative — a hacked client can
-- ask to spend, never take. Cash lives inside SaveService's player state
-- (so it cloud-saves for free) and mirrors into leaderstats, which both
-- shows it in the player list and feeds the client HUD.
--
-- Income: every GrantInterval seconds each HOUSED prisoner pays their
-- grant (read from the PrisonHoused attribute IntakeService publishes —
-- handcuffed arrivals at the gate pay nothing).
--
-- Config.FreeBuild = true turns all charging off (owner sandbox switch).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SaveService = require(script.Parent.SaveService)

local EconomyService = {}

local wallets = {} -- player -> { st = SaveService state, cashValue = IntValue }
local grantedListeners = {} -- fns(player, amount) — ObjectiveService hooks in

local function onPlayerAdded(player)
	local st = SaveService.waitForData(player)
	if not st or not player:IsDescendantOf(game) then
		return
	end
	if type(st.cash) ~= "number" or st.cash <= 0 then
		st.cash = st.cash or 0
		if st.cash == 0 and (st.totalSpent or 0) == 0 then
			st.cash = Config.StartingCash
		end
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cashValue = Instance.new("IntValue")
	cashValue.Name = "Cash"
	cashValue.Value = math.floor(st.cash)
	cashValue.Parent = leaderstats
	leaderstats.Parent = player

	wallets[player] = { st = st, cashValue = cashValue }
end

function EconomyService.getCash(player)
	local wallet = wallets[player]
	return wallet and wallet.st.cash or 0
end

function EconomyService.credit(player, amount)
	local wallet = wallets[player]
	if not wallet or amount <= 0 then
		return
	end
	wallet.st.cash += amount
	wallet.cashValue.Value = math.floor(wallet.st.cash)
end

-- Spend if affordable. FreeBuild makes everything cost nothing.
function EconomyService.tryCharge(player, amount)
	if Config.FreeBuild or amount <= 0 then
		return true
	end
	local wallet = wallets[player]
	if not wallet or wallet.st.cash < amount then
		return false
	end
	wallet.st.cash -= amount
	wallet.st.totalSpent = (wallet.st.totalSpent or 0) + amount
	wallet.cashValue.Value = math.floor(wallet.st.cash)
	return true
end

function EconomyService.onGranted(fn)
	table.insert(grantedListeners, fn)
end

function EconomyService.init()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		wallets[player] = nil
	end)

	-- The grant tick: housed prisoners pay their keep.
	task.spawn(function()
		while true do
			task.wait(Config.GrantInterval)
			for player in pairs(wallets) do
				local housed = player:GetAttribute("PrisonHoused") or 0
				if housed > 0 then
					-- Miserable prisons pay less: 100% unrest halves grants.
					local unrest = player:GetAttribute("PrisonUnrest") or 0
					local amount = math.floor(housed * Config.GrantPerPrisoner * (1 - unrest / 200))
					if player:GetAttribute("PrisonLockdown") == true then
						amount = math.floor(amount * 0.5) -- locked-down prisons earn half
					end
					EconomyService.credit(player, amount)
					for _, fn in ipairs(grantedListeners) do
						task.spawn(fn, player, amount)
					end
				end
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">InmateService</string>
          <string name="Source"><![CDATA[-- InmateService: builds inmates as LIGHTWEIGHT CUSTOM RIGS.
--
-- This is the performance rule from the game plan, made real. A default
-- Roblox character carries a Humanoid — physics, a 20-state machine,
-- network ownership — and a prison full of those melts phones. Our
-- inmates are just 6 anchored blocks in a Model: no Humanoid, no
-- physics, no collisions, no shadows. Dozens of them cost almost
-- nothing. The gentle "idle sway" that makes them feel alive is done on
-- each player's own device (see client/InmateAnimator.luau), which is
-- free for the server.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local InmateService = {}

local SKIN = Color3.fromRGB(234, 184, 146)
local SHOE = Color3.fromRGB(60, 60, 60)

local function makePart(name, size, color, cframe, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.CFrame = cframe
	p.Anchored = true
	p.CanCollide = false -- players walk through inmates, never trip on them
	p.CanQuery = false -- invisible to raycasts (cheap)
	p.CanTouch = false -- fires no touch events (cheap)
	p.CastShadow = false -- shadows are a real cost with many rigs
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Builds one NPC standing at baseCF (feet on the ground at that spot).
-- cellIndex picks the name and look. opts.outfit = "worker" builds a
-- construction workman (blue overalls, hard hat) instead of an inmate.
function InmateService.spawn(baseCF, cellIndex, parent, opts)
	local outfit = opts and opts.outfit or "inmate"
	local model = Instance.new("Model")
	model.Name = (outfit == "worker" and "Worker" or "Inmate") .. cellIndex

	-- Every NPC gets a slightly different shade and sway rhythm so a
	-- full cellblock doesn't look like a copy-paste army. Seeding with
	-- cellIndex keeps each one looking the same each visit.
	local rng = Random.new(cellIndex * 7919)
	local OUTFITS = {
		worker = { torso = Color3.fromRGB(60 + rng:NextInteger(0, 20), 90, 170), hat = Color3.fromRGB(255, 200, 40), tag = Color3.fromRGB(255, 220, 120) },
		guard = { torso = Color3.fromRGB(45, 55, 100), hat = Color3.fromRGB(25, 30, 50), tag = Color3.fromRGB(150, 180, 255) },
		cook = { torso = Color3.fromRGB(235, 235, 235), hat = Color3.fromRGB(250, 250, 250), tag = Color3.fromRGB(255, 255, 255) },
		janitor = { torso = Color3.fromRGB(60, 130, 80), hat = nil, tag = Color3.fromRGB(170, 255, 190) },
	}
	local look = OUTFITS[outfit]
	local jumpsuit = look and look.torso
		or Color3.fromRGB(255, 120 + rng:NextInteger(0, 40), 25 + rng:NextInteger(0, 25))

	-- Face a random direction inside the cell.
	local root = baseCF * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)

	-- Classic R6 proportions: 2-stud legs, 2-stud torso, 1-stud head.
	makePart("LeftLeg", Vector3.new(1, 2, 1), SHOE, root * CFrame.new(-0.5, 1, 0), model)
	makePart("RightLeg", Vector3.new(1, 2, 1), SHOE, root * CFrame.new(0.5, 1, 0), model)
	local torso = makePart("Torso", Vector3.new(2, 2, 1), jumpsuit, root * CFrame.new(0, 3, 0), model)
	if outfit == "inmate" then
		-- Two dark bands: the classic jailhouse jumpsuit read at a glance.
		-- Unique names so the animator tracks each (it keys parts by name).
		for i, yoff in ipairs({ 3.4, 2.6 }) do
			makePart("Stripe" .. i, Vector3.new(2.05, 0.32, 1.05), Color3.fromRGB(35, 35, 40),
				root * CFrame.new(0, yoff, 0), model)
		end
	end
	makePart("LeftArm", Vector3.new(1, 2, 1), jumpsuit, root * CFrame.new(-1.5, 3, 0), model)
	makePart("RightArm", Vector3.new(1, 2, 1), jumpsuit, root * CFrame.new(1.5, 3, 0), model)
	local head = makePart("Head", Vector3.new(1.2, 1.2, 1.2), SKIN, root * CFrame.new(0, 4.6, 0), model)

	if look and look.hat then
		-- The hat: what separates professionals from prisoners.
		makePart("HardHat", Vector3.new(1.4, 0.35, 1.4), look.hat, root * CFrame.new(0, 5.35, 0), model)
	end

	-- The classic Roblox smile, shipped inside the engine (no download).
	local face = Instance.new("Decal")
	face.Name = "Face"
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head

	-- Floating name tag.
	local nameList = outfit ~= "inmate" and Config.WorkerNames or Config.InmateNames
	local nameIndex = ((cellIndex - 1) % #nameList) + 1
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.new(0, 130, 0, 26)
	tag.StudsOffset = Vector3.new(0, 1.4, 0)
	tag.MaxDistance = 70 -- vanishes when far away: less to draw
	tag.AlwaysOnTop = false
	local tagText = Instance.new("TextLabel")
	tagText.Size = UDim2.new(1, 0, 1, 0)
	tagText.BackgroundTransparency = 1
	tagText.Font = Enum.Font.GothamBold
	tagText.TextScaled = true
	tagText.TextColor3 = Color3.fromRGB(255, 220, 180)
	tagText.TextStrokeTransparency = 0.4
	tagText.Text = nameList[nameIndex]
	model:SetAttribute("NpcName", nameList[nameIndex])
	if look then
		tagText.TextColor3 = look.tag
	end
	tagText.Parent = tag
	tag.Parent = head

	model.PrimaryPart = torso

	-- The client-side animator finds inmates through this tag, and uses
	-- Seed so everyone sways off-beat from their neighbors.
	model:SetAttribute("Seed", rng:NextNumber(0, math.pi * 2))
	CollectionService:AddTag(model, "Inmate")

	model.Parent = parent
	return model
end

return InmateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">IntakeService</string>
          <string name="Source"><![CDATA[-- IntakeService: how prisoners actually arrive (Prison Architect's
-- intake report, Roblox-ified).
--
-- The flow:
--   1. The warden accepts a prisoner (or has auto-intake ON).
--   2. The prisoner appears at the FRONT of the plot — handcuffed,
--      standing still. They cannot move on their own.
--   3. The moment an empty housing asset exists (any placed model with
--      the SpawnsInmate attribute), they're escorted to it: they walk
--      over, the cuffs come off, and they live there — wandering about.
--   4. No room? They wait at the gate, cuffed. A crowd at your gate IS
--      the "build more cells" warning light.
--
-- The escort walk is animated on each player's device (InmateAnimator):
-- the server just stamps attributes (from, to, start time, duration) and
-- does ONE authoritative move at the end — no per-frame replication.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local GridMath = require(ReplicatedStorage.Shared.GridMath)
local Buildables = require(script.Parent.Buildables)
local InmateService = require(script.Parent.InmateService)
local PathService = require(script.Parent.PathService)

local IntakeService = {}

-- The rig's pivot is its torso, exactly 3 studs above the feet (2-stud
-- legs + half the torso). All escort math works in floor positions, so
-- moves add this back to keep feet on the ground.
local PIVOT_HEIGHT = 3

-- player -> {
--   zone, arrivalsFolder, auto, spawnCounter, nextGateSlot,
--   prisoners = array of { model, status = "waiting"|"escorting"|"housed", house },
--   connections = {...},
-- }
local records = {}

local function housingAssets(zone)
	local houses = {}
	for _, model in ipairs(zone.placed:GetChildren()) do
		if model:IsA("Model") and model:GetAttribute("SpawnsInmate") == true
			and model:GetAttribute("Blueprint") ~= true -- unbuilt = no capacity
			and model:GetAttribute("InReadyCellRoom") == true -- bed must sit in a ✓-ready Cell room
		then
			table.insert(houses, model)
		end
	end
	return houses
end

local function houseFloorCF(house)
	local boxCF, boxSize = house:GetBoundingBox()
	-- Bottom-center of the asset, nudged off-center so they don't stand
	-- inside the bed.
	return (boxCF * CFrame.new(-1.5, -boxSize.Y / 2, 1))
end

local function gateCF(zone, slot)
	-- The front of the plot is the zone Part's +Z side (rotate the Part
	-- in Studio to choose which side that is). Slots spread arrivals out
	-- so they queue instead of stacking.
	local size = zone.part.Size
	local offsetX = (slot - (Config.MaxWaiting - 1) / 2) * 3
	return zone.part.CFrame * CFrame.new(offsetX, size.Y / 2, size.Z / 2 - 3)
end

local function addCuffs(model)
	local torso = model.PrimaryPart
	if not torso then
		return
	end
	local cuffs = Instance.new("Part")
	cuffs.Name = "Cuffs"
	cuffs.Anchored = true
	cuffs.CanCollide = false
	cuffs.CanQuery = false
	cuffs.CanTouch = false
	cuffs.CastShadow = false
	cuffs.Material = Enum.Material.Metal
	cuffs.Color = Color3.fromRGB(60, 60, 65)
	cuffs.Size = Vector3.new(1.4, 0.35, 0.35)
	-- In front of the waist, where the client-side pose holds the hands.
	cuffs.CFrame = torso.CFrame * CFrame.new(0, -0.7, -1.05)
	cuffs.Parent = model
end

local function refresh(player)
	local rec = records[player]
	if not rec then
		return
	end

	-- Prune prisoners whose model is gone (e.g. their cell was demolished
	-- with them inside — that's a transfer, not an escape).
	for i = #rec.prisoners, 1, -1 do
		local prisoner = rec.prisoners[i]
		if prisoner.model.Parent == nil then
			table.remove(rec.prisoners, i)
		elseif prisoner.status ~= "waiting" and (not prisoner.house or prisoner.house.Parent == nil) then
			if prisoner.status == "escorting" then
				-- Their destination was demolished mid-walk; back to waiting.
				prisoner.status = "waiting"
				prisoner.house = nil
				PathService.finishWalk(prisoner.model)
			else
				table.remove(rec.prisoners, i)
			end
		end
	end

	-- Try to escort waiting prisoners into empty houses.
	local houses = housingAssets(rec.zone)
	local occupied = {}
	for _, prisoner in ipairs(rec.prisoners) do
		if prisoner.house then
			occupied[prisoner.house] = true
		end
	end

	for _, prisoner in ipairs(rec.prisoners) do
		if prisoner.status == "waiting" then
			local target = nil
			for _, house in ipairs(houses) do
				if not occupied[house] then
					target = house
					break
				end
			end
			if not target then
				break
			end

			-- Pathfind gate -> cell around walls, through doors. No route
			-- means they wait cuffed (rec.stuck warns the warden).
			local model = prisoner.model
			local from = model:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0)
			local to = houseFloorCF(target).Position
			local footprint = { gx = 0, gz = 0, w = 1, d = 1 }
			do
				local asset = Buildables.get(target:GetAttribute("Asset") or "")
				footprint.gx = target:GetAttribute("GX") or 0
				footprint.gz = target:GetAttribute("GZ") or 0
				if asset then
					footprint.w, footprint.d = GridMath.footprint(asset, target:GetAttribute("Rot") or 0)
				end
			end
			local route = PathService.findRoute(rec.zone, from, footprint, to)
			if not route then
				rec.stuck = true
				break
			end
			rec.stuck = false

			occupied[target] = true
			prisoner.status = "escorting"
			prisoner.house = target
			local duration = PathService.startWalk(model, route, Config.EscortSpeed)

			task.delay(duration, function()
				if prisoner.status ~= "escorting" or model.Parent == nil then
					return
				end
				if not prisoner.house or prisoner.house.Parent == nil then
					return -- refresh() already handled the demolition
				end
				-- The one authoritative move: they now live here.
				PathService.finishWalk(model, houseFloorCF(prisoner.house) * CFrame.new(0, PIVOT_HEIGHT, 0))
				model.Parent = prisoner.house -- demolishing the house removes them too
				local cuffs = model:FindFirstChild("Cuffs")
				if cuffs then
					cuffs:Destroy()
				end
				model:SetAttribute("Handcuffed", false)
				prisoner.status = "housed"
				refresh(player)
			end)
		end
	end

	-- Publish the numbers the Intake panel shows.
	local housed, waiting = 0, 0
	for _, prisoner in ipairs(rec.prisoners) do
		if prisoner.status == "waiting" then
			waiting += 1
		else
			housed += 1
		end
	end
	player:SetAttribute("PrisonCapacity", #houses)
	player:SetAttribute("PrisonHoused", housed)
	player:SetAttribute("PrisonWaiting", waiting)
	player:SetAttribute("AutoIntake", rec.auto)
	player:SetAttribute("IntakeStuck", rec.stuck == true and waiting > 0)
end

local function arrive(player, skipGate)
	local rec = records[player]
	if not rec then
		return false, "No plot yet."
	end
	local waiting = 0
	for _, prisoner in ipairs(rec.prisoners) do
		if prisoner.status == "waiting" then
			waiting += 1
		end
	end
	if not skipGate and waiting >= Config.MaxWaiting then
		return false, "The front gate is crowded — house some prisoners first!"
	end

	rec.spawnCounter += 1
	rec.nextGateSlot = (rec.nextGateSlot % Config.MaxWaiting) + 1
	local model = InmateService.spawn(gateCF(rec.zone, rec.nextGateSlot - 1), rec.spawnCounter, rec.arrivalsFolder)
	model:SetAttribute("Handcuffed", true)
	addCuffs(model)
	table.insert(rec.prisoners, { model = model, status = "waiting", house = nil })
	refresh(player)
	return true
end

-- Wiring (called by PlotService) ------------------------------------------

function IntakeService.assignPlayer(player, zone, savedIntake)
	local arrivalsFolder = Instance.new("Folder")
	arrivalsFolder.Name = "Arrivals"
	arrivalsFolder.Parent = zone.part

	local rec = {
		zone = zone,
		arrivalsFolder = arrivalsFolder,
		auto = true,
		spawnCounter = 0,
		nextGateSlot = 0,
		prisoners = {},
		connections = {},
	}
	records[player] = rec

	if type(savedIntake) == "table" then
		rec.auto = savedIntake.auto ~= false
		-- Restore the population: housed prisoners reappear directly in
		-- their homes (no escort theater on rejoin), waiting ones at the gate.
		local houses = housingAssets(zone)
		local housedCount = math.min(tonumber(savedIntake.housed) or 0, #houses)
		for i = 1, housedCount do
			rec.spawnCounter += 1
			local house = houses[i]
			local model = InmateService.spawn(houseFloorCF(house), rec.spawnCounter, house)
			model:SetAttribute("Handcuffed", false)
			table.insert(rec.prisoners, { model = model, status = "housed", house = house })
		end
		local waitingCount = math.min(tonumber(savedIntake.waiting) or 0, Config.MaxWaiting)
		for _ = 1, waitingCount do
			arrive(player, true)
		end
	end

	-- Anything placed or demolished can change capacity — re-check.
	table.insert(rec.connections, zone.placed.ChildAdded:Connect(function()
		task.defer(refresh, player)
	end))
	table.insert(rec.connections, zone.placed.ChildRemoved:Connect(function()
		task.defer(refresh, player)
	end))

	refresh(player)
end

-- The housed prisoners (NeedsService drives their daily life).
function IntakeService.getHoused(player)
	local rec = records[player]
	local out = {}
	if rec then
		for _, prisoner in ipairs(rec.prisoners) do
			if prisoner.status == "housed" and prisoner.model.Parent ~= nil then
				table.insert(out, { model = prisoner.model, house = prisoner.house })
			end
		end
	end
	return out
end

-- Re-check capacity/escorts (used after moves and blueprint completions).
function IntakeService.poke(player)
	refresh(player)
end

function IntakeService.releasePlayer(player)
	local rec = records[player]
	records[player] = nil
	if rec then
		for _, connection in ipairs(rec.connections) do
			connection:Disconnect()
		end
		rec.arrivalsFolder:Destroy()
	end
end

function IntakeService.snapshotIntake(player)
	local rec = records[player]
	if not rec then
		return { housed = 0, waiting = 0, auto = true }
	end
	local housed, waiting = 0, 0
	for _, prisoner in ipairs(rec.prisoners) do
		if prisoner.status == "waiting" then
			waiting += 1
		else
			housed += 1
		end
	end
	return { housed = housed, waiting = waiting, auto = rec.auto }
end

-- Player requests ---------------------------------------------------------

function IntakeService.handleRequest(player, action)
	local rec = records[player]
	if not rec then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if action == "accept" then
		local ok, err = arrive(player)
		if not ok then
			return { ok = false, err = err }
		end
		return { ok = true }
	elseif action == "toggleAuto" then
		rec.auto = not rec.auto
		refresh(player)
		return { ok = true }
	end
	return { ok = false, err = "Bad request." }
end

function IntakeService.init()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes.IntakeRequest.OnServerInvoke = IntakeService.handleRequest

	-- Auto-intake: a new prisoner arrives every IntakeInterval seconds
	-- while there's room to house them (Prison Architect's "Fill Capacity").
	task.spawn(function()
		while true do
			task.wait(Config.IntakeInterval)
			for player, rec in pairs(records) do
				if rec.auto and player:IsDescendantOf(Players) then
					local total = #rec.prisoners
					if total < #housingAssets(rec.zone) then
						arrive(player)
					end
				end
			end
		end
	end)
end

return IntakeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">NeedsService</string>
          <string name="Source"><![CDATA[-- NeedsService: gives every housed prisoner a life. Five needs decay over
-- time (Food, Sleep, Hygiene, Recreation, Safety), and the REGIME (the
-- prison's daily schedule on the shared clock) tells them where to be:
--
--   Sleep    -> walk to their bed, sleep need recovers
--   Eat      -> walk to a ✓-ready Canteen; food recovers ONLY if the food
--               chain is complete (a ✓-ready Kitchen + a hired Cook)
--   Yard     -> walk to a ✓-ready Yard, recreation recovers
--   FreeTime -> shower if grubby (✓-ready Shower), else mill about
--
-- Safety recovers when enough Guards are on staff, decays otherwise.
-- Neglected needs raise UNREST, which cuts grant income (EconomyService)
-- and is the fuse for Phase 5's riots and escapes.
--
-- Movement reuses PathService: the server picks a destination, pathfinds,
-- and tracks a LOGICAL position (updated when a walk finishes) so need
-- math never fights the client-side walk animation.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local GridMath = require(ReplicatedStorage.Shared.GridMath)
local PathService = require(script.Parent.PathService)
local RoomService = require(script.Parent.RoomService)
local IntakeService = require(script.Parent.IntakeService)
local StaffService = require(script.Parent.StaffService)

local NeedsService = {}

local PIVOT_HEIGHT = 3
local ARRIVE_DIST = 8

-- model -> per-prisoner state
local lives = {}
-- player -> zone (set on assign)
local playerZones = {}

local function newLife(pos)
	return {
		needs = { food = 80, sleep = 80, hygiene = 80, recreation = 80, safety = 80 },
		pos = pos, -- logical feet position
		walking = false,
		walkUntil = 0,
	}
end

-- Centre-of-mass world position of the nearest ✓-ready room of a type.
local function readyRoomCenter(player, zone, roomType, fromPos)
	local best, bestDist
	for _, region in ipairs(RoomService.getReadyRegions(player)) do
		if region.type == roomType then
			local sx, sz, n = 0, 0, 0
			for _, cell in ipairs(region.cells) do
				sx += cell[1]
				sz += cell[2]
				n += 1
			end
			local cx, cz = math.floor(sx / n), math.floor(sz / n)
			local pos = GridMath.regionCenter(zone.info, cx, cz, 1, 1).Position
			local dist = (pos - fromPos).Magnitude
			if not bestDist or dist < bestDist then
				best, bestDist = pos, dist
			end
		end
	end
	return best
end

-- Where should this prisoner be right now, which need does being there
-- feed, and is that need actually being provided?
local function resolveActivity(player, zone, life, house, activity)
	if activity == "Sleep" then
		local pos = house and house.Parent and (house:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0))
		return pos, "sleep", pos ~= nil
	elseif activity == "Eat" then
		local pos = readyRoomCenter(player, zone, "Canteen", life.pos)
		-- The food chain: a canteen alone isn't enough — you need a
		-- kitchen making the food and a cook to run it.
		local fed = pos ~= nil
			and readyRoomCenter(player, zone, "Kitchen", life.pos) ~= nil
			and StaffService.hasCook(player)
		return pos, "food", fed
	elseif activity == "Yard" then
		local pos = readyRoomCenter(player, zone, "Yard", life.pos)
		return pos, "recreation", pos ~= nil
	else -- FreeTime
		if life.needs.hygiene < 55 then
			local pos = readyRoomCenter(player, zone, "Shower", life.pos)
			if pos then
				return pos, "hygiene", true
			end
		end
		local pos = house and house.Parent and (house:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0))
		return pos, nil, false
	end
end

local function walkTo(zone, model, life, targetPos)
	local from = life.pos
	-- Target a walkable square near the destination.
	local tx, tz = GridMath.worldToCell(zone.info, targetPos, 1, 1)
	local footprint = { gx = tx, gz = tz, w = 1, d = 1 }
	local route = PathService.findRoute(zone, from, footprint, targetPos)
	if not route then
		return false
	end
	local duration = PathService.startWalk(model, route, Config.WalkSpeed)
	life.walking = true
	life.walkUntil = workspace:GetServerTimeNow() + duration
	task.delay(duration, function()
		if model.Parent == nil then
			return
		end
		PathService.finishWalk(model, CFrame.new(targetPos + Vector3.new(0, PIVOT_HEIGHT, 0)))
		life.pos = targetPos
		life.walking = false
	end)
	return true
end

local function step(player)
	local zone = playerZones[player]
	if not zone then
		return
	end

	local hour = 12
	local epoch = workspace:GetAttribute("ClockEpoch")
	if epoch then
		local frac = ((workspace:GetServerTimeNow() - epoch) % Config.DayLength) / Config.DayLength
		hour = frac * 24
	end
	local activity = Config.activityAt(hour)
	local lockdown = player:GetAttribute("PrisonLockdown") == true
	if lockdown then
		activity = "Sleep" -- lockdown: everyone to their cells, whatever the hour
	end

	local housed = IntakeService.getHoused(player)
	local guardCount = StaffService.count(player, "Guard")
	local janitorCount = StaffService.count(player, "Janitor")
	local prisonerCount = #housed
	local safetyOk = prisonerCount == 0
		or guardCount >= math.ceil(prisonerCount / Config.GuardsPerPrisoners)

	local unrestSum = 0

	for _, entry in ipairs(housed) do
		local model = entry.model
		local life = lives[model]
		if not life then
			life = newLife(model:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0))
			lives[model] = life
		end

		-- Decay.
		for need, rate in pairs(Config.NeedDecay) do
			life.needs[need] = math.max(0, life.needs[need] - rate * Config.NeedTick)
		end
		life.needs.safety = math.clamp(
			life.needs.safety + (safetyOk and Config.SafetyRegen or -Config.SafetyDecay) * Config.NeedTick,
			0, 100
		)

		-- Behaviour: go where the regime says, recover the right need there.
		-- Runners answer to SecurityService, not the regime — just keep
		-- their logical position roughly in sync while they sprint.
		local escaping = model:GetAttribute("Escaping") == true
		if escaping then
			life.pos = model:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0)
			life.walking = false
			life.walkUntil = workspace:GetServerTimeNow() + 2
		elseif not life.walking and workspace:GetServerTimeNow() >= life.walkUntil then
			local target, need, provided = resolveActivity(player, zone, life, entry.house, activity)
			if target and (target - life.pos).Magnitude > ARRIVE_DIST then
				walkTo(zone, model, life, target)
			elseif need and provided then
				local regen = Config.NeedRegen[need] or 0
				-- Janitors give a gentle hygiene bump everywhere.
				life.needs[need] = math.min(100, life.needs[need] + regen * Config.NeedTick)
			end
		end
		if janitorCount > 0 then
			life.needs.hygiene = math.min(100, life.needs.hygiene + 0.1 * janitorCount * Config.NeedTick)
		end

		-- Worst need drives the mood shown over their head.
		local worst, worstVal = "content", 101
		for need, val in pairs(life.needs) do
			if val < worstVal then
				worst, worstVal = need, val
			end
		end
		model:SetAttribute("Mood", worstVal < 25 and worst or (worstVal < 50 and "uneasy" or "content"))
		model:SetAttribute("MoodValue", math.floor(worstVal))

		-- This prisoner's contribution to unrest.
		local avg = 0
		for _, val in pairs(life.needs) do
			avg += val
		end
		avg /= 5
		if avg < 40 then
			unrestSum += (40 - avg)
		end
	end

	-- Prison-wide unrest: nudge toward the neglect level. A lockdown
	-- cools things fast (while the neglected needs quietly pile up for
	-- after — lift it too late and the anger comes right back).
	local unrest = player:GetAttribute("PrisonUnrest") or 0
	if lockdown then
		unrest = math.max(0, unrest - Config.LockdownCalm * Config.NeedTick)
	elseif prisonerCount > 0 then
		local pressure = unrestSum / prisonerCount -- 0..40ish
		if pressure > 8 then
			unrest = math.min(100, unrest + Config.UnrestRise * Config.NeedTick)
		else
			unrest = math.max(0, unrest - Config.UnrestFall * Config.NeedTick)
		end
	else
		unrest = math.max(0, unrest - Config.UnrestFall * Config.NeedTick)
	end
	player:SetAttribute("PrisonUnrest", math.floor(unrest))
	player:SetAttribute("RegimeActivity", activity)
end

function NeedsService.assignPlayer(player, zone)
	playerZones[player] = zone
end

function NeedsService.releasePlayer(player)
	playerZones[player] = nil
	-- Drop lives whose models belong to this zone (cheap: prune dead ones).
	for model in pairs(lives) do
		if model.Parent == nil then
			lives[model] = nil
		end
	end
end

function NeedsService.init()
	task.spawn(function()
		while true do
			task.wait(Config.NeedTick)
			for model in pairs(lives) do
				if model.Parent == nil then
					lives[model] = nil
				end
			end
			for player in pairs(playerZones) do
				step(player)
			end
		end
	end)
end

return NeedsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">PathService</string>
          <string name="Source"><![CDATA[-- PathService: A* pathfinding over the build grid, plus the shared
-- "walk an NPC along a path" machinery that prisoners and workmen use.
--
-- Walkability comes straight from the placement grid: empty squares and
-- Flooring are walkable, walls/fences/objects block, and DOORS COUNT AS
-- PASSABLE (escorts and workmen are allowed through). No route at all —
-- a fully sealed prison with no door — means the walk fails, and the
-- caller shows the player why ("the gate can't reach your cells!").
--
-- The walk itself stays cheap: the server stamps the path onto the model
-- as attributes (a string of waypoints + a start time on the shared
-- server clock) and does ONE authoritative move at the end; every
-- client's InmateAnimator plays the same walk locally.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local GridMath = require(ReplicatedStorage.Shared.GridMath)
local Buildables = require(script.Parent.Buildables)

local PathService = {}

-- Injected by the bootstrap (PlacementService.cellAsset) — a direct
-- require would create a dependency cycle.
local cellLookup = nil
function PathService.setCellLookup(fn)
	cellLookup = fn
end

local function isWalkable(zone, x, z)
	if x < 0 or x >= zone.info.cols or z < 0 or z >= zone.info.rows then
		return false
	end
	if zone.unlocked and not zone.unlocked[x .. ":" .. z] then
		return false -- land they haven't bought yet
	end
	local assetName = cellLookup and cellLookup(zone, x, z)
	if not assetName then
		return true
	end
	local asset = Buildables.get(assetName)
	return asset ~= nil and (asset.category == "Flooring" or asset.door)
end

-- Plain A* on the zone grid (max ~1024 squares — instant).
local function aStar(zone, sx, sz, gx, gz)
	local function key(x, z)
		return x .. ":" .. z
	end
	local open = { { x = sx, z = sz, g = 0, f = math.abs(gx - sx) + math.abs(gz - sz) } }
	local bestG = { [key(sx, sz)] = 0 }
	local cameFrom = {}
	local steps = 0

	while #open > 0 and steps < 4096 do
		steps += 1
		-- Pull the lowest-f node (linear scan is fine at this scale).
		local bestIndex = 1
		for i = 2, #open do
			if open[i].f < open[bestIndex].f then
				bestIndex = i
			end
		end
		local current = table.remove(open, bestIndex)
		if current.x == gx and current.z == gz then
			-- Rebuild the path.
			local path = { { current.x, current.z } }
			local k = key(current.x, current.z)
			while cameFrom[k] do
				local prev = cameFrom[k]
				table.insert(path, 1, { prev[1], prev[2] })
				k = key(prev[1], prev[2])
			end
			return path
		end
		for _, step in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			local nx, nz = current.x + step[1], current.z + step[2]
			if isWalkable(zone, nx, nz) then
				local nk = key(nx, nz)
				local g = current.g + 1
				if bestG[nk] == nil or g < bestG[nk] then
					bestG[nk] = g
					cameFrom[nk] = { current.x, current.z }
					table.insert(open, {
						x = nx,
						z = nz,
						g = g,
						f = g + math.abs(gx - nx) + math.abs(gz - nz),
					})
				end
			end
		end
	end
	return nil
end

-- Drop waypoints that continue in a straight line.
local function compress(path)
	if #path <= 2 then
		return path
	end
	local out = { path[1] }
	for i = 2, #path - 1 do
		local a, b, c = out[#out], path[i], path[i + 1]
		local abx, abz = b[1] - a[1], b[2] - a[2]
		local bcx, bcz = c[1] - b[1], c[2] - b[2]
		if abx * bcz - abz * bcx ~= 0 then
			table.insert(out, b)
		end
	end
	table.insert(out, path[#path])
	return out
end

-- Find a route from a world position to (adjacent to) a footprint.
-- Returns an array of world Vector3 waypoints ending AT targetPos, or nil.
function PathService.findRoute(zone, fromPos, footprint, targetPos)
	-- Wherever they're standing counts as the start even if that square
	-- is technically blocked — A* only needs the neighbors to work.
	local sx, sz = GridMath.worldToCell(zone.info, fromPos, 1, 1)

	-- Candidate goals: every walkable square hugging the footprint edge.
	local candidates = {}
	for x = footprint.gx - 1, footprint.gx + footprint.w do
		for z = footprint.gz - 1, footprint.gz + footprint.d do
			local onEdge = x < footprint.gx or x > footprint.gx + footprint.w - 1
				or z < footprint.gz or z > footprint.gz + footprint.d - 1
			if onEdge and isWalkable(zone, x, z) then
				table.insert(candidates, { x, z, math.abs(x - sx) + math.abs(z - sz) })
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a[3] < b[3]
	end)

	for i = 1, math.min(#candidates, 4) do
		local goal = candidates[i]
		local cells = aStar(zone, sx, sz, goal[1], goal[2])
		if cells then
			cells = compress(cells)
			local points = {}
			for _, cell in ipairs(cells) do
				table.insert(points, GridMath.regionCenter(zone.info, cell[1], cell[2], 1, 1).Position)
			end
			-- Start exactly where they stand, end exactly at the target.
			points[1] = Vector3.new(fromPos.X, points[1] and points[1].Y or fromPos.Y, fromPos.Z)
			table.insert(points, targetPos)
			return points
		end
	end
	return nil
end

-- Stamp a path walk onto a model (clients animate it) and return its
-- duration. The caller is responsible for finishing the walk.
function PathService.startWalk(model, points, speed)
	local total = 0
	for i = 2, #points do
		total += (points[i] - points[i - 1]).Magnitude
	end
	local duration = math.max(0.5, total / speed)

	local encoded = {}
	for _, p in ipairs(points) do
		table.insert(encoded, ("%.1f,%.1f"):format(p.X, p.Z))
	end
	model:SetAttribute("EscortPath", table.concat(encoded, "|"))
	model:SetAttribute("EscortY", points[1].Y)
	model:SetAttribute("EscortFrom", points[1])
	model:SetAttribute("EscortTo", points[#points])
	model:SetAttribute("EscortDur", duration)
	model:SetAttribute("EscortStart", workspace:GetServerTimeNow())
	return duration
end

-- Clear the walk attributes and drop the model at its destination.
-- finalCF is where the pivot ends up (remember the pivot rides 3 studs
-- above the feet).
function PathService.finishWalk(model, finalCF)
	if finalCF then
		model:PivotTo(finalCF)
	end
	model:SetAttribute("EscortStart", nil)
	model:SetAttribute("EscortPath", nil)
	model:SetAttribute("EscortDur", nil)
	model:SetAttribute("EscortFrom", nil)
	model:SetAttribute("EscortTo", nil)
	model:SetAttribute("EscortY", nil)
end

-- Convenience: is this square reachable at all from that position?
function PathService.canReach(zone, fromPos, footprint, targetPos)
	return PathService.findRoute(zone, fromPos, footprint, targetPos) ~= nil
end

-- Public walkability check (StaffService validates click-placement with
-- it; SecurityService picks patrol squares and escape gates).
function PathService.isWalkable(zone, x, z)
	return isWalkable(zone, x, z)
end

-- Walk speed shared by escorts unless the caller overrides.
PathService.DefaultSpeed = Config.EscortSpeed

return PathService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">PlacementService</string>
          <string name="Source"><![CDATA[-- PlacementService: the server half of the building system. The client
-- may PREVIEW anything, but nothing exists until this file approves it.
-- Every request is re-checked here (owner? real asset? inside the zone?
-- not overlapping?) because clients can be modified by cheaters — the
-- golden rule of Roblox: never trust the client.
--
-- It also keeps each player's layout as plain data ({name, x, z, rot}
-- per object), which is what gets cloud-saved and rebuilt on rejoin.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GridMath = require(ReplicatedStorage.Shared.GridMath)
local Config = require(ReplicatedStorage.Shared.Config)
local Buildables = require(script.Parent.Buildables)
local DoorService = require(script.Parent.DoorService)
local EconomyService = require(script.Parent.EconomyService)
local ConstructionService = require(script.Parent.ConstructionService)

local PlacementService = {}

local playerZones = {} -- player -> zone record (set by PlotService)
local occupancy = {} -- zone -> set of "gx:gz" occupied grid squares
local layouts = {} -- player -> array of {n, x, z, r, id, model}
local lastAction = {} -- player -> os.clock() (anti-spam)
local nextId = 0

local function cellKey(gx, gz)
	return gx .. ":" .. gz
end

local function eachCell(gx, gz, w, d, fn)
	for x = gx, gx + w - 1 do
		for z = gz, gz + d - 1 do
			fn(cellKey(x, z))
		end
	end
end

local function regionFree(zone, gx, gz, w, d)
	local taken = occupancy[zone]
	local free = true
	eachCell(gx, gz, w, d, function(key)
		if taken[key] then
			free = false
		end
	end)
	return free
end

local function setRegion(zone, gx, gz, w, d, value)
	local taken = occupancy[zone]
	eachCell(gx, gz, w, d, function(key)
		taken[key] = value
	end)
end

-- Which asset (by name) occupies a grid square — RoomService uses this
-- for enclosure checks. nil = empty.
function PlacementService.cellAsset(zone, gx, gz)
	local taken = occupancy[zone]
	return taken and taken[gx .. ":" .. gz] or nil
end

local movedListeners = {} -- fns(player) — bootstrap wires room/intake pokes
function PlacementService.onMoved(fn)
	table.insert(movedListeners, fn)
end

-- The one true "make it exist" function — used by live purchases and by
-- save-file rebuilds, so they can never behave differently. instant=true
-- (save rebuilds, Config.InstantBuild) skips the blueprint/workman step.
local function placeInternal(player, zone, asset, gx, gz, rot, instant)
	local w, d = GridMath.footprint(asset, rot)
	if not GridMath.inBounds(zone.info, gx, gz, w, d) then
		return nil, "That spot is outside your plot."
	end
	if not regionFree(zone, gx, gz, w, d) then
		return nil, "Something is already there."
	end
	if zone.unlocked then
		local owned = true
		eachCell(gx, gz, w, d, function(key)
			if not zone.unlocked[key] then
				owned = false
			end
		end)
		if not owned then
			return nil, "You don't own that land — buy it first!"
		end
	end

	nextId += 1
	local id = nextId

	local pivot = GridMath.placementPivot(zone.info, asset, gx, gz, rot)
	local model = asset.model:Clone()
	model:PivotTo(pivot)
	-- Attributes double as the client's info source (for previews and
	-- delete-mode) and as debugging breadcrumbs in the Explorer.
	-- (Housing assets keep their SpawnsInmate attribute — IntakeService
	-- counts them as capacity; prisoners arrive via intake, not on
	-- placement.)
	model:SetAttribute("LayoutId", id)
	model:SetAttribute("Asset", asset.name)
	model:SetAttribute("GX", gx)
	model:SetAttribute("GZ", gz)
	model:SetAttribute("Rot", rot)
	model.Parent = zone.placed

	if instant then
		if asset.door then
			DoorService.register(model, player)
		end
	else
		ConstructionService.queueBlueprint(player, zone, model, asset)
	end

	setRegion(zone, gx, gz, w, d, asset.name)
	table.insert(layouts[player], { n = asset.name, x = gx, z = gz, r = rot, id = id, model = model })
	return model
end

-- Wiring (called by PlotService) -----------------------------------------

function PlacementService.assignZone(player, zone, savedLayout)
	playerZones[player] = zone
	occupancy[zone] = {}
	layouts[player] = {}

	-- Rebuild everything from the save. Entries that no longer make
	-- sense (asset renamed/deleted, corrupt data) are skipped quietly —
	-- better to lose one wall than crash the whole load.
	if type(savedLayout) == "table" then
		for _, entry in ipairs(savedLayout) do
			if type(entry) == "table"
				and type(entry.n) == "string"
				and type(entry.x) == "number"
				and type(entry.z) == "number"
				and type(entry.r) == "number"
			then
				local asset = Buildables.get(entry.n)
				if asset then
					placeInternal(player, zone, asset, math.floor(entry.x), math.floor(entry.z), math.floor(entry.r) % 4, true)
				end
			end
		end
	end
end

function PlacementService.releasePlayer(player)
	local zone = playerZones[player]
	playerZones[player] = nil
	layouts[player] = nil
	lastAction[player] = nil
	if zone then
		occupancy[zone] = nil
		zone.placed:ClearAllChildren()
	end
end

-- What SaveService writes to the cloud: just the plain numbers, no
-- Instances or server-only ids.
function PlacementService.snapshotLayout(player)
	local out = {}
	for _, entry in ipairs(layouts[player] or {}) do
		table.insert(out, { n = entry.n, x = entry.x, z = entry.z, r = entry.r })
	end
	return out
end

-- Player requests (via RemoteFunctions) -----------------------------------

local function tooFast(player)
	local now = os.clock()
	if lastAction[player] and now - lastAction[player] < 0.1 then
		return true
	end
	lastAction[player] = now
	return false
end

-- Charge, then place; refund if placement failed. Returns the model plus
-- an error kind ("cash" means stop trying, anything else means that one
-- square failed).
local function paidPlace(player, zone, asset, gx, gz, rot)
	if not EconomyService.tryCharge(player, asset.price) then
		return nil, "cash"
	end
	local model, err = placeInternal(player, zone, asset, gx, gz, rot, Config.InstantBuild)
	if not model then
		EconomyService.credit(player, asset.price)
		return nil, err
	end
	return model
end

local NEED_CASH = "Not enough cash!"

function PlacementService.handlePlace(player, assetName, gx, gz, rot)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if tooFast(player) then
		return { ok = false, err = "Too fast!" }
	end
	if type(assetName) ~= "string" or type(gx) ~= "number" or type(gz) ~= "number" or type(rot) ~= "number" then
		return { ok = false, err = "Bad request." }
	end
	local asset = Buildables.get(assetName)
	if not asset then
		return { ok = false, err = "Unknown asset." }
	end

	local model, err = paidPlace(player, zone, asset, math.floor(gx), math.floor(gz), math.floor(rot) % 4)
	if not model then
		return { ok = false, err = err == "cash" and NEED_CASH or err }
	end
	return { ok = true, model = model, spent = Config.FreeBuild and 0 or asset.price }
end

-- Drag-to-build: place a straight line of a 1x1 asset in one request
-- (walls, fences, floors). Occupied squares along the line are skipped
-- rather than failing the whole drag.
function PlacementService.handlePlaceLine(player, assetName, x1, z1, x2, z2)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if tooFast(player) then
		return { ok = false, err = "Too fast!" }
	end
	if type(assetName) ~= "string" or type(x1) ~= "number" or type(z1) ~= "number"
		or type(x2) ~= "number" or type(z2) ~= "number"
	then
		return { ok = false, err = "Bad request." }
	end
	local asset = Buildables.get(assetName)
	if not asset then
		return { ok = false, err = "Unknown asset." }
	end

	local startX, startZ, axis, rawCount = GridMath.lineCells(
		math.floor(x1), math.floor(z1), math.floor(x2), math.floor(z2)
	)
	-- Pieces auto-face along the drag (long side follows it), and pieces
	-- bigger than one square step by their own length so runs stay solid.
	local rot
	if axis == "x" then
		rot = asset.cellsW >= asset.cellsD and 0 or 1
	else
		rot = asset.cellsW >= asset.cellsD and 1 or 0
	end
	local w, d = GridMath.footprint(asset, rot)
	local step = math.max(1, axis == "x" and w or d)
	local pieces = math.min(math.floor((rawCount - 1) / step) + 1, 64)

	local models = {}
	local broke = false
	for i = 0, pieces - 1 do
		local gx = axis == "x" and startX + i * step or startX
		local gz = axis == "z" and startZ + i * step or startZ
		local model, err = paidPlace(player, zone, asset, gx, gz, rot)
		if model then
			table.insert(models, model)
		elseif err == "cash" then
			broke = true
			break
		end
	end
	if #models == 0 then
		return { ok = false, err = broke and NEED_CASH or "Nothing free along that line." }
	end
	return { ok = true, placed = #models, models = models, broke = broke }
end

-- Rectangle FILL (Prison Architect flooring): tile the whole dragged
-- rectangle with the asset, stepping by its footprint.
function PlacementService.handlePlaceRect(player, assetName, x1, z1, x2, z2, rot)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if tooFast(player) then
		return { ok = false, err = "Too fast!" }
	end
	if type(assetName) ~= "string" or type(x1) ~= "number" or type(z1) ~= "number"
		or type(x2) ~= "number" or type(z2) ~= "number"
	then
		return { ok = false, err = "Bad request." }
	end
	local asset = Buildables.get(assetName)
	if not asset then
		return { ok = false, err = "Unknown asset." }
	end
	rot = math.floor(tonumber(rot) or 0) % 4
	local w, d = GridMath.footprint(asset, rot)

	local minX = math.max(0, math.floor(math.min(x1, x2)))
	local maxX = math.min(zone.info.cols - 1, math.floor(math.max(x1, x2)))
	local minZ = math.max(0, math.floor(math.min(z1, z2)))
	local maxZ = math.min(zone.info.rows - 1, math.floor(math.max(z1, z2)))

	local models = {}
	local broke = false
	for gz = minZ, maxZ, d do
		for gx = minX, maxX, w do
			if #models >= 512 or broke then
				break
			end
			local model, err = paidPlace(player, zone, asset, gx, gz, rot)
			if model then
				table.insert(models, model)
			elseif err == "cash" then
				broke = true
			end
		end
	end
	if #models == 0 then
		return { ok = false, err = broke and NEED_CASH or "No room in that rectangle." }
	end
	return { ok = true, placed = #models, models = models, broke = broke }
end

-- The 🏗️ Foundations tool: drag a rectangle, get perimeter walls and an
-- interior floor in one go (add a door yourself, like PA). Occupied
-- squares are skipped rather than failing the whole build.
function PlacementService.handleFoundation(player, x1, z1, x2, z2)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if tooFast(player) then
		return { ok = false, err = "Too fast!" }
	end
	if type(x1) ~= "number" or type(z1) ~= "number" or type(x2) ~= "number" or type(z2) ~= "number" then
		return { ok = false, err = "Bad request." }
	end
	local wallAsset = Buildables.get(Config.FoundationWallAsset)
	local floorAsset = Buildables.get(Config.FoundationFloorAsset)
	if not wallAsset or not floorAsset then
		return { ok = false, err = ("Foundations need assets named '%s' and '%s' in Buildables."):format(
			Config.FoundationWallAsset, Config.FoundationFloorAsset) }
	end

	local minX = math.max(0, math.floor(math.min(x1, x2)))
	local maxX = math.min(zone.info.cols - 1, math.floor(math.max(x1, x2)))
	local minZ = math.max(0, math.floor(math.min(z1, z2)))
	local maxZ = math.min(zone.info.rows - 1, math.floor(math.max(z1, z2)))
	local width, depth = maxX - minX + 1, maxZ - minZ + 1
	if width < Config.FoundationMinSize or depth < Config.FoundationMinSize then
		return { ok = false, err = ("Foundations need at least %d×%d squares."):format(
			Config.FoundationMinSize, Config.FoundationMinSize) }
	end
	if width * depth > Config.FoundationMaxArea then
		return { ok = false, err = ("Too big — foundations max out at %d squares per drag."):format(
			Config.FoundationMaxArea) }
	end

	local models = {}
	local broke = false
	for z = minZ, maxZ do
		for x = minX, maxX do
			if broke then
				break
			end
			local isBorder = x == minX or x == maxX or z == minZ or z == maxZ
			local model, err = paidPlace(player, zone, isBorder and wallAsset or floorAsset, x, z, 0)
			if model then
				table.insert(models, model)
			elseif err == "cash" then
				broke = true
			end
		end
	end
	if #models == 0 then
		return { ok = false, err = broke and NEED_CASH or "No room for a foundation there." }
	end
	return { ok = true, built = #models, models = models, broke = broke }
end

-- refundRate: bulldozing pays back Config.RefundRate; Undo passes 1.0.
-- Blueprints always refund in full (nothing was built yet).
local function deleteOne(player, zone, model, refundRate)
	-- The model must be a real placed object inside THIS player's zone.
	if typeof(model) ~= "Instance" or not model:IsA("Model") or model.Parent ~= zone.placed then
		return false, "That's not yours to demolish.", 0
	end
	local id = model:GetAttribute("LayoutId")
	local isBlueprint = model:GetAttribute("Blueprint") == true

	local layout = layouts[player]
	for index, entry in ipairs(layout) do
		if entry.id == id then
			local asset = Buildables.get(entry.n)
			local refund = 0
			if asset then
				local w, d = GridMath.footprint(asset, entry.r)
				setRegion(zone, entry.x, entry.z, w, d, nil)
				if not Config.FreeBuild then
					refund = math.floor(asset.price * (isBlueprint and 1 or refundRate))
					EconomyService.credit(player, refund)
				end
			end
			table.remove(layout, index)
			model:Destroy()
			return true, nil, refund
		end
	end
	return false, "Couldn't find that object.", 0
end

function PlacementService.handleDelete(player, model)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if tooFast(player) then
		return { ok = false, err = "Too fast!" }
	end
	local ok, err, refund = deleteOne(player, zone, model, Config.RefundRate)
	if not ok then
		return { ok = false, err = err }
	end
	return { ok = true, refund = refund }
end

-- Batch demolish, used by Undo to revert a whole line or foundation in
-- one request.
function PlacementService.handleDeleteMany(player, models)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if tooFast(player) then
		return { ok = false, err = "Too fast!" }
	end
	if type(models) ~= "table" or #models > 512 then
		return { ok = false, err = "Bad request." }
	end
	local deleted, refundTotal = 0, 0
	for _, model in ipairs(models) do
		local ok, _, refund = deleteOne(player, zone, model, 1)
		if ok then
			deleted += 1
			refundTotal += refund
		end
	end
	if deleted == 0 then
		return { ok = false, err = "Nothing to demolish." }
	end
	return { ok = true, deleted = deleted, refund = refundTotal }
end

-- Rectangle BULLDOZE: demolish everything whose footprint touches the
-- dragged rectangle. Returns the identities so Undo can rebuild them.
function PlacementService.handleDeleteRect(player, x1, z1, x2, z2)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if tooFast(player) then
		return { ok = false, err = "Too fast!" }
	end
	if type(x1) ~= "number" or type(z1) ~= "number" or type(x2) ~= "number" or type(z2) ~= "number" then
		return { ok = false, err = "Bad request." }
	end
	local minX, maxX = math.floor(math.min(x1, x2)), math.floor(math.max(x1, x2))
	local minZ, maxZ = math.floor(math.min(z1, z2)), math.floor(math.max(z1, z2))

	-- Collect first (deleteOne edits the layout list while we scan it).
	local victims = {}
	for _, entry in ipairs(layouts[player]) do
		local asset = Buildables.get(entry.n)
		if asset and #victims < 512 then
			local w, d = GridMath.footprint(asset, entry.r)
			if entry.x <= maxX and entry.x + w - 1 >= minX
				and entry.z <= maxZ and entry.z + d - 1 >= minZ
			then
				table.insert(victims, entry)
			end
		end
	end

	local items = {}
	local refundTotal = 0
	for _, entry in ipairs(victims) do
		local params = { n = entry.n, x = entry.x, z = entry.z, r = entry.r }
		local ok, _, refund = deleteOne(player, zone, entry.model, Config.RefundRate)
		if ok then
			table.insert(items, params)
			refundTotal += refund
		end
	end
	if #items == 0 then
		return { ok = false, err = "Nothing there to bulldoze." }
	end
	return { ok = true, deleted = #items, items = items, refund = refundTotal }
end

-- The Move tool, done properly: free, instant, no blueprint — picking
-- up your own furniture shouldn't cost half its price.
function PlacementService.handleMove(player, model, gx, gz, rot)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if tooFast(player) then
		return { ok = false, err = "Too fast!" }
	end
	if typeof(model) ~= "Instance" or not model:IsA("Model") or model.Parent ~= zone.placed
		or type(gx) ~= "number" or type(gz) ~= "number" or type(rot) ~= "number"
	then
		return { ok = false, err = "Bad request." }
	end
	if model:GetAttribute("Blueprint") == true then
		return { ok = false, err = "That's still under construction!" }
	end
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("Model") then
			return { ok = false, err = "Someone lives there — can't move an occupied cell!" }
		end
	end

	local id = model:GetAttribute("LayoutId")
	local layout = layouts[player]
	for _, entry in ipairs(layout) do
		if entry.id == id then
			local asset = Buildables.get(entry.n)
			if not asset then
				return { ok = false, err = "Can't move that one." }
			end
			gx, gz, rot = math.floor(gx), math.floor(gz), math.floor(rot) % 4
			local oldW, oldD = GridMath.footprint(asset, entry.r)
			local newW, newD = GridMath.footprint(asset, rot)

			-- Free the old squares first so moving within your own
			-- footprint works, then validate the new spot.
			setRegion(zone, entry.x, entry.z, oldW, oldD, nil)
			if not GridMath.inBounds(zone.info, gx, gz, newW, newD)
				or not regionFree(zone, gx, gz, newW, newD)
			then
				setRegion(zone, entry.x, entry.z, oldW, oldD, asset.name)
				return { ok = false, err = "Can't move it there." }
			end

			model:PivotTo(GridMath.placementPivot(zone.info, asset, gx, gz, rot))
			model:SetAttribute("GX", gx)
			model:SetAttribute("GZ", gz)
			model:SetAttribute("Rot", rot)
			setRegion(zone, gx, gz, newW, newD, asset.name)
			entry.x, entry.z, entry.r = gx, gz, rot
			if asset.door then
				DoorService.updatePosition(model)
			end
			for _, fn in ipairs(movedListeners) do
				task.spawn(fn, player)
			end
			return { ok = true }
		end
	end
	return { ok = false, err = "Couldn't find that object." }
end

function PlacementService.init()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes.PlaceRequest.OnServerInvoke = PlacementService.handlePlace
	remotes.PlaceLineRequest.OnServerInvoke = PlacementService.handlePlaceLine
	remotes.FoundationRequest.OnServerInvoke = PlacementService.handleFoundation
	remotes.PlaceRectRequest.OnServerInvoke = PlacementService.handlePlaceRect
	remotes.DeleteRequest.OnServerInvoke = PlacementService.handleDelete
	remotes.DeleteManyRequest.OnServerInvoke = PlacementService.handleDeleteMany
	remotes.DeleteRectRequest.OnServerInvoke = PlacementService.handleDeleteRect
	remotes.MoveRequest.OnServerInvoke = PlacementService.handleMove
end

return PlacementService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- PlotService: finds the build zones in YOUR hand-made map and assigns
-- one to each player who joins.
--
-- The convention (docs/BUILDING_ASSETS.md): put a folder named
-- "PlotZones" in Workspace, and drop flat anchored Parts in it — each
-- Part is one player's build area. Size, position, and rotation are all
-- up to you; the grid adapts.
--
-- No PlotZones folder yet? A simple flat test map gets generated so the
-- game always runs — handy before your real map exists, and it's what
-- the quick-demo Lockdown.rbxlx uses.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local GridMath = require(ReplicatedStorage.Shared.GridMath)
local SaveService = require(script.Parent.SaveService)
local EconomyService = require(script.Parent.EconomyService)
local PlacementService = require(script.Parent.PlacementService)
local RoomService = require(script.Parent.RoomService)
local IntakeService = require(script.Parent.IntakeService)
local StaffService = require(script.Parent.StaffService)
local NeedsService = require(script.Parent.NeedsService)
local SecurityService = require(script.Parent.SecurityService)
local ConstructionService = require(script.Parent.ConstructionService)

local PlotService = {}

local zones = {} -- array of { part, info, placed, owner }

-- Fallback test map (only when your map doesn't exist yet) --------------

local function buildFallbackMap()
	local root = Instance.new("Folder")
	root.Name = "LockdownTestMap"

	local ground = Instance.new("Part")
	ground.Name = "Ground"
	ground.Anchored = true
	ground.Size = Vector3.new(1200, 4, 750)
	ground.CFrame = CFrame.new(0, -2, 0)
	ground.Material = Enum.Material.Grass
	ground.Color = Color3.fromRGB(106, 153, 85)
	ground.Parent = root

	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "Spawn"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.CFrame = CFrame.new(0, 0.5, 170)
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.Parent = root

	local zonesFolder = Instance.new("Folder")
	zonesFolder.Name = Config.ZonesFolderName

	local zoneSize = Config.FallbackZoneSize
	local spacing = zoneSize + 20
	for i = 1, Config.FallbackZoneCount do
		local zone = Instance.new("Part")
		zone.Name = "Zone" .. i
		zone.Anchored = true
		zone.Size = Vector3.new(zoneSize, 1, zoneSize)
		zone.CFrame = CFrame.new((i - (Config.FallbackZoneCount + 1) / 2) * spacing, 0.5, 0)
		zone.Material = Enum.Material.Concrete
		zone.Color = Color3.fromRGB(163, 162, 165)

		-- Demo land parcels (quarters): front-left free, the rest buyable —
		-- the same convention the owner uses in their own map.
		local quarter = zoneSize / 4
		for _, quad in ipairs({
			{ -quarter, quarter, 0 }, -- front-left: free starting land
			{ quarter, quarter, 2000 },
			{ -quarter, -quarter, 2500 },
			{ quarter, -quarter, 3000 },
		}) do
			local parcel = Instance.new("Part")
			parcel.Name = "Land"
			parcel.Anchored = true
			parcel.Size = Vector3.new(zoneSize / 2, 0.5, zoneSize / 2)
			parcel.CFrame = zone.CFrame * CFrame.new(quad[1], 0.5, quad[2])
			parcel.Transparency = 1
			parcel.CanCollide = false
			if quad[3] > 0 then
				parcel:SetAttribute("Price", quad[3])
			end
			parcel.Parent = zone
		end
		zone.Parent = zonesFolder
	end
	zonesFolder.Parent = root

	root.Parent = workspace
	Lighting.ClockTime = 14
	Lighting.Brightness = 2
	print("[Lockdown] No " .. Config.ZonesFolderName .. " folder found — built the fallback test map.")
	return zonesFolder
end

-- Zone management --------------------------------------------------------

local function discoverZones()
	local folder = workspace:FindFirstChild(Config.ZonesFolderName)
	if not folder or #folder:GetChildren() == 0 then
		folder = buildFallbackMap()
	end

	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") then
			local placed = Instance.new("Folder")
			placed.Name = "Placed"
			placed.Parent = child
			local info = GridMath.zoneInfo(child)

			-- Land parcels: any Part inside the zone Part marks a region.
			-- No Price attribute (or 0) = free starting land; a Price =
			-- buyable expansion. No parcels at all = whole zone unlocked.
			local parcels = {}
			for _, marker in ipairs(child:GetChildren()) do
				if marker:IsA("BasePart") then
					local x1, z1, x2, z2 = GridMath.partRect(info, marker)
					table.insert(parcels, {
						x1 = x1,
						z1 = z1,
						x2 = x2,
						z2 = z2,
						price = math.max(0, math.floor(tonumber(marker:GetAttribute("Price")) or 0)),
					})
					marker.Transparency = 1
					marker.CanCollide = false
					marker.CanQuery = false
					marker.CanTouch = false
				end
			end
			table.sort(parcels, function(a, b)
				if a.z1 ~= b.z1 then
					return a.z1 < b.z1
				end
				return a.x1 < b.x1
			end)
			for i, parcel in ipairs(parcels) do
				parcel.index = i
			end

			table.insert(zones, {
				part = child,
				info = info,
				placed = placed,
				owner = nil,
				parcels = parcels,
				unlocked = nil,
				purchasedList = {},
			})
		else
			warn("[Lockdown] Ignoring '" .. child.Name .. "' in " .. Config.ZonesFolderName .. " — zones must be Parts.")
		end
	end
	print(("[Lockdown] %d build zones ready"):format(#zones))
end

local function unlockParcel(zone, parcel)
	for x = parcel.x1, parcel.x2 do
		for z = parcel.z1, parcel.z2 do
			zone.unlocked[x .. ":" .. z] = true
		end
	end
end

-- A locked parcel: dark slab + price tag + click-to-buy.
local function makeOverlay(player, zone, parcel, folder)
	local G = Config.GridSize
	local w, d = parcel.x2 - parcel.x1 + 1, parcel.z2 - parcel.z1 + 1

	local overlay = Instance.new("Part")
	overlay.Name = "LandOverlay"
	overlay.Anchored = true
	overlay.CanCollide = false
	overlay.CanTouch = false
	overlay.CastShadow = false
	overlay.Material = Enum.Material.SmoothPlastic
	overlay.Color = Color3.fromRGB(35, 35, 40)
	overlay.Transparency = 0.4
	overlay.Size = Vector3.new(w * G - 0.3, 0.5, d * G - 0.3)
	overlay.CFrame = GridMath.regionCenter(zone.info, parcel.x1, parcel.z1, w, d) * CFrame.new(0, 0.3, 0)

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 240, 0, 56)
	gui.StudsOffset = Vector3.new(0, 5, 0)
	gui.MaxDistance = 600
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 130)
	label.TextStrokeTransparency = 0.4
	label.Text = ("🔒 Buy land — %s"):format(Format.money(parcel.price))
	label.Parent = gui
	gui.Parent = overlay

	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 1000
	click.MouseClick:Connect(function(clicker)
		if clicker ~= player or zone.owner ~= player then
			return
		end
		if not EconomyService.tryCharge(player, parcel.price) then
			return
		end
		table.insert(zone.purchasedList, parcel.index)
		unlockParcel(zone, parcel)
		overlay:Destroy()
		RoomService.poke(player)
		IntakeService.poke(player)
	end)
	click.Parent = overlay
	overlay.Parent = folder
end

local function assignZone(player)
	local data = SaveService.waitForData(player)
	if not data or not player:IsDescendantOf(game) then
		return
	end

	local zone = nil
	for _, candidate in ipairs(zones) do
		if candidate.owner == nil then
			zone = candidate
			break
		end
	end
	if not zone then
		warn("[Lockdown] No free build zone for " .. player.Name)
		return
	end

	zone.owner = player

	-- Land: free parcels + previously bought ones unlock; the rest get
	-- purchase overlays. No parcels = the whole zone is buildable.
	zone.purchasedList = {}
	if #zone.parcels > 0 then
		zone.unlocked = {}
		local purchasedSet = {}
		if type(data.land) == "table" then
			for _, idx in ipairs(data.land) do
				purchasedSet[math.floor(tonumber(idx) or -1)] = true
			end
		end
		local lockedFolder = Instance.new("Folder")
		lockedFolder.Name = "LockedLand"
		lockedFolder.Parent = zone.part
		for _, parcel in ipairs(zone.parcels) do
			if parcel.price <= 0 or purchasedSet[parcel.index] then
				unlockParcel(zone, parcel)
				if parcel.price > 0 then
					table.insert(zone.purchasedList, parcel.index)
				end
			else
				makeOverlay(player, zone, parcel, lockedFolder)
			end
		end
	else
		zone.unlocked = nil
	end

	PlacementService.assignZone(player, zone, data.layout)
	RoomService.assignZone(player, zone, data.rooms)
	ConstructionService.assignPlayer(player, zone)
	IntakeService.assignPlayer(player, zone, data.intake)
	StaffService.assignPlayer(player, zone, data.staff)
	NeedsService.assignPlayer(player, zone)
	SecurityService.assignPlayer(player, zone)
	SaveService.attachSource(player, "layout", PlacementService.snapshotLayout)
	SaveService.attachSource(player, "rooms", RoomService.snapshotRooms)
	SaveService.attachSource(player, "intake", IntakeService.snapshotIntake)
	SaveService.attachSource(player, "land", function()
		return zone.purchasedList
	end)
	SaveService.attachSource(player, "staff", StaffService.snapshotStaff)

	-- Tell this player's client which zone is theirs (the build UI needs
	-- it for grid math and aiming).
	local marker = Instance.new("ObjectValue")
	marker.Name = "BuildZone"
	marker.Value = zone.part
	marker.Parent = player

	-- Walk each character spawn over to their zone's front edge.
	local function placeCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if not root or zone.owner ~= player then
			return
		end
		task.wait(0.1)
		local zoneCF, zoneSize = zone.part.CFrame, zone.part.Size
		local edge = zoneCF * CFrame.new(0, zoneSize.Y / 2 + 3.5, zoneSize.Z / 2 + 6)
		local lookTarget = zoneCF * CFrame.new(0, zoneSize.Y / 2 + 3.5, 0)
		character:PivotTo(CFrame.lookAt(edge.Position, lookTarget.Position))
	end
	player.CharacterAdded:Connect(placeCharacter)
	if player.Character then
		task.spawn(placeCharacter, player.Character)
	end
end

local function releaseZone(player)
	SecurityService.releasePlayer(player)
	NeedsService.releasePlayer(player)
	StaffService.releasePlayer(player)
	IntakeService.releasePlayer(player)
	ConstructionService.releasePlayer(player)
	RoomService.releasePlayer(player)
	PlacementService.releasePlayer(player)
	local marker = player:FindFirstChild("BuildZone")
	if marker then
		marker:Destroy()
	end
	for _, zone in ipairs(zones) do
		if zone.owner == player then
			zone.owner = nil
			local locked = zone.part:FindFirstChild("LockedLand")
			if locked then
				locked:Destroy()
			end
		end
	end
end

function PlotService.init()
	discoverZones()

	Players.PlayerAdded:Connect(function(player)
		task.spawn(assignZone, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(assignZone, player)
	end
	Players.PlayerRemoving:Connect(releaseZone)
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">RoomService</string>
          <string name="Source"><![CDATA[-- RoomService: Prison Architect-style room designation. The player picks
-- a room type FIRST, then drags a rectangle on their plot; the floor
-- tints with that room's color. Painting is per grid square underneath
-- everything else, so walls and objects sit on top of it naturally.
--
-- For now rooms are paint — the meaning (a Cell needs a bed, inmates eat
-- in the Canteen) arrives with the needs/economy phases, and this data
-- is already saved per square so nothing will need repainting.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local GridMath = require(ReplicatedStorage.Shared.GridMath)
local Buildables = require(script.Parent.Buildables)

local RoomService = {}

local GRID = Config.GridSize

-- Fired (with the zone's owner) after any requirements re-evaluation —
-- the bootstrap wires this to IntakeService so capacity follows rooms.
local changedListeners = {}
function RoomService.onRoomsChanged(fn)
	table.insert(changedListeners, fn)
end

local playerZones = {} -- player -> zone record
local zoneRooms = {} -- zone -> { map = {["x:z"] = typeId], tilesFolder, rowParts = {[z] = {parts}} }

local function cellKey(x, z)
	return x .. ":" .. z
end

-- Rendering: one thin colored strip per run of same-type squares in a
-- row — a 10x10 room is ~10 parts, not 100.
local function renderRow(zone, z)
	local state = zoneRooms[zone]
	if state.rowParts[z] then
		for _, p in ipairs(state.rowParts[z]) do
			p:Destroy()
		end
	end
	state.rowParts[z] = {}

	local cols = zone.info.cols
	local x = 0
	while x < cols do
		local t = state.map[cellKey(x, z)]
		if t then
			local runStart = x
			while x < cols and state.map[cellKey(x, z)] == t do
				x += 1
			end
			local len = x - runStart
			local strip = Instance.new("Part")
			strip.Anchored = true
			strip.CanCollide = false
			strip.CanQuery = false
			strip.CanTouch = false
			strip.CastShadow = false
			strip.Material = Enum.Material.SmoothPlastic
			strip.Transparency = 0.35
			strip.Color = Config.RoomTypes[t].color
			strip.Size = Vector3.new(len * GRID, 0.12, GRID)
			strip.CFrame = zone.info.corner * CFrame.new((runStart + len / 2) * GRID, 0.07, (z + 0.5) * GRID)
			strip.Name = "RoomStrip"
			strip.Parent = state.tilesFolder
			table.insert(state.rowParts[z], strip)
		else
			x += 1
		end
	end
end

-- Evaluate a painted region against Config.RoomRequirements. Returns
-- (met, statusText). blockedCells = squares covered by BUILT walls/doors
-- (blueprints don't enclose anything yet).
local function evaluateRegion(zone, typeName, regionCells, placedInfos, blockedCells)
	local req = Config.RoomRequirements[typeName]
	if not req then
		return true, "✓"
	end
	local missing = {}

	if req.minCells and #regionCells < req.minCells then
		table.insert(missing, ("bigger room (%d/%d)"):format(#regionCells, req.minCells))
	end

	if req.enclosed then
		local inRegion = {}
		for _, cell in ipairs(regionCells) do
			inRegion[cell[1] .. ":" .. cell[2]] = true
		end
		local enclosed = true
		for _, cell in ipairs(regionCells) do
			for _, step in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
				local nx, nz = cell[1] + step[1], cell[2] + step[2]
				if not inRegion[nx .. ":" .. nz] then
					local outOfBounds = nx < 0 or nx >= zone.info.cols or nz < 0 or nz >= zone.info.rows
					if outOfBounds or not blockedCells[nx .. ":" .. nz] then
						enclosed = false
					end
				end
				if not enclosed then
					break
				end
			end
			if not enclosed then
				break
			end
		end
		if not enclosed then
			table.insert(missing, "surround with walls + a door")
		end
	end

	if req.attrCounts then
		local inRegion = {}
		for _, cell in ipairs(regionCells) do
			inRegion[cell[1] .. ":" .. cell[2]] = true
		end
		for attrName, wanted in pairs(req.attrCounts) do
			local count = 0
			for _, info in ipairs(placedInfos) do
				if info.model:GetAttribute(attrName) == true and not info.blueprint then
					local overlaps = false
					for x = info.gx, info.gx + info.w - 1 do
						for z = info.gz, info.gz + info.d - 1 do
							if inRegion[x .. ":" .. z] then
								overlaps = true
							end
						end
					end
					if overlaps then
						count += 1
					end
				end
			end
			if count < wanted then
				local label = Config.RequirementText[attrName] or attrName
				table.insert(missing, ("%d× %s"):format(wanted - count, label))
			end
		end
	end

	if #missing == 0 then
		return true, ""
	end
	return false, "Needs: " .. table.concat(missing, ", ")
end

-- The room's name written flat on the floor, Prison Architect style.
-- One label per contiguous region, found by flood fill. Each label also
-- shows the region's requirement status (PA's "this room needs...").
local function rebuildLabels(zone)
	local state = zoneRooms[zone]
	state.labelsFolder:ClearAllChildren()

	-- Snapshot the placed objects once for the requirement checks, and
	-- build the set of squares covered by BUILT walls/doors (blueprints
	-- don't enclose or satisfy anything until a workman finishes them).
	local placedInfos = {}
	local blockedCells = {}
	for _, model in ipairs(zone.placed:GetChildren()) do
		local asset = Buildables.get(model:GetAttribute("Asset") or "")
		local gx = model:GetAttribute("GX")
		local gz = model:GetAttribute("GZ")
		local r = model:GetAttribute("Rot")
		if asset and type(gx) == "number" and type(gz) == "number" and type(r) == "number" then
			local w, d = GridMath.footprint(asset, r)
			local blueprint = model:GetAttribute("Blueprint") == true
			table.insert(placedInfos, { model = model, gx = gx, gz = gz, w = w, d = d, blueprint = blueprint })
			if not blueprint and (asset.category == "Walls & Doors" or asset.door) then
				for x = gx, gx + w - 1 do
					for z = gz, gz + d - 1 do
						blockedCells[x .. ":" .. z] = true
					end
				end
			end
		end
	end

	-- Beds only count as prisoner housing inside a ✓-ready Cell room —
	-- clear the stamp first, re-stamp below as regions evaluate.
	for _, info in ipairs(placedInfos) do
		if info.model:GetAttribute("SpawnsInmate") == true then
			info.model:SetAttribute("InReadyCellRoom", nil)
		end
	end

	-- Count the regions that fully meet their requirements, per type —
	-- published as ReadyRooms_<Type> attributes. Ready regions are also
	-- kept queryable (NeedsService sends prisoners to them).
	local readyCounts = {}
	local readyRegions = {}

	local map = state.map
	local seen = {}
	for z = 0, zone.info.rows - 1 do
		for x = 0, zone.info.cols - 1 do
			local startKey = cellKey(x, z)
			local t = map[startKey]
			if t and not seen[startKey] then
				-- Flood-fill the whole connected region of this type.
				seen[startKey] = true
				local stack = { { x, z } }
				local regionCells = {}
				local minX, maxX, minZ, maxZ = x, x, z, z
				while #stack > 0 do
					local cell = table.remove(stack)
					table.insert(regionCells, cell)
					local cx, cz = cell[1], cell[2]
					minX, maxX = math.min(minX, cx), math.max(maxX, cx)
					minZ, maxZ = math.min(minZ, cz), math.max(maxZ, cz)
					for _, step in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
						local nx, nz = cx + step[1], cz + step[2]
						if nx >= 0 and nx < zone.info.cols and nz >= 0 and nz < zone.info.rows then
							local nkey = cellKey(nx, nz)
							if map[nkey] == t and not seen[nkey] then
								seen[nkey] = true
								table.insert(stack, { nx, nz })
							end
						end
					end
				end

				local widthStuds = (maxX - minX + 1) * GRID
				local labelPart = Instance.new("Part")
				labelPart.Name = "RoomLabel"
				labelPart.Anchored = true
				labelPart.CanCollide = false
				labelPart.CanQuery = false
				labelPart.CanTouch = false
				labelPart.CastShadow = false
				labelPart.Transparency = 1
				labelPart.Size = Vector3.new(1, 1, 1)
				labelPart.CFrame = zone.info.corner
					* CFrame.new((minX + maxX + 1) / 2 * GRID, 0.4, (minZ + maxZ + 1) / 2 * GRID)

				local typeName = Config.RoomTypes[t].name
				local met, statusText = evaluateRegion(zone, typeName, regionCells, placedInfos, blockedCells)
				if met then
					readyCounts[typeName] = (readyCounts[typeName] or 0) + 1
					table.insert(readyRegions, { type = typeName, cells = regionCells })
					if typeName == "Cell" then
						-- Stamp the beds inside: they're real housing now.
						local regionSet = {}
						for _, cell in ipairs(regionCells) do
							regionSet[cell[1] .. ":" .. cell[2]] = true
						end
						for _, info in ipairs(placedInfos) do
							if info.model:GetAttribute("SpawnsInmate") == true and not info.blueprint then
								for bx = info.gx, info.gx + info.w - 1 do
									for bz = info.gz, info.gz + info.d - 1 do
										if regionSet[bx .. ":" .. bz] then
											info.model:SetAttribute("InReadyCellRoom", true)
										end
									end
								end
							end
						end
					end
				end

				-- The label: a billboard, so it's always upright and readable
				-- no matter how the camera is rotated (flat floor text went
				-- sideways). Sized in studs so it scales naturally with zoom.
				-- PA rule: a valid room shows just its name; an invalid one
				-- explains what's missing underneath in amber.
				local gui = Instance.new("BillboardGui")
				gui.Name = "Label"
				gui.Size = UDim2.new(math.clamp(widthStuds * 0.8, 10, 24), 0, 4.4, 0)
				gui.StudsOffset = Vector3.new(0, 2, 0)
				gui.MaxDistance = 450
				gui.LightInfluence = 0
				gui.Parent = labelPart

				local title = Instance.new("TextLabel")
				title.Size = UDim2.new(1, 0, met and 0.62 or 0.5, 0)
				title.Position = UDim2.new(0, 0, met and 0.12 or 0, 0)
				title.BackgroundTransparency = 1
				title.Font = Enum.Font.GothamBlack
				title.TextScaled = true
				title.TextColor3 = Color3.fromRGB(255, 255, 255)
				title.TextTransparency = 0.05
				title.TextStrokeColor3 = Color3.fromRGB(15, 18, 22)
				title.TextStrokeTransparency = 0.25
				title.Text = string.upper(typeName)
				title.Parent = gui

				-- A thin underline in the room's color ties name to paint.
				local underline = Instance.new("Frame")
				underline.AnchorPoint = Vector2.new(0.5, 0)
				underline.Position = UDim2.new(0.5, 0, met and 0.78 or 0.52, 0)
				underline.Size = UDim2.new(0.4, 0, 0.06, 0)
				underline.BackgroundColor3 = Config.RoomTypes[t].color
				underline.BorderSizePixel = 0
				underline.Parent = gui

				if not met then
					local needsLabel = Instance.new("TextLabel")
					needsLabel.AnchorPoint = Vector2.new(0, 1)
					needsLabel.Position = UDim2.new(0, 0, 1, 0)
					needsLabel.Size = UDim2.new(1, 0, 0.34, 0)
					needsLabel.BackgroundTransparency = 1
					needsLabel.Font = Enum.Font.GothamBold
					needsLabel.TextScaled = true
					needsLabel.TextColor3 = Color3.fromRGB(255, 196, 120)
					needsLabel.TextStrokeColor3 = Color3.fromRGB(15, 18, 22)
					needsLabel.TextStrokeTransparency = 0.3
					needsLabel.Text = statusText
					needsLabel.Parent = gui
				end

				labelPart.Parent = state.labelsFolder
			end
		end
	end

	state.readyRegions = readyRegions
	if zone.owner then
		for _, roomType in ipairs(Config.RoomTypes) do
			zone.owner:SetAttribute("ReadyRooms_" .. roomType.name, readyCounts[roomType.name] or 0)
		end
		for _, fn in ipairs(changedListeners) do
			task.spawn(fn, zone.owner)
		end
	end
end

local function paintRect(zone, typeId, x1, z1, x2, z2)
	local state = zoneRooms[zone]
	for z = z1, z2 do
		for x = x1, x2 do
			local key = cellKey(x, z)
			if not (zone.unlocked and not zone.unlocked[key]) then
				state.map[key] = typeId ~= 0 and typeId or nil
			end
		end
	end
	for z = z1, z2 do
		renderRow(zone, z)
	end
	rebuildLabels(zone)
end

-- Wiring (called by PlotService) ------------------------------------------

function RoomService.assignZone(player, zone, savedRooms)
	playerZones[player] = zone

	local tilesFolder = Instance.new("Folder")
	tilesFolder.Name = "RoomTiles"
	tilesFolder.Parent = zone.part
	local labelsFolder = Instance.new("Folder")
	labelsFolder.Name = "RoomLabels"
	labelsFolder.Parent = zone.part
	local state = { map = {}, tilesFolder = tilesFolder, labelsFolder = labelsFolder, rowParts = {}, connections = {} }
	zoneRooms[zone] = state

	-- Building or bulldozing can change enclosure and object counts, so
	-- requirement labels re-evaluate (debounced) on any placement change.
	local function queueRebuild()
		if state.rebuildQueued then
			return
		end
		state.rebuildQueued = true
		task.delay(0.2, function()
			state.rebuildQueued = false
			if zoneRooms[zone] == state then
				rebuildLabels(zone)
			end
		end)
	end
	state.queueRebuild = queueRebuild
	table.insert(state.connections, zone.placed.ChildAdded:Connect(queueRebuild))
	table.insert(state.connections, zone.placed.ChildRemoved:Connect(queueRebuild))

	-- Rebuild the paint from the save (stored as horizontal runs).
	if type(savedRooms) == "table" then
		local touchedRows = {}
		for _, run in ipairs(savedRooms) do
			if type(run) == "table"
				and type(run.t) == "number" and Config.RoomTypes[run.t]
				and type(run.x) == "number" and type(run.z) == "number" and type(run.l) == "number"
			then
				local z = math.floor(run.z)
				for x = math.floor(run.x), math.floor(run.x) + math.floor(run.l) - 1 do
					if x >= 0 and x < zone.info.cols and z >= 0 and z < zone.info.rows then
						state.map[cellKey(x, z)] = math.floor(run.t)
					end
				end
				touchedRows[z] = true
			end
		end
		for z in pairs(touchedRows) do
			renderRow(zone, z)
		end
		rebuildLabels(zone)
	end
end

function RoomService.releasePlayer(player)
	local zone = playerZones[player]
	playerZones[player] = nil
	if zone and zoneRooms[zone] then
		for _, connection in ipairs(zoneRooms[zone].connections) do
			connection:Disconnect()
		end
		zoneRooms[zone].tilesFolder:Destroy()
		zoneRooms[zone].labelsFolder:Destroy()
		zoneRooms[zone] = nil
	end
end

-- What SaveService writes: the paint compressed into horizontal runs.
function RoomService.snapshotRooms(player)
	local zone = playerZones[player]
	local state = zone and zoneRooms[zone]
	if not state then
		return {}
	end
	local runs = {}
	for z = 0, zone.info.rows - 1 do
		local x = 0
		while x < zone.info.cols do
			local t = state.map[cellKey(x, z)]
			if t then
				local runStart = x
				while x < zone.info.cols and state.map[cellKey(x, z)] == t do
					x += 1
				end
				table.insert(runs, { t = t, x = runStart, z = z, l = x - runStart })
			else
				x += 1
			end
		end
	end
	return runs
end

-- Player requests ---------------------------------------------------------

-- The ✓-ready room regions for a player's zone: { {type, cells}, ... }.
function RoomService.getReadyRegions(player)
	local zone = playerZones[player]
	local state = zone and zoneRooms[zone]
	return state and state.readyRegions or {}
end

-- Re-evaluate requirements (used after moves and blueprint completions).
function RoomService.poke(player)
	local zone = playerZones[player]
	local state = zone and zoneRooms[zone]
	if state and state.queueRebuild then
		state.queueRebuild()
	end
end

function RoomService.handlePaint(player, typeId, x1, z1, x2, z2)
	local zone = playerZones[player]
	if not zone then
		return { ok = false, err = "You don't have a plot yet." }
	end
	if type(typeId) ~= "number" or type(x1) ~= "number" or type(z1) ~= "number"
		or type(x2) ~= "number" or type(z2) ~= "number"
	then
		return { ok = false, err = "Bad request." }
	end
	typeId = math.floor(typeId)
	if typeId ~= 0 and not Config.RoomTypes[typeId] then
		return { ok = false, err = "Unknown room type." }
	end

	-- Normalize and clamp the rectangle to the zone.
	x1, x2 = math.min(x1, x2), math.max(x1, x2)
	z1, z2 = math.min(z1, z2), math.max(z1, z2)
	x1 = math.clamp(math.floor(x1), 0, zone.info.cols - 1)
	x2 = math.clamp(math.floor(x2), 0, zone.info.cols - 1)
	z1 = math.clamp(math.floor(z1), 0, zone.info.rows - 1)
	z2 = math.clamp(math.floor(z2), 0, zone.info.rows - 1)

	paintRect(zone, typeId, x1, z1, x2, z2)
	return { ok = true }
end

function RoomService.init()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes.RoomPaintRequest.OnServerInvoke = RoomService.handlePaint
end

return RoomService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">SaveService</string>
          <string name="Source"><![CDATA[-- SaveService: cloud-saves each player's prison layout so it's rebuilt
-- exactly as they left it. (Cash returns here when the economy phase is
-- wired back in — the save format already has room for it.)
--
-- Safety rules this file enforces:
--   * If loading a save fails, the player still gets to play — but we
--     REFUSE to save over their cloud data that session. A network
--     hiccup must never wipe someone's prison.
--   * Saves happen when a player leaves, every 60 seconds, and when the
--     server shuts down.
--
-- Studio note: saving works after publishing with "Studio Access to API
-- Services" enabled (SETUP.md). Until then everything plays fine, the
-- layout just resets each session.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local SaveService = {}

-- "_v2" = the placement-era save format. Old v1 saves (the preset-cell
-- prototype) are intentionally left behind in their own bucket.
local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("Lockdown_v2")
	end)
	if ok then
		store = result
	else
		warn("[Lockdown] DataStores unavailable (normal in unpublished Studio). Progress won't save this session.")
	end
end

local state = {} -- player -> { layout, cash, canSave, layoutSource }

local function keyFor(player)
	return "p_" .. player.UserId
end

local function loadData(player)
	if not store then
		return nil, false
	end
	local key = keyFor(player)
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:GetAsync(key)
		end)
		if ok then
			return result, true -- result is nil for a first-time player
		end
		warn(("[Lockdown] Load attempt %d failed for %s"):format(attempt, player.Name))
		task.wait(attempt)
	end
	return nil, false
end

local function onPlayerAdded(player)
	local saved, loadOk = loadData(player)
	if type(saved) ~= "table" then
		saved = nil
	end

	state[player] = {
		layout = saved and saved.layout or {},
		rooms = saved and saved.rooms or {},
		intake = saved and saved.intake or nil,
		cash = saved and saved.cash or 0,
		totalSpent = saved and saved.totalSpent or 0,
		land = saved and saved.land or {},
		playedSeconds = saved and saved.playedSeconds or 0,
		staff = saved and saved.staff or nil,
		-- Only allowed to write to the cloud if the read worked. A failed
		-- read must never let empty data overwrite a real save.
		canSave = store ~= nil and loadOk,
		-- key -> function(player) returning fresh data at save time.
		sources = {},
	}
end

local function saveNow(player)
	local st = state[player]
	if not st or not st.canSave then
		return
	end
	local snapshot = {
		layout = st.sources.layout and st.sources.layout(player) or st.layout,
		rooms = st.sources.rooms and st.sources.rooms(player) or st.rooms,
		intake = st.sources.intake and st.sources.intake(player) or st.intake,
		cash = st.cash,
		totalSpent = st.totalSpent,
		land = st.sources.land and st.sources.land(player) or st.land,
		playedSeconds = st.playedSeconds,
		staff = st.sources.staff and st.sources.staff(player) or st.staff,
	}
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function()
			return snapshot
		end)
	end)
	if not ok then
		warn("[Lockdown] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
end

-- Public API --------------------------------------------------------------

-- Waits until the player's data has loaded (nil if they left meanwhile).
function SaveService.waitForData(player)
	while state[player] == nil and player:IsDescendantOf(game) do
		task.wait(0.05)
	end
	return state[player]
end

-- The live game systems know the current layout/rooms/intake; each hands
-- us the function that snapshots its slice, and every save pulls fresh
-- data through them.
function SaveService.attachSource(player, key, sourceFn)
	local st = state[player]
	if st then
		st.sources[key] = sourceFn
	end
end

function SaveService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		saveNow(player)
		state[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in pairs(state) do
				task.spawn(saveNow, player)
			end
		end
	end)

	game:BindToClose(function()
		for player in pairs(state) do
			saveNow(player)
		end
	end)
end

return SaveService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">SecurityService</string>
          <string name="Source"><![CDATA[-- SecurityService: Phase 5's teeth — guard patrols, escape attempts, and
-- the warden's emergency powers (Lockdown, Roll Call).
--
-- ESCAPES: a prisoner in an angry prison (high unrest) or at the end of
-- their rope (worst need below 20) may bolt for the plot's front row.
-- They run the same A* walk grid as everyone else — out through DOORS,
-- never through walls — so a sealed prison genuinely keeps everyone in.
-- A free (or patrolling) guard gives chase, aiming for a point 70% along
-- the runner's path; reach it nearly in time and the runner is caught
-- and marched back to their cell. No guard fast enough? They're gone:
-- fine paid, capacity lost, alert raised.
--
-- PATROLS: idle guards wander to random walkable squares so the prison
-- feels watched (and chases start from useful places).
--
-- EMERGENCIES: Lockdown confines everyone to their cells (regime forced
-- to Sleep, no new escapes, unrest cools fast, grants halved while it
-- lasts — see NeedsService/EconomyService). Roll Call rounds up every
-- in-progress runner at once, on a cooldown.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local GridMath = require(ReplicatedStorage.Shared.GridMath)
local Buildables = require(script.Parent.Buildables)
local PathService = require(script.Parent.PathService)
local StaffService = require(script.Parent.StaffService)
local IntakeService = require(script.Parent.IntakeService)
local EconomyService = require(script.Parent.EconomyService)

local SecurityService = {}

local PIVOT_HEIGHT = 3

-- player -> { zone, walks, guardBusy, escapes, alertCount, escaped, lastRollCall }
--   walks[model]     = { points, start, duration } (so a walker can be
--                      stopped mid-stride at the right spot)
--   guardBusy[model] = "patrol" | "chase" (chases may interrupt patrols)
--   escapes[model]   = { active, house }
local records = {}

-- Alerts land in a player attribute; the counter prefix guarantees the
-- changed-signal fires even for identical texts (client strips it).
local function alert(player, text)
	local rec = records[player]
	if not rec then
		return
	end
	rec.alertCount += 1
	player:SetAttribute("SecurityAlert", rec.alertCount .. "|" .. text)
end

-- Walk bookkeeping ---------------------------------------------------------

local function pathLength(points)
	local total = 0
	for i = 2, #points do
		total += (points[i] - points[i - 1]).Magnitude
	end
	return total
end

local function pointAlong(points, dist)
	for i = 2, #points do
		local seg = points[i] - points[i - 1]
		local len = seg.Magnitude
		if dist <= len or i == #points then
			if len < 0.001 then
				return points[i]
			end
			return points[i - 1] + seg * math.clamp(dist / len, 0, 1)
		end
		dist -= len
	end
	return points[#points]
end

local function rememberWalk(rec, model, points, duration)
	rec.walks[model] = { points = points, start = workspace:GetServerTimeNow(), duration = duration }
end

-- Where are this walker's feet right now?
local function currentFloorPos(rec, model)
	local walk = rec.walks[model]
	if walk then
		local elapsed = workspace:GetServerTimeNow() - walk.start
		if elapsed < walk.duration then
			local total = pathLength(walk.points)
			return pointAlong(walk.points, total * math.clamp(elapsed / walk.duration, 0, 1))
		end
	end
	return model:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0)
end

-- Halt a walker exactly where the animation has them and return the spot.
local function stopWalk(rec, model)
	local pos = currentFloorPos(rec, model)
	PathService.finishWalk(model, CFrame.new(pos + Vector3.new(0, PIVOT_HEIGHT, 0)))
	rec.walks[model] = nil
	return pos
end

-- Homes --------------------------------------------------------------------

local function houseFloorPos(house)
	local boxCF, boxSize = house:GetBoundingBox()
	return (boxCF * CFrame.new(-1.5, -boxSize.Y / 2, 1)).Position
end

local function houseFootprint(house)
	local footprint = { gx = house:GetAttribute("GX") or 0, gz = house:GetAttribute("GZ") or 0, w = 1, d = 1 }
	local asset = Buildables.get(house:GetAttribute("Asset") or "")
	if asset then
		footprint.w, footprint.d = GridMath.footprint(asset, house:GetAttribute("Rot") or 0)
	end
	return footprint
end

-- March a rounded-up prisoner back to their bed.
local function sendHome(rec, prisoner, house, fromPos)
	if not (house and house.Parent) then
		prisoner:SetAttribute("Escaping", nil)
		return
	end
	local route = PathService.findRoute(rec.zone, fromPos, houseFootprint(house), houseFloorPos(house))
	if not route then
		prisoner:SetAttribute("Escaping", nil)
		return
	end
	local duration = PathService.startWalk(prisoner, route, Config.EscortSpeed)
	rememberWalk(rec, prisoner, route, duration)
	task.delay(duration, function()
		if prisoner.Parent == nil then
			return
		end
		PathService.finishWalk(prisoner, CFrame.new(houseFloorPos(house) + Vector3.new(0, PIVOT_HEIGHT, 0)))
		rec.walks[prisoner] = nil
		prisoner:SetAttribute("Escaping", nil)
	end)
end

-- Escapes ------------------------------------------------------------------

-- The runner's goal: any walkable square on the plot's front row (+Z).
local function frontTarget(zone)
	local cols, rows = zone.info.cols, zone.info.rows
	local mid = math.floor(cols / 2)
	for offset = 0, mid do
		for _, x in ipairs({ mid - offset, mid + offset }) do
			if x >= 0 and x < cols and PathService.isWalkable(zone, x, rows - 1) then
				return x, rows - 1
			end
		end
	end
	return nil
end

-- Round up a runner (lockdown / roll call): stop them where they are and
-- march them home. Returns true if there was an attempt to cancel.
local function cancelEscape(rec, prisoner)
	local attempt = rec.escapes[prisoner]
	if not attempt or not attempt.active then
		return false
	end
	attempt.active = false
	rec.escapes[prisoner] = nil
	if prisoner.Parent == nil then
		return true
	end
	local pos = stopWalk(rec, prisoner)
	sendHome(rec, prisoner, attempt.house, pos)
	return true
end

local function tryEscape(player, rec, entry)
	local prisoner = entry.model
	if rec.escapes[prisoner] then
		return
	end
	if prisoner:GetAttribute("EscortStart") ~= nil then
		return -- mid-walk on someone else's clock (regime/escort)
	end
	local zone = rec.zone
	local now = workspace:GetServerTimeNow()
	prisoner:SetAttribute("EscapeCooldown", now + Config.EscapeCooldown)

	local tx, tz = frontTarget(zone)
	if not tx then
		return
	end
	local fromPos = prisoner:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0)
	local targetPos = GridMath.regionCenter(zone.info, tx, tz, 1, 1).Position
	local route = PathService.findRoute(zone, fromPos, { gx = tx, gz = tz, w = 1, d = 1 }, targetPos)
	if not route then
		return -- sealed tight: the walls are doing their job
	end

	local attempt = { active = true, house = entry.house }
	rec.escapes[prisoner] = attempt
	prisoner:SetAttribute("Escaping", true)
	local duration = PathService.startWalk(prisoner, route, Config.EscapeRunSpeed)
	rememberWalk(rec, prisoner, route, duration)
	local name = prisoner:GetAttribute("NpcName") or "A prisoner"
	alert(player, "🚨 " .. name .. " is making a run for it!")

	-- Can a guard cut them off? Aim for a point partway along the route.
	local total = pathLength(route)
	local interceptPos = pointAlong(route, total * Config.InterceptFraction)
	local tIntercept = duration * Config.InterceptFraction
	local chaser, chaseRoute = nil, nil
	for _, guard in ipairs(StaffService.getStaff(player, "Guard")) do
		local busy = rec.guardBusy[guard]
		if busy == nil or busy == "patrol" then -- chases interrupt patrols
			local gFrom = currentFloorPos(rec, guard)
			local ix, iz = GridMath.worldToCell(zone.info, interceptPos, 1, 1)
			local gRoute = PathService.findRoute(zone, gFrom, { gx = ix, gz = iz, w = 1, d = 1 }, interceptPos)
			if gRoute then
				local gDur = math.max(0.5, pathLength(gRoute) / Config.EscapeRunSpeed)
				local tCatch = math.max(tIntercept, gDur)
				if gDur <= tIntercept + Config.GuardCatchGrace and tCatch < duration then
					chaser, chaseRoute = guard, gRoute
					break
				end
			end
		end
	end

	if chaser then
		stopWalk(rec, chaser) -- drop whatever patrol they were on
		rec.guardBusy[chaser] = "chase"
		local chaseDur = PathService.startWalk(chaser, chaseRoute, Config.EscapeRunSpeed)
		rememberWalk(rec, chaser, chaseRoute, chaseDur)
		local tCatch = math.max(tIntercept, chaseDur)
		task.delay(tCatch, function()
			if chaser.Parent ~= nil then
				stopWalk(rec, chaser)
			end
			if not attempt.active or prisoner.Parent == nil then
				-- Already rounded up (lockdown/roll call) or gone.
				rec.guardBusy[chaser] = nil
				return
			end
			-- CAUGHT.
			attempt.active = false
			rec.escapes[prisoner] = nil
			local pos = stopWalk(rec, prisoner)
			alert(player, "👮 " .. name .. " was caught and marched back to their cell.")
			sendHome(rec, prisoner, attempt.house, pos)
			task.delay(2, function()
				rec.guardBusy[chaser] = nil
			end)
		end)
	end

	-- The gate: still active when the run completes means they're gone.
	task.delay(duration, function()
		if not attempt.active or prisoner.Parent == nil then
			return
		end
		attempt.active = false
		rec.escapes[prisoner] = nil
		rec.walks[prisoner] = nil
		rec.escaped += 1
		player:SetAttribute("PrisonEscapes", rec.escaped)
		EconomyService.tryCharge(player, Config.EscapeFine)
		alert(player, "🚨 " .. name .. " ESCAPED! Fine: " .. Format.money(Config.EscapeFine))
		prisoner:Destroy()
		IntakeService.poke(player)
	end)
end

-- Emergencies --------------------------------------------------------------

function SecurityService.handleRequest(player, action)
	local rec = records[player]
	if not rec then
		return { ok = false, err = "You don't have a plot yet." }
	end

	if action == "lockdown" then
		local on = player:GetAttribute("PrisonLockdown") ~= true
		player:SetAttribute("PrisonLockdown", on)
		if on then
			local rounded = 0
			for prisoner in pairs(rec.escapes) do
				if cancelEscape(rec, prisoner) then
					rounded += 1
				end
			end
			alert(player, rounded > 0
				and ("🔒 LOCKDOWN — %d runner%s rounded up."):format(rounded, rounded == 1 and "" or "s")
				or "🔒 LOCKDOWN — everyone to their cells.")
		else
			alert(player, "🔓 Lockdown lifted — back to the regime.")
		end
		return { ok = true, on = on }
	elseif action == "rollcall" then
		local now = workspace:GetServerTimeNow()
		local remaining = Config.RollCallCooldown - (now - rec.lastRollCall)
		if remaining > 0 then
			return { ok = false, err = ("wait %ds"):format(math.ceil(remaining)) }
		end
		rec.lastRollCall = now
		local rounded = 0
		for prisoner in pairs(rec.escapes) do
			if cancelEscape(rec, prisoner) then
				rounded += 1
			end
		end
		local housedCount = #IntakeService.getHoused(player)
		alert(player, rounded > 0
			and ("📢 Roll call: %d runner%s rounded up, %d accounted for."):format(
				rounded, rounded == 1 and "" or "s", housedCount)
			or ("📢 Roll call: all %d prisoners accounted for."):format(housedCount))
		return { ok = true }
	end
	return { ok = false, err = "Bad request." }
end

-- Wiring -------------------------------------------------------------------

function SecurityService.assignPlayer(player, zone)
	records[player] = {
		zone = zone,
		walks = {},
		guardBusy = {},
		escapes = {},
		alertCount = 0,
		escaped = 0,
		lastRollCall = 0,
	}
	player:SetAttribute("PrisonLockdown", false)
	player:SetAttribute("PrisonEscapes", 0)
end

function SecurityService.releasePlayer(player)
	records[player] = nil
end

function SecurityService.init()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes.EmergencyRequest.OnServerInvoke = SecurityService.handleRequest

	-- Patrols: idle guards wander — presence is deterrence (and chases
	-- start from useful places).
	task.spawn(function()
		while true do
			task.wait(Config.PatrolInterval)
			for player, rec in pairs(records) do
				for model in pairs(rec.guardBusy) do
					if model.Parent == nil then
						rec.guardBusy[model] = nil
					end
				end
				for model in pairs(rec.walks) do
					if model.Parent == nil then
						rec.walks[model] = nil
					end
				end
				local zone = rec.zone
				for _, guard in ipairs(StaffService.getStaff(player, "Guard")) do
					if rec.guardBusy[guard] == nil
						and guard:GetAttribute("EscortStart") == nil
						and math.random() < Config.PatrolChance
					then
						for _ = 1, 6 do
							local x = math.random(0, zone.info.cols - 1)
							local z = math.random(0, zone.info.rows - 1)
							if PathService.isWalkable(zone, x, z) then
								local fromPos = guard:GetPivot().Position - Vector3.new(0, PIVOT_HEIGHT, 0)
								local targetPos = GridMath.regionCenter(zone.info, x, z, 1, 1).Position
								local route = PathService.findRoute(
									zone, fromPos, { gx = x, gz = z, w = 1, d = 1 }, targetPos)
								if route then
									rec.guardBusy[guard] = "patrol"
									local duration = PathService.startWalk(guard, route, Config.PatrolSpeed)
									rememberWalk(rec, guard, route, duration)
									task.delay(duration, function()
										if guard.Parent == nil then
											return
										end
										-- A chase may have taken over this guard
										-- mid-patrol — only land the patrol if
										-- this walk is still theirs.
										local walk = rec.walks[guard]
										if walk and walk.points == route then
											PathService.finishWalk(guard,
												CFrame.new(targetPos + Vector3.new(0, PIVOT_HEIGHT, 0)))
											rec.walks[guard] = nil
											rec.guardBusy[guard] = nil
										end
									end)
								end
								break
							end
						end
					end
				end
			end
		end
	end)

	-- Escape checks.
	task.spawn(function()
		while true do
			task.wait(Config.EscapeCheckInterval)
			local now = workspace:GetServerTimeNow()
			for player, rec in pairs(records) do
				if not player:IsDescendantOf(Players) then
					continue
				end
				if player:GetAttribute("PrisonLockdown") == true then
					continue -- confined to cells: nobody runs
				end
				local unrest = player:GetAttribute("PrisonUnrest") or 0
				for _, entry in ipairs(IntakeService.getHoused(player)) do
					local prisoner = entry.model
					if rec.escapes[prisoner] == nil and now >= (prisoner:GetAttribute("EscapeCooldown") or 0) then
						local chance = Config.EscapeUnrestFactor * (unrest / 100)
						if (prisoner:GetAttribute("MoodValue") or 100) < 20 then
							chance += Config.EscapeDesperationChance
						end
						if chance > 0 and math.random() < chance then
							tryEscape(player, rec, entry)
						end
					end
				end
			end
		end
	end)
end

return SecurityService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">StaffService</string>
          <string name="Source"><![CDATA[-- StaffService: hire and fire staff (Workmen, Guards, Cooks, Janitors),
-- pay their wages, and let them quit when the money runs dry (Prison
-- Architect's rule). Staff are NPCs; what they DO lives in other systems
-- that ask us for their people:
--   * Workmen -> ConstructionService pulls the crew that builds blueprints.
--   * Guards  -> NeedsService reads the guard ratio for prisoner Safety;
--                SecurityService patrols them and sends them chasing.
--   * Cooks   -> NeedsService needs one for the Kitchen->Canteen food chain.
--   * Janitors-> keep hygiene from rotting (a small passive bonus).
--
-- Hiring is free and CLICK-PLACED, PA style: the client sends the grid
-- square the warden clicked and the new hire appears right there. Wages
-- charge every Config.WageInterval seconds; an unpayable bill makes the
-- cheapest staff quit (workmen last — they build everything).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local GridMath = require(ReplicatedStorage.Shared.GridMath)
local EconomyService = require(script.Parent.EconomyService)
local InmateService = require(script.Parent.InmateService)
local PathService = require(script.Parent.PathService)

local StaffService = {}

-- player -> { zone, folder, staff = { [typeId] = { model, model, ... } }, spawnCounter }
local records = {}

local function typeDef(typeId)
	for _, def in ipairs(Config.StaffTypes) do
		if def.id == typeId then
			return def
		end
	end
	return nil
end

local function staffPost(zone, index)
	-- The fallback spot (saves, auto-hires): along the plot's front-right.
	local size = zone.part.Size
	local col = index % 5
	local row = math.floor(index / 5)
	return zone.part.CFrame * CFrame.new(size.X / 2 - 6 - col * 4, size.Y / 2, size.Z / 2 - 4 - row * 4)
end

local function publish(player)
	local rec = records[player]
	if not rec then
		return
	end
	local totalWage = 0
	for _, def in ipairs(Config.StaffTypes) do
		local n = #(rec.staff[def.id] or {})
		player:SetAttribute("Staff_" .. def.id, n)
		totalWage += n * def.wage
	end
	player:SetAttribute("StaffWage", totalWage)
end

function StaffService.count(player, typeId)
	local rec = records[player]
	return rec and #(rec.staff[typeId] or {}) or 0
end

function StaffService.hasCook(player)
	return StaffService.count(player, "Cook") > 0
end

-- The live models of one staff type (pruned of destroyed ones) — this is
-- how ConstructionService gets its crew and SecurityService its guards.
function StaffService.getStaff(player, typeId)
	local rec = records[player]
	local out = {}
	if rec then
		local list = rec.staff[typeId]
		if list then
			for i = #list, 1, -1 do
				if list[i].Parent == nil then
					table.remove(list, i)
				end
			end
			for _, model in ipairs(list) do
				table.insert(out, model)
			end
		end
	end
	return out
end

local function spawnStaff(player, def, cf)
	local rec = records[player]
	rec.spawnCounter += 1
	if not cf then
		local total = 0
		for _, def2 in ipairs(Config.StaffTypes) do
			total += #(rec.staff[def2.id] or {})
		end
		cf = staffPost(rec.zone, total)
	end
	local model = InmateService.spawn(cf, rec.spawnCounter, rec.folder, { outfit = def.outfit })
	rec.staff[def.id] = rec.staff[def.id] or {}
	table.insert(rec.staff[def.id], model)
end

local function fireStaff(player, typeId)
	local rec = records[player]
	local list = rec and rec.staff[typeId]
	if list and #list > 0 then
		local model = table.remove(list)
		if model then
			model:Destroy()
		end
		return true
	end
	return false
end

-- Wiring ------------------------------------------------------------------

function StaffService.assignPlayer(player, zone, savedStaff)
	local folder = Instance.new("Folder")
	folder.Name = "Staff"
	folder.Parent = zone.part

	records[player] = { zone = zone, folder = folder, staff = {}, spawnCounter = 0 }

	local sawWorkmen = false
	if type(savedStaff) == "table" then
		for _, def in ipairs(Config.StaffTypes) do
			local n = math.clamp(math.floor(tonumber(savedStaff[def.id]) or 0), 0, Config.MaxStaffPerType)
			for _ = 1, n do
				spawnStaff(player, def)
			end
		end
		-- Pre-Workman saves have no Workman key at all — grant the
		-- starting crew below so old prisons can still build.
		sawWorkmen = savedStaff.Workman ~= nil
	end
	if not sawWorkmen then
		-- Every prison opens with a small crew on payroll: they're what
		-- turns blueprints into buildings. Hire more under Staff.
		local workman = typeDef("Workman")
		for _ = 1, Config.StartingWorkmen do
			spawnStaff(player, workman)
		end
	end
	publish(player)
end

function StaffService.releasePlayer(player)
	local rec = records[player]
	records[player] = nil
	if rec then
		rec.folder:Destroy()
	end
end

function StaffService.snapshotStaff(player)
	local rec = records[player]
	local out = {}
	if rec then
		for _, def in ipairs(Config.StaffTypes) do
			out[def.id] = #(rec.staff[def.id] or {})
		end
	end
	return out
end

-- Player requests ---------------------------------------------------------

function StaffService.handleRequest(player, action, typeId, gx, gz)
	local rec = records[player]
	if not rec then
		return { ok = false, err = "You don't have a plot yet." }
	end
	local def = typeDef(typeId)
	if not def then
		return { ok = false, err = "Unknown staff type." }
	end

	if action == "hire" then
		if #(rec.staff[def.id] or {}) >= Config.MaxStaffPerType then
			return { ok = false, err = "You already have the max " .. def.id .. "s." }
		end
		-- Click-placement: the client sends the grid square the warden
		-- clicked; the hire appears there (PA's drop-the-staff feel).
		local cf = nil
		if gx ~= nil or gz ~= nil then
			if type(gx) ~= "number" or type(gz) ~= "number" then
				return { ok = false, err = "Bad request." }
			end
			gx, gz = math.floor(gx), math.floor(gz)
			local zone = rec.zone
			if gx < 0 or gx >= zone.info.cols or gz < 0 or gz >= zone.info.rows then
				return { ok = false, err = "Outside your plot." }
			end
			if zone.unlocked and not zone.unlocked[gx .. ":" .. gz] then
				return { ok = false, err = "You don't own that land yet." }
			end
			if not PathService.isWalkable(zone, gx, gz) then
				return { ok = false, err = "Something's in the way there." }
			end
			cf = GridMath.regionCenter(zone.info, gx, gz, 1, 1)
		end
		spawnStaff(player, def, cf)
		publish(player)
		return { ok = true }
	elseif action == "fire" then
		if not fireStaff(player, def.id) then
			return { ok = false, err = "No " .. def.id .. " to fire." }
		end
		publish(player)
		return { ok = true }
	end
	return { ok = false, err = "Bad request." }
end

function StaffService.init()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes.StaffRequest.OnServerInvoke = StaffService.handleRequest

	-- The payroll: charge wages, and if the till can't cover it, someone
	-- quits until the bill fits (cheapest type first — see StaffTypes).
	task.spawn(function()
		while true do
			task.wait(Config.WageInterval)
			for player, rec in pairs(records) do
				if player:IsDescendantOf(Players) then
					local function bill()
						local total = 0
						for _, def in ipairs(Config.StaffTypes) do
							total += #(rec.staff[def.id] or {}) * def.wage
						end
						return total
					end
					local total = bill()
					if total > 0 then
						if EconomyService.tryCharge(player, total) then
							player:SetAttribute("StaffUnpaid", false)
						else
							local quit = false
							for i = #Config.StaffTypes, 1, -1 do
								if fireStaff(player, Config.StaffTypes[i].id) then
									quit = true
									break
								end
							end
							player:SetAttribute("StaffUnpaid", true)
							publish(player)
							local reduced = bill()
							if quit and reduced > 0 then
								EconomyService.tryCharge(player, reduced)
							end
						end
					end
				end
			end
		end
	end)
end

return StaffService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">TimeService</string>
          <string name="Source"><![CDATA[-- TimeService: the game clock. One shared time-of-day for the whole
-- server (clients compute it from a single epoch attribute — zero
-- network traffic), plus a per-player DAY counter: how many in-game
-- days their prison has existed, accumulated across sessions.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SaveService = require(script.Parent.SaveService)

local TimeService = {}

local TICK = 15 -- seconds between day-counter updates

function TimeService.init()
	-- Clients derive the clock: (now - epoch) % DayLength -> time of day.
	workspace:SetAttribute("ClockEpoch", workspace:GetServerTimeNow())

	task.spawn(function()
		while true do
			task.wait(TICK)
			for _, player in ipairs(Players:GetPlayers()) do
				local st = SaveService.waitForData(player)
				if st then
					st.playedSeconds += TICK
					player:SetAttribute("PrisonDay", math.floor(st.playedSeconds / Config.DayLength) + 1)
				end
			end
		end
	end)
end

return TimeService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="25">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Lockdown client bootstrap. Runs on each player's own device and starts
-- what they personally see: build mode (the PA toolbar + top-down
-- camera), the PA HUD readouts, the intake popup (opened from the
-- Prisoners readout), the Staff tab (which arms BuildMode's click-to-
-- place hiring — that's the `build` wiring below), the Emergencies tab,
-- and NPC animation.

local StarterGui = game:GetService("StarterGui")

-- PA has no floating player list — and Roblox's sat right on top of the
-- clock panel. (SetCoreGuiEnabled can fail while CoreGui boots; retry.)
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
		end)
		if ok then
			return
		end
		task.wait(1)
	end
end)

local build = require(script.BuildMode).start()
local IntakePanel = require(script.IntakePanel)
IntakePanel.start()
require(script.StaffPanel).start(build)
require(script.EmergencyPanel).start()
require(script.CashHud).start({ onPrisoners = IntakePanel.toggle })
require(script.InmateAnimator).start()
require(script.MoodDisplay).start()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">BuildCamera</string>
            <string name="Source"><![CDATA[-- BuildCamera: the Prison Architect view. While build mode is open the
-- camera detaches from your character and hovers above your plot,
-- looking down at a tilt (the 2.5D feel), and you fly it:
--
--   PC:     WASD / arrows pan · scroll wheel zooms · Q / E rotate 45°
--   Phone:  two-finger drag pans · pinch zooms
--
-- Your character is gently frozen in place meanwhile (so WASD pans the
-- camera instead of walking you off a roof), and everything is restored
-- the moment build mode closes.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local BuildCamera = {}

local PITCH = math.rad(-68) -- the 2.5D tilt: steep, but not straight down
-- The Prison Architect look is mostly LENS: a narrow field of view makes
-- the world near-orthographic (walls stay upright instead of splaying
-- outward). Distances are larger to compensate.
local FOV = 28
local MIN_DIST, MAX_DIST = 60, 420

local active = false
local focus = Vector3.new()
local yaw = 0
local targetYaw = 0
local dist = 90
local targetDist = 90
local panDragging = false -- middle-mouse held
local blendStart = 0 -- os.clock() when build mode was entered
local blendFrom = nil -- camera CFrame we eased away from
local zonePart = nil
local savedFov = 70
local connections = {}
local touches = {} -- active touch inputs (for two-finger pan/pinch)
local characterConn = nil

local function setCharacterFrozen(frozen)
	local player = Players.LocalPlayer
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = frozen
	end
end

local function clampFocus(pos)
	if not zonePart then
		return pos
	end
	-- Keep the camera's attention near the plot (a bit of overshoot is
	-- allowed so the gate area is visible).
	local localPos = zonePart.CFrame:PointToObjectSpace(pos)
	local halfX = zonePart.Size.X / 2 + 25
	local halfZ = zonePart.Size.Z / 2 + 25
	return zonePart.CFrame:PointToWorldSpace(Vector3.new(
		math.clamp(localPos.X, -halfX, halfX),
		localPos.Y,
		math.clamp(localPos.Z, -halfZ, halfZ)
	))
end

local function disconnectAll()
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	connections = {}
end

function BuildCamera.enter(part)
	if active then
		return
	end
	active = true
	zonePart = part
	touches = {}

	local camera = workspace.CurrentCamera
	-- Ease in from wherever the character camera was, instead of snapping.
	blendFrom = camera.CFrame
	blendStart = os.clock()
	camera.CameraType = Enum.CameraType.Scriptable
	savedFov = camera.FieldOfView
	camera.FieldOfView = FOV

	local zoneCF = part.CFrame
	focus = zoneCF.Position + Vector3.new(0, part.Size.Y / 2, 0)
	local _, ry, _ = zoneCF:ToEulerAnglesYXZ()
	yaw, targetYaw = ry, ry
	dist = math.clamp(math.max(part.Size.X, part.Size.Z) * 1.6, MIN_DIST, MAX_DIST)
	targetDist = dist
	panDragging = false

	setCharacterFrozen(true)
	-- Respawns mid-build-mode need re-freezing.
	characterConn = Players.LocalPlayer.CharacterAdded:Connect(function(character)
		if active then
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if root and active then
				root.Anchored = true
			end
		end
	end)

	table.insert(connections, RunService.RenderStepped:Connect(function(dt)
		-- Zoom glides instead of stepping.
		dist += (targetDist - dist) * math.min(dt * 8, 1)

		-- Keyboard panning, aligned to the camera's current rotation.
		local pan = Vector3.new()
		if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
			pan += Vector3.new(0, 0, -1)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
			pan += Vector3.new(0, 0, 1)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
			pan += Vector3.new(-1, 0, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
			pan += Vector3.new(1, 0, 0)
		end
		-- Edge scrolling (PC): nudge the mouse against a screen edge to
		-- pan, like every city builder since forever. The corners where
		-- UI lives (toolbar bottom-left, readouts bottom-right) don't pan.
		if UserInputService.MouseEnabled and not panDragging then
			local mouse = UserInputService:GetMouseLocation()
			local viewport = camera.ViewportSize
			local margin = 14
			if mouse.X <= margin then
				pan += Vector3.new(-1, 0, 0)
			elseif mouse.X >= viewport.X - margin and mouse.Y < viewport.Y - 140 then
				pan += Vector3.new(1, 0, 0)
			end
			if mouse.Y <= margin then
				pan += Vector3.new(0, 0, -1)
			elseif mouse.Y >= viewport.Y - margin
				and mouse.X > 820 and mouse.X < viewport.X - 220
			then
				pan += Vector3.new(0, 0, 1)
			end
		end

		if pan.Magnitude > 0 then
			local speed = dist * 0.9 * dt
			focus = clampFocus(focus + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(pan.Unit * speed))
		end

		yaw += (targetYaw - yaw) * math.min(dt * 10, 1)

		local offset = CFrame.Angles(0, yaw, 0) * CFrame.Angles(PITCH, 0, 0)
		local camPos = focus - offset.LookVector * dist
		local target = CFrame.lookAt(camPos, focus)
		-- Smooth ~0.45s ease from the old camera into the build view.
		local blend = math.clamp((os.clock() - blendStart) / 0.45, 0, 1)
		if blend < 1 and blendFrom then
			local eased = 1 - (1 - blend) * (1 - blend) -- ease-out quad
			camera.CFrame = blendFrom:Lerp(target, eased)
		else
			camera.CFrame = target
		end
	end))

	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			targetDist = math.clamp(targetDist - input.Position.Z * 34, MIN_DIST, MAX_DIST)
		elseif input.UserInputType == Enum.UserInputType.MouseMovement and panDragging then
			-- Middle-mouse drag pans, RTS style.
			local scale = dist / 550
			focus = clampFocus(focus + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(
				Vector3.new(-input.Delta.X * scale, 0, -input.Delta.Y * scale)
			))
		elseif input.UserInputType == Enum.UserInputType.Touch and touches[input] then
			local before = {}
			local count = 0
			for touch, pos in pairs(touches) do
				count += 1
				before[touch] = pos
			end
			if count == 2 then
				-- Two fingers: pan by how the midpoint moved, zoom by how
				-- the finger gap changed.
				local other = nil
				for touch in pairs(touches) do
					if touch ~= input then
						other = touch
					end
				end
				local oldA = before[input]
				local newA = Vector2.new(input.Position.X, input.Position.Y)
				local posB = before[other]
				local oldMid = (oldA + posB) / 2
				local newMid = (newA + posB) / 2
				local delta = newMid - oldMid
				local scale = dist / 400
				focus = clampFocus(focus + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(
					Vector3.new(-delta.X * scale, 0, -delta.Y * scale)
				))
				local oldGap = (oldA - posB).Magnitude
				local newGap = (newA - posB).Magnitude
				if newGap > 1 and oldGap > 1 then
					targetDist = math.clamp(targetDist * (oldGap / newGap), MIN_DIST, MAX_DIST)
				end
			end
			touches[input] = Vector2.new(input.Position.X, input.Position.Y)
		end
	end))

	table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.Touch then
			touches[input] = Vector2.new(input.Position.X, input.Position.Y)
		end
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton3 then
			panDragging = true
		elseif input.KeyCode == Enum.KeyCode.Q then
			targetYaw += math.rad(45)
		elseif input.KeyCode == Enum.KeyCode.E then
			targetYaw -= math.rad(45)
		end
	end))

	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			touches[input] = nil
		elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
			panDragging = false
		end
	end))
end

-- How many fingers are currently down — BuildMode uses this so a
-- two-finger camera gesture never places an object.
function BuildCamera.touchCount()
	local count = 0
	for _ in pairs(touches) do
		count += 1
	end
	return count
end

function BuildCamera.exit()
	if not active then
		return
	end
	active = false
	zonePart = nil
	disconnectAll()
	if characterConn then
		characterConn:Disconnect()
		characterConn = nil
	end
	touches = {}

	setCharacterFrozen(false)
	local camera = workspace.CurrentCamera
	camera.FieldOfView = savedFov
	camera.CameraType = Enum.CameraType.Custom
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

return BuildCamera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">BuildMode</string>
            <string name="Source"><![CDATA[-- BuildMode: the whole building experience on the player's screen,
-- arranged 1:1 like Prison Architect:
--
--   * bottom-left: the PA toolbar (see PAToolbar) — square blueprint
--     tabs: Build/Walk, Foundations, Walls & Doors, Flooring, Rooms,
--     Objects, Staff, then PA's future tabs rendered dark (they light up
--     as phases ship), then Move and Bulldoze.
--   * clicking a tab opens a PA-style menu above the strip: rows of
--     items with icons and prices. Picking one arms the tool. Assets
--     pick their tab with a "Category" attribute — a name the toolbar
--     has never seen becomes a new tab automatically.
--
--   Build tab (or B)  ->  build view: top-down camera + the tool tabs
--   Foundations       ->  drag a rectangle: walls around it, floor inside
--   Walls / Flooring  ->  drag whole lines / fill rectangles
--   Rooms             ->  pick the type FIRST, then drag a rectangle
--   Objects           ->  ghost preview snaps to the grid; click places
--   Move              ->  pick an object up and re-place it
--   Ctrl+Z            ->  undo placements and demolishes
--   R                 ->  rotate 90°   ·   Bulldoze -> click / drag-clear
--
-- The server re-validates everything — this file is just the friendly face.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage.Shared:WaitForChild("Format"))
local GridMath = require(ReplicatedStorage.Shared:WaitForChild("GridMath"))
local AssetCatalog = require(ReplicatedStorage.Shared:WaitForChild("AssetCatalog"))
local BuildCamera = require(script.Parent.BuildCamera)
local UIKit = require(script.Parent.UIKit)
local PAIcons = require(script.Parent.PAIcons)
local PAToolbar = require(script.Parent.PAToolbar)

local BuildMode = {}

local GRID = Config.GridSize
local GREEN = Color3.fromRGB(80, 255, 120)
local RED = Color3.fromRGB(255, 80, 80)
local ORANGE = Color3.fromRGB(255, 170, 60) -- valid spot, can't afford it

function BuildMode.start()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local placeRequest = remotes:WaitForChild("PlaceRequest")
	local placeLineRequest = remotes:WaitForChild("PlaceLineRequest")
	local deleteRequest = remotes:WaitForChild("DeleteRequest")
	local deleteManyRequest = remotes:WaitForChild("DeleteManyRequest")
	local foundationRequest = remotes:WaitForChild("FoundationRequest")
	local placeRectRequest = remotes:WaitForChild("PlaceRectRequest")
	local deleteRectRequest = remotes:WaitForChild("DeleteRectRequest")
	local moveRequest = remotes:WaitForChild("MoveRequest")
	local roomPaintRequest = remotes:WaitForChild("RoomPaintRequest")
	local staffRequest = remotes:WaitForChild("StaffRequest")

	-- Mirror of the wallet, for the can-you-afford-it ghost tint.
	local cashNow = 0
	task.spawn(function()
		local leaderstats = player:WaitForChild("leaderstats", 60)
		local cashValue = leaderstats and leaderstats:WaitForChild("Cash", 60)
		if cashValue then
			cashNow = cashValue.Value
			cashValue.Changed:Connect(function(value)
				cashNow = value
			end)
		end
	end)

	local buildablesFolder = ReplicatedStorage:WaitForChild(Config.BuildablesFolderName)
	local catalogByName, catalogOrdered = AssetCatalog.load(buildablesFolder)

	-- Which categories exist? The standard PA tab row ALWAYS shows (an
	-- empty one just says so in its menu); any new names the map-maker
	-- invented on their own assets are appended after it.
	local categories = {}
	for _, name in ipairs(Config.AssetCategories) do
		table.insert(categories, name)
	end
	local extras = {}
	for _, asset in ipairs(catalogOrdered) do
		if not table.find(categories, asset.category) and not table.find(extras, asset.category) then
			table.insert(extras, asset.category)
		end
	end
	table.sort(extras)
	for _, name in ipairs(extras) do
		table.insert(categories, name)
	end

	-- My zone (the server drops a "BuildZone" pointer into the Player).
	local zone = nil
	local occupied = {}
	local lockedRects = {} -- land not bought yet, mirrored from the overlays

	-- State.
	local mode = "off" -- "off" | "objects" | "rooms" | "foundation" | "move" | "delete"
	local currentCategory = categories[1] or "Objects"
	local selected = nil
	local selectedRoom = nil
	local rot = 0
	local ghost, ghostHighlight = nil, nil
	local ghostCell, ghostValid = nil, false
	local lastPointer = Vector2.new(0, 0)
	local pressing = false
	local pressStartCell = nil
	local stretchBox = nil
	local hoverHighlight = nil
	local zoneBox = nil
	local movingModel = nil -- the object currently carried by the Move tool
	local movingFrom = nil -- its original {n, x, z, r}, for undo
	local pendingStaff = nil -- staff def being click-placed (mode "staff")
	local staffGhost = nil

	-- Undo: a stack of inverse actions (Ctrl+Z or the ↩ button).
	--   { kind = "place", models = {Model, ...} }        -> demolish them
	--   { kind = "delete", items = { {n, x, z, r}, ... } } -> re-place them
	--   { kind = "move", model, from = {x, z, r} }        -> move it back
	local undoStack = {}
	local function pushUndo(entry)
		table.insert(undoStack, entry)
		if #undoStack > 20 then
			table.remove(undoStack, 1)
		end
	end

	-- Every category drags except single-placement ones: walls & doors
	-- (and custom categories) drag straight LINES, flooring FILLS the
	-- rectangle, objects place one at a time.
	local function dragStyleOf(asset)
		if asset.category == "Flooring" then
			return "rect"
		elseif asset.category == "Objects" then
			return "single"
		end
		return "line"
	end

	local SoundService = game:GetService("SoundService")
	local function playSound(fileName, volume)
		-- Engine-bundled sounds: nothing to download, can't go missing.
		local sound = Instance.new("Sound")
		sound.SoundId = "rbxasset://sounds/" .. fileName
		sound.Volume = volume
		SoundService:PlayLocalSound(sound)
		sound:Destroy()
	end

	-- Occupancy mirror ---------------------------------------------------

	local function markModel(model, value)
		local asset = catalogByName[model:GetAttribute("Asset") or ""]
		local gx = model:GetAttribute("GX")
		local gz = model:GetAttribute("GZ")
		local r = model:GetAttribute("Rot")
		if not asset or type(gx) ~= "number" or type(gz) ~= "number" or type(r) ~= "number" then
			return
		end
		local w, d = GridMath.footprint(asset, r)
		for x = gx, gx + w - 1 do
			for z = gz, gz + d - 1 do
				occupied[x .. ":" .. z] = value
			end
		end
	end

	local function cellLocked(x, z)
		for _, r in ipairs(lockedRects) do
			if x >= r[1] and x <= r[3] and z >= r[2] and z <= r[4] then
				return true
			end
		end
		return false
	end

	local function regionFree(gx, gz, w, d)
		for x = gx, gx + w - 1 do
			for z = gz, gz + d - 1 do
				if occupied[x .. ":" .. z] or cellLocked(x, z) then
					return false
				end
			end
		end
		return true
	end

	local function watchZone(zonePart)
		zone = {
			part = zonePart,
			info = GridMath.zoneInfo(zonePart),
			placed = zonePart:WaitForChild("Placed"),
		}
		occupied = {}
		for _, model in ipairs(zone.placed:GetChildren()) do
			markModel(model, true)
		end
		zone.placed.ChildAdded:Connect(function(model)
			markModel(model, true)
		end)
		zone.placed.ChildRemoved:Connect(function(model)
			markModel(model, nil)
		end)

		-- Mirror the locked-land overlays into grid rects (they vanish as
		-- parcels get bought).
		local function rebuildLockedRects()
			lockedRects = {}
			local folder = zone.part:FindFirstChild("LockedLand")
			if folder then
				for _, overlay in ipairs(folder:GetChildren()) do
					if overlay:IsA("BasePart") then
						local x1, z1, x2, z2 = GridMath.partRect(zone.info, overlay)
						table.insert(lockedRects, { x1, z1, x2, z2 })
					end
				end
			end
		end
		rebuildLockedRects()
		local lockedFolder = zone.part:FindFirstChild("LockedLand")
		if lockedFolder then
			lockedFolder.ChildRemoved:Connect(function()
				task.defer(rebuildLockedRects)
			end)
		end
		zone.part.ChildAdded:Connect(function(child)
			if child.Name == "LockedLand" then
				task.defer(rebuildLockedRects)
				child.ChildRemoved:Connect(function()
					task.defer(rebuildLockedRects)
				end)
			end
		end)
	end

	task.spawn(function()
		local zoneMarker = player:WaitForChild("BuildZone", 60)
		if zoneMarker then
			if zoneMarker.Value then
				watchZone(zoneMarker.Value)
			else
				zoneMarker.Changed:Connect(function(value)
					if value and not zone then
						watchZone(value)
					end
				end)
			end
		end
	end)

	-- Pointer & preview helpers -------------------------------------------

	local function pointerRay()
		local camera = workspace.CurrentCamera
		if not camera then
			return nil
		end
		-- InputObject positions are GUI-inset-adjusted, so the matching
		-- ray function is ScreenPointToRay (ViewportPointToRay aims ~58px
		-- high — the classic Roblox top-bar offset bug).
		return camera:ScreenPointToRay(lastPointer.X, lastPointer.Y)
	end

	local function cellUnderPointer(w, d)
		if not zone then
			return nil
		end
		local ray = pointerRay()
		if not ray then
			return nil
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { zone.part }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
		if not hit then
			return nil
		end
		return GridMath.worldToCell(zone.info, hit.Position, w, d)
	end

	local function destroyGhost()
		if ghost then
			ghost:Destroy()
			ghost, ghostHighlight = nil, nil
		end
		ghostCell = nil
	end

	-- The staff-placement marker: a glowing pillar in the hire's color
	-- that rides the cursor until you click them down.
	local function destroyStaffGhost()
		if staffGhost then
			staffGhost:Destroy()
			staffGhost = nil
		end
	end

	local function makeStaffGhost(def)
		destroyStaffGhost()
		local marker = Instance.new("Part")
		marker.Name = "StaffGhost"
		marker.Anchored = true
		marker.CanCollide = false
		marker.CanQuery = false
		marker.CanTouch = false
		marker.CastShadow = false
		marker.Material = Enum.Material.Neon
		marker.Transparency = 0.45
		marker.Color = def.tint or Color3.fromRGB(210, 225, 240)
		marker.Size = Vector3.new(2, 5, 2)
		staffGhost = marker
	end

	local function makeGhost(asset)
		destroyGhost()
		local model = asset.model:Clone()
		for _, descendant in ipairs(model:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.CanCollide = false
				descendant.CanQuery = false
				descendant.CanTouch = false
				descendant.CastShadow = false
				descendant.Transparency = math.clamp(descendant.Transparency + 0.5, 0.5, 1)
			elseif descendant:IsA("BillboardGui") then
				descendant.Enabled = false
			end
		end
		local highlight = Instance.new("Highlight")
		highlight.FillColor = GREEN
		highlight.FillTransparency = 0.7
		highlight.OutlineColor = GREEN
		highlight.Adornee = model
		highlight.Parent = model
		ghost = model
		ghostHighlight = highlight
	end

	-- The grid cursor: a bright square on whichever cell the pointer is
	-- over, in every build tool — so you always know what you're aiming at.
	local cursorBox = nil
	local function updateCursor()
		if mode == "off" or not zone then
			if cursorBox then
				cursorBox.Parent = nil
			end
			return
		end
		local gx, gz = cellUnderPointer(1, 1)
		if not gx then
			if cursorBox then
				cursorBox.Parent = nil
			end
			return
		end
		if not cursorBox then
			cursorBox = Instance.new("Part")
			cursorBox.Name = "GridCursor"
			cursorBox.Anchored = true
			cursorBox.CanCollide = false
			cursorBox.CanQuery = false
			cursorBox.CanTouch = false
			cursorBox.CastShadow = false
			cursorBox.Transparency = 1
			cursorBox.Size = Vector3.new(GRID, 0.3, GRID)
			local box = Instance.new("SelectionBox")
			box.Adornee = cursorBox
			box.Color3 = Color3.fromRGB(255, 255, 160)
			box.LineThickness = 0.05
			box.SurfaceColor3 = Color3.fromRGB(255, 255, 160)
			box.SurfaceTransparency = 0.85
			box.Parent = cursorBox
		end
		cursorBox.CFrame = GridMath.regionCenter(zone.info, gx, gz, 1, 1) * CFrame.new(0, 0.2, 0)
		cursorBox.Parent = workspace
	end

	local function hideStretchBox()
		if stretchBox then
			stretchBox:Destroy()
			stretchBox = nil
		end
	end

	local function showStretchBox(x1, z1, x2, z2, color)
		if not stretchBox then
			stretchBox = Instance.new("Part")
			stretchBox.Anchored = true
			stretchBox.CanCollide = false
			stretchBox.CanQuery = false
			stretchBox.CanTouch = false
			stretchBox.Material = Enum.Material.Neon
			stretchBox.Transparency = 0.55
			stretchBox.Parent = workspace
		end
		local minX, maxX = math.min(x1, x2), math.max(x1, x2)
		local minZ, maxZ = math.min(z1, z2), math.max(z1, z2)
		local w, d = maxX - minX + 1, maxZ - minZ + 1
		stretchBox.Color = color
		stretchBox.Size = Vector3.new(w * GRID, 0.4, d * GRID)
		stretchBox.CFrame = GridMath.regionCenter(zone.info, minX, minZ, w, d) * CFrame.new(0, 0.25, 0)
	end

	local function updateGhost()
		if not (zone and selected and ghost) then
			return
		end
		local w, d = GridMath.footprint(selected, rot)
		local gx, gz = cellUnderPointer(w, d)
		if gx == nil then
			ghost.Parent = nil
			ghostCell = nil
			return
		end
		ghost:PivotTo(GridMath.placementPivot(zone.info, selected, gx, gz, rot))
		ghost.Parent = workspace
		ghostCell = { gx, gz }
		local spotFree = regionFree(gx, gz, w, d)
		local affordable = Config.FreeBuild or movingModel ~= nil or selected.price <= cashNow
		ghostValid = spotFree and affordable
		local color = not spotFree and RED or (not affordable and ORANGE) or GREEN
		ghostHighlight.FillColor = color
		ghostHighlight.OutlineColor = color
	end

	-- Inmate name tags clutter the top-down view — hide them (locally)
	-- while build mode is open, including on inmates that arrive mid-build.
	local CollectionService = game:GetService("CollectionService")
	local tagsHidden = false
	local tagConn = nil
	local function setInmateTag(model, enabled)
		local head = model:FindFirstChild("Head")
		local nameTag = head and head:FindFirstChild("NameTag")
		if nameTag then
			nameTag.Enabled = enabled
		end
	end
	local function setNameTagsHidden(hidden)
		if hidden == tagsHidden then
			return
		end
		tagsHidden = hidden
		for _, model in ipairs(CollectionService:GetTagged("Inmate")) do
			task.spawn(setInmateTag, model, not hidden)
		end
		if hidden then
			tagConn = CollectionService:GetInstanceAddedSignal("Inmate"):Connect(function(model)
				task.delay(0.5, setInmateTag, model, false)
			end)
		elseif tagConn then
			tagConn:Disconnect()
			tagConn = nil
		end
	end

	-- Grid overlay: faint lines over the plot while building, so the
	-- snapping reads at a glance. Client-side only — nobody else sees it.
	local gridFolder = nil
	local function showGrid()
		if gridFolder or not zone then
			return
		end
		gridFolder = Instance.new("Folder")
		gridFolder.Name = "BuildGrid"
		local info = zone.info
		local function gridLine(size, cf)
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Color = Color3.fromRGB(210, 255, 225)
			p.Transparency = 0.85
			p.Size = size
			p.CFrame = cf
			p.Parent = gridFolder
		end
		for i = 0, info.cols do
			gridLine(
				Vector3.new(0.1, 0.04, info.rows * GRID),
				info.corner * CFrame.new(i * GRID, 0.1, info.rows * GRID / 2)
			)
		end
		for j = 0, info.rows do
			gridLine(
				Vector3.new(info.cols * GRID, 0.04, 0.1),
				info.corner * CFrame.new(info.cols * GRID / 2, 0.1, j * GRID)
			)
		end
		gridFolder.Parent = workspace
	end
	local function hideGrid()
		if gridFolder then
			gridFolder:Destroy()
			gridFolder = nil
		end
	end

	-- UI: PAToolbar owns the strip and menus; this gui holds the floating
	-- extras — the status line, the rotate button, the hover highlight.

	local gui = Instance.new("ScreenGui")
	gui.Name = "LockdownBuild"
	gui.ResetOnSpawn = false

	-- A row's little 3D thumbnail (the menu "icon" — our stand-in art).
	local function assetIcon(slot, asset)
		local viewport = Instance.new("ViewportFrame")
		viewport.Size = UDim2.new(1, 0, 1, 0)
		viewport.BackgroundTransparency = 1
		local camera = Instance.new("Camera")
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		local preview = asset.model:Clone()
		preview.Parent = viewport
		local boxCF, boxSize = preview:GetBoundingBox()
		local distance = boxSize.Magnitude * 1.1 + 2
		camera.CFrame = CFrame.lookAt(
			boxCF.Position + Vector3.new(distance * 0.6, distance * 0.55, distance * 0.6),
			boxCF.Position
		)
		viewport.Parent = slot
	end

	-- The hint line, sitting just above the bottom of the screen.
	local status = Instance.new("TextLabel")
	status.AnchorPoint = Vector2.new(0.5, 1)
	status.Position = UDim2.new(0.5, 0, 1, -70)
	status.Size = UDim2.new(0, 560, 0, 20)
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.GothamBold
	status.TextScaled = true
	status.TextColor3 = Color3.fromRGB(255, 255, 255)
	status.TextStrokeTransparency = 0.4
	status.Text = ""
	status.Parent = gui

	-- Rotate: R does it on PC; this button does it on phones. It floats
	-- just clear of the toolbar menus (they're 272 wide).
	local rotateButton = Instance.new("TextButton")
	rotateButton.AnchorPoint = Vector2.new(0, 1)
	rotateButton.Position = UDim2.new(0, 300, 1, -70)
	rotateButton.Size = UDim2.new(0, 40, 0, 40)
	rotateButton.BackgroundColor3 = UIKit.BTN
	rotateButton.BorderSizePixel = 0
	rotateButton.AutoButtonColor = false
	rotateButton.Font = Enum.Font.GothamBold
	rotateButton.TextSize = 22
	rotateButton.TextColor3 = UIKit.ICON
	rotateButton.Text = "↻"
	rotateButton.Visible = false
	UIKit.stroke(rotateButton, UIKit.EDGE, 1, 0.35)
	rotateButton.Parent = gui

	-- The status line has a PERSISTENT hint (what the current tool does)
	-- and temporary flashes (results/errors) that revert to it.
	local statusId = 0
	local statusDefault = ""
	local function setStatusDefault(text)
		statusId += 1
		statusDefault = text
		status.Text = text
		status.TextColor3 = Color3.fromRGB(235, 235, 235)
	end
	local function flashStatus(text, color)
		statusId += 1
		local id = statusId
		status.Text = text
		status.TextColor3 = color or Color3.fromRGB(255, 255, 255)
		task.delay(2.5, function()
			if statusId == id then
				status.Text = statusDefault
				status.TextColor3 = Color3.fromRGB(235, 235, 235)
			end
		end)
	end

	-- Menus ---------------------------------------------------------------

	local assetRows = {} -- asset name -> PA menu row handle
	local roomRows = {} -- room id -> row handle
	local foundationRow = nil
	local menuHandles = {} -- tab id -> PAToolbar menu handle
	local TAB_IDS = {} -- category name -> tab id

	-- Which toolbar tab matches the current tool?
	local function tabForMode()
		if mode == "objects" then
			return TAB_IDS[currentCategory]
		elseif mode == "rooms" then
			return "rooms"
		elseif mode == "foundation" then
			return "foundations"
		elseif mode == "move" then
			return "move"
		elseif mode == "delete" then
			return "bulldoze"
		elseif mode == "staff" then
			return "staff"
		end
		return nil
	end

	local function refreshSelectionLook()
		for name, handle in pairs(assetRows) do
			handle.setSelected(selected ~= nil and selected.name == name)
		end
		for id, handle in pairs(roomRows) do
			handle.setSelected(selectedRoom == id)
		end
		if foundationRow then
			foundationRow.setSelected(mode == "foundation")
		end
		PAToolbar.setActiveTool(tabForMode())
		PAToolbar.setPressed("walk", mode ~= "off")
		rotateButton.Visible = mode == "objects" and selected ~= nil
	end

	local setMode, selectAsset, selectRoom, tryMove, doUndo

	-- One PA menu per buildable category (rows: icon · name · price).
	local function buildCategoryMenu(categoryName, tabId)
		local menu = PAToolbar.menu(tabId, categoryName)
		local shown = 0
		for order, asset in ipairs(catalogOrdered) do
			if asset.category == categoryName then
				shown += 1
				local handle = PAToolbar.row(menu.list, {
					order = order,
					name = asset.name,
					right = Format.money(asset.price),
					onClick = function()
						selectAsset(asset)
					end,
				})
				assetIcon(handle.icon, asset)
				assetRows[asset.name] = handle
			end
		end
		if shown == 0 then
			local empty = PAToolbar.row(menu.list, { order = 1, name = "(add Models to Buildables)", right = "" })
			empty.name.TextColor3 = UIKit.DIM
		end
		menu.fit()
		menuHandles[tabId] = menu
	end

	for i, name in ipairs(categories) do
		local tabId = "cat" .. i
		TAB_IDS[name] = tabId
		buildCategoryMenu(name, tabId)
	end

	-- The Rooms menu: "Remove Room" first (PA's None), then every type.
	local roomsMenu = PAToolbar.menu("rooms", "Rooms")
	menuHandles.rooms = roomsMenu
	local function roomRow(id, name, color, order)
		local handle = PAToolbar.row(roomsMenu.list, {
			order = order,
			name = name,
			right = "",
			onClick = function()
				selectRoom(id)
			end,
		})
		if color then
			local swatch = Instance.new("Frame")
			swatch.AnchorPoint = Vector2.new(0.5, 0.5)
			swatch.Position = UDim2.new(0.5, 0, 0.5, 0)
			swatch.Size = UDim2.new(0, 18, 0, 18)
			swatch.BackgroundColor3 = color
			swatch.BorderSizePixel = 0
			UIKit.stroke(swatch, UIKit.EDGE_DIM, 1, 0)
			swatch.Parent = handle.icon
		else
			PAIcons.draw(handle.icon, "bulldoze", UIKit.DIM, 4)
		end
		roomRows[id] = handle
	end
	roomRow(0, "Remove Room", nil, 1)
	for id, roomType in ipairs(Config.RoomTypes) do
		roomRow(id, roomType.name, roomType.color, id + 1)
	end
	roomsMenu.fit()

	-- The Foundations menu: one entry, like PA's foundation list.
	local foundationsMenu = PAToolbar.menu("foundations", "Foundations")
	menuHandles.foundations = foundationsMenu
	foundationRow = PAToolbar.row(foundationsMenu.list, {
		order = 1,
		name = "Foundation",
		right = "",
		onClick = function()
			setMode("foundation")
		end,
	})
	PAIcons.draw(foundationRow.icon, "foundations", UIKit.ICON, 4)
	foundationsMenu.fit()

	-- Mode switching -----------------------------------------------------

	local function clearHover()
		if hoverHighlight then
			hoverHighlight.Adornee = nil
		end
	end

	setMode = function(newMode)
		local wasOff = mode == "off"
		mode = newMode
		pressing = false
		movingModel = nil
		movingFrom = nil
		destroyGhost()
		hideStretchBox()
		clearHover()
		if mode ~= "objects" then
			selected = nil
		end
		if mode ~= "rooms" then
			selectedRoom = nil
		end
		if mode ~= "staff" then
			pendingStaff = nil
			destroyStaffGhost()
		end
		if mode == "off" or wasOff then
			-- Crossing the build/walk boundary closes every open menu
			-- (tab clicks re-open the one they want right after).
			UIKit.closeAll()
		end
		refreshSelectionLook()

		if mode ~= "off" then
			showGrid()
		else
			hideGrid()
		end
		setNameTagsHidden(mode ~= "off")

		if mode == "objects" and not selected then
			setStatusDefault("Pick a tool from the toolbar, or an item from its menu")
		elseif mode == "rooms" and selectedRoom == nil then
			setStatusDefault("Pick a room type from the menu, then drag a rectangle")
		elseif mode == "foundation" then
			setStatusDefault("Drag a rectangle — walls around the edge, floor inside. Add a door after!")
		elseif mode == "move" then
			setStatusDefault("Move: click an object to pick it up")
		elseif mode == "delete" then
			setStatusDefault("Bulldoze: click an object, or drag a rectangle to clear an area")
		elseif mode == "staff" then
			setStatusDefault("Click a square to place your new hire · right-click to stop")
		elseif mode == "off" then
			setStatusDefault("")
		end

		if zoneBox then
			zoneBox:Destroy()
			zoneBox = nil
		end
		if mode ~= "off" and zone then
			zoneBox = Instance.new("SelectionBox")
			zoneBox.Adornee = zone.part
			zoneBox.Color3 = GREEN
			zoneBox.LineThickness = 0.06
			zoneBox.SurfaceTransparency = 1
			zoneBox.Parent = zone.part
		end

		-- The Prison Architect camera comes with build mode.
		if mode ~= "off" and wasOff and zone then
			BuildCamera.enter(zone.part)
		elseif mode == "off" and not wasOff then
			BuildCamera.exit()
		end
	end

	-- Clicking a category tab arms that category and opens its menu.
	-- Clicking it again just toggles the menu (the tool stays armed).
	local function activateCategory(name)
		local tabId = TAB_IDS[name]
		if mode == "objects" and currentCategory == name then
			PAToolbar.toggleMenu(tabId)
		else
			currentCategory = name
			setMode("objects")
			PAToolbar.openMenu(tabId)
		end
	end

	selectAsset = function(asset)
		if not zone then
			flashStatus("No build plot assigned yet!", RED)
			return
		end
		selected = asset
		selectedRoom = nil
		clearHover()
		hideStretchBox()
		makeGhost(asset)
		refreshSelectionLook()
		local price = Config.FreeBuild and "" or (" · " .. Format.money(asset.price))
		local style = dragStyleOf(asset)
		if style == "line" then
			setStatusDefault("Placing " .. asset.name .. price .. " — drag for a whole line! (R rotates)")
		elseif style == "rect" then
			setStatusDefault("Placing " .. asset.name .. price .. " — drag to fill an area!")
		else
			setStatusDefault("Placing " .. asset.name .. price .. " (R or ↻ rotates)")
		end
	end

	selectRoom = function(id)
		if not zone then
			flashStatus("No build plot assigned yet!", RED)
			return
		end
		selectedRoom = id
		selected = nil
		destroyGhost()
		clearHover()
		refreshSelectionLook()
		if id == 0 then
			setStatusDefault("Eraser — drag a rectangle to clear room paint")
		else
			setStatusDefault("Drag a rectangle to paint: " .. Config.RoomTypes[id].name)
		end
	end

	-- The toolbar tabs — PA's full row, left to right: Build/Walk toggle,
	-- Foundations, Walls & Doors, Flooring, Rooms, Objects (then any
	-- custom categories), Staff (order 12, added by StaffPanel), the
	-- locked future tabs rendered dark, and finally Move + Bulldoze.
	PAToolbar.addTab({
		id = "walk",
		icon = "build",
		label = "Build view (B)",
		order = 1,
		onClick = function()
			setMode(mode == "off" and "objects" or "off")
		end,
	})
	PAToolbar.addTab({
		id = "foundations",
		icon = "foundations",
		label = "Foundations",
		order = 2,
		onClick = function()
			if mode == "foundation" then
				PAToolbar.toggleMenu("foundations")
			else
				setMode("foundation")
				PAToolbar.openMenu("foundations")
			end
		end,
	})
	local CATEGORY_TAB = {
		["Walls & Doors"] = { order = 3, icon = "walls" },
		["Flooring"] = { order = 4, icon = "flooring" },
		["Objects"] = { order = 6, icon = "objects" },
	}
	local extraOrder = 6
	for _, name in ipairs(categories) do
		local look = CATEGORY_TAB[name]
		if not look then
			extraOrder += 1
			look = { order = extraOrder, icon = "box" }
		end
		PAToolbar.addTab({
			id = TAB_IDS[name],
			icon = look.icon,
			label = name,
			order = look.order,
			onClick = function()
				activateCategory(name)
			end,
		})
	end
	PAToolbar.addTab({
		id = "rooms",
		icon = "rooms",
		label = "Rooms",
		order = 5,
		onClick = function()
			if mode == "rooms" then
				PAToolbar.toggleMenu("rooms")
			else
				setMode("rooms")
				PAToolbar.openMenu("rooms")
			end
		end,
	})
	for i, future in ipairs(Config.ComingSoon) do
		PAToolbar.addTab({
			id = "future" .. i,
			icon = future.icon,
			label = future.name,
			order = 20 + i,
			enabled = false,
			onClick = function()
				flashStatus(future.note, Color3.fromRGB(220, 220, 220))
			end,
		})
	end
	PAToolbar.addTab({
		id = "move",
		icon = "move",
		label = "Move",
		order = 40,
		onClick = function()
			setMode(mode == "move" and "objects" or "move")
		end,
	})
	PAToolbar.addTab({
		id = "bulldoze",
		icon = "bulldoze",
		label = "Bulldoze",
		order = 41,
		onClick = function()
			setMode(mode == "delete" and "objects" or "delete")
		end,
	})

	rotateButton.Activated:Connect(function()
		rot = (rot + 1) % 4
	end)

	gui.Parent = playerGui

	-- Requests -----------------------------------------------------------

	local function tryPlaceSingle(gx, gz)
		if not (zone and selected) then
			return
		end
		local ok, result = pcall(function()
			return placeRequest:InvokeServer(selected.name, gx, gz, rot)
		end)
		if ok and result and result.ok then
			if result.model then
				pushUndo({ kind = "place", models = { result.model } })
			end
			playSound("electronicpingshort.wav", 0.5)
			flashStatus(selected.name .. " placed!", GREEN)
		elseif ok and result then
			flashStatus(result.err or "Couldn't place that.", RED)
		end
	end

	local function tryPlaceLine(x1, z1, x2, z2)
		local ok, result = pcall(function()
			return placeLineRequest:InvokeServer(selected.name, x1, z1, x2, z2)
		end)
		if ok and result and result.ok then
			if result.models then
				pushUndo({ kind = "place", models = result.models })
			end
			playSound("electronicpingshort.wav", 0.5)
			if result.broke then
				flashStatus(("%d placed — then the money ran out!"):format(result.placed), ORANGE)
			else
				flashStatus(("%d × %s placed!"):format(result.placed, selected.name), GREEN)
			end
		elseif ok and result then
			flashStatus(result.err or "Couldn't build that line.", RED)
		end
	end

	local function tryPlaceRect(x1, z1, x2, z2)
		local ok, result = pcall(function()
			return placeRectRequest:InvokeServer(selected.name, x1, z1, x2, z2, rot)
		end)
		if ok and result and result.ok then
			if result.models then
				pushUndo({ kind = "place", models = result.models })
			end
			playSound("electronicpingshort.wav", 0.5)
			if result.broke then
				flashStatus(("%d placed — then the money ran out!"):format(result.placed), ORANGE)
			else
				flashStatus(("%d × %s placed!"):format(result.placed, selected.name), GREEN)
			end
		elseif ok and result then
			flashStatus(result.err or "Couldn't fill that area.", RED)
		end
	end

	local function tryFoundation(x1, z1, x2, z2)
		local ok, result = pcall(function()
			return foundationRequest:InvokeServer(x1, z1, x2, z2)
		end)
		if ok and result and result.ok then
			if result.models then
				pushUndo({ kind = "place", models = result.models })
			end
			playSound("electronicpingshort.wav", 0.5)
			if result.broke then
				flashStatus(("Foundation ran out of cash after %d pieces!"):format(result.built), ORANGE)
			else
				flashStatus(("Foundation planned — %d pieces. Now add a door!"):format(result.built), GREEN)
			end
		elseif ok and result then
			flashStatus(result.err or "Couldn't build that foundation.", RED)
		end
	end

	local function tryPaintRoom(x1, z1, x2, z2)
		local ok, result = pcall(function()
			return roomPaintRequest:InvokeServer(selectedRoom, x1, z1, x2, z2)
		end)
		if ok and result and result.ok then
			if selectedRoom == 0 then
				flashStatus("Room paint cleared", Color3.fromRGB(220, 220, 220))
			else
				flashStatus(Config.RoomTypes[selectedRoom].name .. " painted!", Config.RoomTypes[selectedRoom].color)
			end
		elseif ok and result then
			flashStatus(result.err or "Couldn't paint that.", RED)
		end
	end

	local function findPlacedModel()
		if not zone then
			return nil
		end
		local ray = pointerRay()
		if not ray then
			return nil
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { zone.placed }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
		if not hit then
			return nil
		end
		local model = hit.Instance
		while model and model.Parent ~= zone.placed do
			model = model.Parent
		end
		return model
	end

	-- Read a placed model's identity before demolishing, so undo can
	-- rebuild it exactly.
	local function modelParams(model)
		local name = model:GetAttribute("Asset")
		local gx = model:GetAttribute("GX")
		local gz = model:GetAttribute("GZ")
		local r = model:GetAttribute("Rot")
		if type(name) == "string" and type(gx) == "number" and type(gz) == "number" and type(r) == "number" then
			return { n = name, x = gx, z = gz, r = r }
		end
		return nil
	end

	local function tryDelete()
		local model = findPlacedModel()
		if not model then
			return
		end
		local params = modelParams(model)
		local ok, result = pcall(function()
			return deleteRequest:InvokeServer(model)
		end)
		if ok and result and result.ok then
			if params then
				pushUndo({ kind = "delete", items = { params } })
			end
			playSound("snap.mp3", 0.5)
			if result.refund and result.refund > 0 then
				flashStatus("Demolished! +" .. Format.money(result.refund), GREEN)
			else
				flashStatus("Demolished!", GREEN)
			end
		elseif ok and result then
			flashStatus(result.err or "Couldn't demolish that.", RED)
		end
	end

	local function tryDeleteRect(x1, z1, x2, z2)
		local ok, result = pcall(function()
			return deleteRectRequest:InvokeServer(x1, z1, x2, z2)
		end)
		if ok and result and result.ok then
			if result.items then
				pushUndo({ kind = "delete", items = result.items })
			end
			playSound("snap.mp3", 0.5)
			local refundText = (result.refund and result.refund > 0) and (" · +" .. Format.money(result.refund)) or ""
			flashStatus(("Bulldozed %d object%s%s"):format(result.deleted, result.deleted == 1 and "" or "s", refundText), GREEN)
		elseif ok and result then
			flashStatus(result.err or "Nothing there to bulldoze.", RED)
		end
	end

	-- The Move tool: pick up, carry the ghost, click to relocate. The
	-- server does one free, instant move — no demolish, no cost.
	tryMove = function()
		if movingModel and ghostCell then
			-- Second click: commit the move.
			local ok, result = pcall(function()
				return moveRequest:InvokeServer(movingModel, ghostCell[1], ghostCell[2], rot)
			end)
			if ok and result and result.ok then
				if movingFrom then
					pushUndo({ kind = "move", model = movingModel, from = movingFrom })
				end
				playSound("electronicpingshort.wav", 0.5)
				flashStatus("Moved!", GREEN)
				movingModel = nil
				movingFrom = nil
				destroyGhost()
				selected = nil
				setStatusDefault("Move: click an object to pick it up")
			elseif ok and result then
				flashStatus(result.err or "Can't move it there.", RED)
			end
			return
		end

		-- First click: pick something up.
		local model = findPlacedModel()
		if not model then
			return
		end
		local params = modelParams(model)
		local asset = params and catalogByName[params.n]
		if not asset then
			flashStatus("Can't move that one.", RED)
			return
		end
		movingModel = model
		movingFrom = { x = params.x, z = params.z, r = params.r }
		selected = asset
		rot = params.r
		clearHover()
		makeGhost(asset)
		setStatusDefault("Carrying " .. asset.name .. " — click to place, right-click to cancel")
	end

	doUndo = function()
		local entry = table.remove(undoStack)
		if not entry then
			flashStatus("Nothing to undo", Color3.fromRGB(220, 220, 220))
			return
		end
		if entry.kind == "place" then
			local alive = {}
			for _, model in ipairs(entry.models) do
				if typeof(model) == "Instance" and model.Parent ~= nil then
					table.insert(alive, model)
				end
			end
			if #alive == 0 then
				flashStatus("Nothing to undo", Color3.fromRGB(220, 220, 220))
				return
			end
			local ok, result = pcall(function()
				return deleteManyRequest:InvokeServer(alive)
			end)
			if ok and result and result.ok then
				flashStatus(("Undid %d placement%s"):format(result.deleted, result.deleted == 1 and "" or "s"), GREEN)
			end
		elseif entry.kind == "move" then
			if typeof(entry.model) == "Instance" and entry.model.Parent ~= nil then
				local ok, result = pcall(function()
					return moveRequest:InvokeServer(entry.model, entry.from.x, entry.from.z, entry.from.r)
				end)
				flashStatus((ok and result and result.ok) and "Moved back!" or "Couldn't move it back.",
					(ok and result and result.ok) and GREEN or RED)
			end
		elseif entry.kind == "delete" then
			local restored = 0
			for _, item in ipairs(entry.items) do
				local ok, result = pcall(function()
					return placeRequest:InvokeServer(item.n, item.x, item.z, item.r)
				end)
				if ok and result and result.ok then
					restored += 1
				end
			end
			flashStatus(restored > 0 and "Restored!" or "Couldn't restore — spot taken?", restored > 0 and GREEN or RED)
		end
	end

	-- Input --------------------------------------------------------------

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			lastPointer = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.Touch then
			lastPointer = Vector2.new(input.Position.X, input.Position.Y)
		end
		if gameProcessed then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			if input.UserInputType == Enum.UserInputType.Touch and BuildCamera.touchCount() > 1 then
				pressing = false
				hideStretchBox()
				return
			end
			if mode == "objects" and selected then
				local cell = ghostCell
				if cell then
					pressing = true
					pressStartCell = { cell[1], cell[2] }
				end
			elseif (mode == "rooms" and selectedRoom ~= nil) or mode == "foundation" then
				local gx, gz = cellUnderPointer(1, 1)
				if gx then
					pressing = true
					pressStartCell = { gx, gz }
				end
			elseif mode == "delete" then
				local gx, gz = cellUnderPointer(1, 1)
				if gx then
					pressing = true
					pressStartCell = { gx, gz }
				else
					tryDelete()
				end
			elseif mode == "staff" and pendingStaff then
				local gx, gz = cellUnderPointer(1, 1)
				if gx then
					local ok, result = pcall(function()
						return staffRequest:InvokeServer("hire", pendingStaff.id, gx, gz)
					end)
					if ok and result and result.ok then
						playSound("electronicpingshort.wav", 0.5)
						flashStatus(pendingStaff.id .. " hired!", GREEN)
					elseif ok and result then
						flashStatus(result.err or "Can't place them there.", RED)
					end
				end
			elseif mode == "move" then
				tryMove()
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			-- Right-click clears the current selection (PA habit).
			if mode == "move" and movingModel then
				movingModel = nil
				movingFrom = nil
				selected = nil
				destroyGhost()
				refreshSelectionLook()
				setStatusDefault("Move: click an object to pick it up")
			elseif mode == "staff" then
				setMode("objects")
			elseif mode == "objects" and selected then
				selected = nil
				destroyGhost()
				refreshSelectionLook()
			elseif mode == "rooms" and selectedRoom ~= nil then
				selectedRoom = nil
				refreshSelectionLook()
			else
				-- Nothing selected: right-clicking a blueprint cancels that
				-- construction job (queued or mid-hammer), full refund.
				local model = findPlacedModel()
				if model and model:GetAttribute("Blueprint") == true then
					local ok, result = pcall(function()
						return deleteRequest:InvokeServer(model)
					end)
					if ok and result and result.ok then
						playSound("snap.mp3", 0.5)
						flashStatus("Construction cancelled" ..
							((result.refund and result.refund > 0) and (" +" .. Format.money(result.refund)) or ""), ORANGE)
					end
				end
			end
		elseif input.KeyCode == Enum.KeyCode.B then
			setMode(mode == "off" and "objects" or "off")
		elseif input.KeyCode == Enum.KeyCode.R and mode == "objects" then
			rot = (rot + 1) % 4
		elseif input.KeyCode == Enum.KeyCode.Z and mode ~= "off"
			and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
				or UserInputService:IsKeyDown(Enum.KeyCode.RightControl))
		then
			doUndo()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end
		if not pressing then
			return
		end
		pressing = false
		hideStretchBox()

		if mode == "objects" and selected and pressStartCell then
			local style = dragStyleOf(selected)
			local endCell = ghostCell
			local moved = endCell
				and (endCell[1] ~= pressStartCell[1] or endCell[2] ~= pressStartCell[2])
			if moved and style == "line" then
				tryPlaceLine(pressStartCell[1], pressStartCell[2], endCell[1], endCell[2])
			elseif moved and style == "rect" then
				tryPlaceRect(pressStartCell[1], pressStartCell[2], endCell[1], endCell[2])
			elseif endCell and ghostValid then
				tryPlaceSingle(endCell[1], endCell[2])
			end
		elseif mode == "delete" and pressStartCell then
			local gx, gz = cellUnderPointer(1, 1)
			if gx and (gx ~= pressStartCell[1] or gz ~= pressStartCell[2]) then
				tryDeleteRect(pressStartCell[1], pressStartCell[2], gx, gz)
			else
				tryDelete()
			end
		elseif mode == "rooms" and selectedRoom ~= nil and pressStartCell then
			local gx, gz = cellUnderPointer(1, 1)
			if gx then
				tryPaintRoom(pressStartCell[1], pressStartCell[2], gx, gz)
			end
		elseif mode == "foundation" and pressStartCell then
			local gx, gz = cellUnderPointer(1, 1)
			if gx then
				tryFoundation(pressStartCell[1], pressStartCell[2], gx, gz)
			end
		end
		pressStartCell = nil
	end)

	RunService.RenderStepped:Connect(function()
		updateCursor()
		if mode == "objects" then
			updateGhost()
			if pressing and pressStartCell and selected and ghostCell then
				local style = dragStyleOf(selected)
				local moved = ghostCell[1] ~= pressStartCell[1] or ghostCell[2] ~= pressStartCell[2]
				if style == "line" and moved then
					local sx, sz, axis, count = GridMath.lineCells(
						pressStartCell[1], pressStartCell[2], ghostCell[1], ghostCell[2]
					)
					local ex = axis == "x" and sx + count - 1 or sx
					local ez = axis == "z" and sz + count - 1 or sz
					ghost.Parent = nil
					showStretchBox(sx, sz, ex, ez, GREEN)
				elseif style == "rect" and moved then
					ghost.Parent = nil
					showStretchBox(pressStartCell[1], pressStartCell[2], ghostCell[1], ghostCell[2], GREEN)
				else
					hideStretchBox()
				end
			end
		elseif mode == "rooms" then
			if pressing and pressStartCell then
				local gx, gz = cellUnderPointer(1, 1)
				if gx then
					local color = selectedRoom == 0 and Color3.fromRGB(230, 230, 230)
						or Config.RoomTypes[selectedRoom].color
					showStretchBox(pressStartCell[1], pressStartCell[2], gx, gz, color)
				end
			end
		elseif mode == "foundation" then
			if pressing and pressStartCell then
				local gx, gz = cellUnderPointer(1, 1)
				if gx then
					showStretchBox(pressStartCell[1], pressStartCell[2], gx, gz, Color3.fromRGB(120, 180, 255))
				end
			end
		elseif mode == "delete" and pressing and pressStartCell then
			clearHover()
			local gx, gz = cellUnderPointer(1, 1)
			if gx then
				showStretchBox(pressStartCell[1], pressStartCell[2], gx, gz, RED)
			end
		elseif mode == "staff" then
			if staffGhost and zone then
				local gx, gz = cellUnderPointer(1, 1)
				if gx then
					staffGhost.CFrame = GridMath.regionCenter(zone.info, gx, gz, 1, 1) * CFrame.new(0, 2.5, 0)
					staffGhost.Parent = workspace
				else
					staffGhost.Parent = nil
				end
			end
		elseif mode == "move" and movingModel then
			updateGhost()
		elseif mode == "delete" or mode == "move" then
			local model = findPlacedModel()
			if model then
				local color = mode == "delete" and RED or Color3.fromRGB(255, 230, 120)
				if not hoverHighlight then
					hoverHighlight = Instance.new("Highlight")
					hoverHighlight.FillTransparency = 0.6
					hoverHighlight.Parent = gui
				end
				hoverHighlight.FillColor = color
				hoverHighlight.OutlineColor = color
				hoverHighlight.Adornee = model
			elseif hoverHighlight then
				hoverHighlight.Adornee = nil
			end
		end
	end)

	-- What other UI modules need from build mode. StaffPanel arms PA's
	-- click-to-place hiring through this: pick a staff type, then click
	-- them down wherever you want them to start.
	local controller = {}
	function controller.placeStaff(def)
		if not zone then
			flashStatus("No build plot assigned yet!", RED)
			return
		end
		setMode("staff")
		pendingStaff = def
		makeStaffGhost(def)
		PAToolbar.openMenu("staff")
		setStatusDefault("Place " .. def.id .. " — click a square · right-click to stop")
	end
	return controller
end

return BuildMode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CashHud</string>
            <string name="Source"><![CDATA[-- CashHud: Prison Architect's readouts, in PA's exact places.
--
--   top-right:      the clock panel — the time big, "Day N — activity"
--                   under it. (PA's speed controls are deliberately
--                   absent: multiplayer time is shared.)
--   bottom-right:   the Balance and Prisoners rows, PA's corner
--                   readouts. Prisoners ambers when arrivals queue at
--                   the gate — CLICK IT to open the Intake panel.
--
-- Cash changes still blip ±$ off the Balance row, and the clock derives
-- from a single server epoch attribute — every player sees the same time
-- with zero network traffic.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage.Shared:WaitForChild("Format"))
local UIKit = require(script.Parent.UIKit)

local CashHud = {}

function CashHud.start(opts)
	opts = opts or {}
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local leaderstats = player:WaitForChild("leaderstats")
	local cashValue = leaderstats:WaitForChild("Cash")

	local gui = Instance.new("ScreenGui")
	gui.Name = "LockdownHud"
	gui.ResetOnSpawn = false

	-- Top-right: the clock panel ----------------------------------------
	local clockPanel = UIKit.panel(gui, "ClockPanel")
	clockPanel.AnchorPoint = Vector2.new(1, 0)
	clockPanel.Position = UDim2.new(1, -12, 0, 12)
	clockPanel.Size = UDim2.new(0, 124, 0, 58)

	local clockLabel = Instance.new("TextLabel")
	clockLabel.Position = UDim2.new(0, 0, 0, 4)
	clockLabel.Size = UDim2.new(1, 0, 0, 30)
	clockLabel.BackgroundTransparency = 1
	clockLabel.Font = Enum.Font.GothamBlack
	clockLabel.TextSize = 24
	clockLabel.TextColor3 = UIKit.TEXT
	clockLabel.Text = "00:00"
	clockLabel.Parent = clockPanel

	local clockSub = Instance.new("TextLabel")
	clockSub.Position = UDim2.new(0, 0, 0, 36)
	clockSub.Size = UDim2.new(1, 0, 0, 16)
	clockSub.BackgroundTransparency = 1
	clockSub.Font = Enum.Font.GothamMedium
	clockSub.TextSize = 12
	clockSub.TextColor3 = UIKit.DIM
	clockSub.Text = "Day 1"
	clockSub.Parent = clockPanel

	-- Bottom-right: Balance / Prisoners ---------------------------------
	local stack = Instance.new("Frame")
	stack.AnchorPoint = Vector2.new(1, 1)
	stack.Position = UDim2.new(1, -12, 1, -12)
	stack.Size = UDim2.new(0, 190, 0, 0)
	stack.AutomaticSize = Enum.AutomaticSize.Y
	stack.BackgroundTransparency = 1
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = stack
	stack.Parent = gui

	local function statRow(order, clickable)
		local row = Instance.new(clickable and "TextButton" or "Frame")
		row.LayoutOrder = order
		row.Size = UDim2.new(1, 0, 0, 24)
		row.BackgroundColor3 = UIKit.PANEL
		row.BackgroundTransparency = 0.03
		row.BorderSizePixel = 0
		if clickable then
			row.Text = ""
			row.AutoButtonColor = true
		end
		UIKit.stroke(row, UIKit.EDGE_DIM, 1, 0)
		local left = Instance.new("TextLabel")
		left.Position = UDim2.new(0, 8, 0, 0)
		left.Size = UDim2.new(0, 80, 1, 0)
		left.BackgroundTransparency = 1
		left.Font = Enum.Font.GothamMedium
		left.TextSize = 12
		left.TextXAlignment = Enum.TextXAlignment.Left
		left.TextColor3 = UIKit.DIM
		left.Parent = row
		local right = Instance.new("TextLabel")
		right.AnchorPoint = Vector2.new(1, 0)
		right.Position = UDim2.new(1, -8, 0, 0)
		right.Size = UDim2.new(0, 120, 1, 0)
		right.BackgroundTransparency = 1
		right.Font = Enum.Font.GothamBold
		right.TextSize = 14
		right.TextXAlignment = Enum.TextXAlignment.Right
		right.TextColor3 = UIKit.TEXT
		right.Parent = row
		row.Parent = stack
		return row, left, right
	end

	local infoRow, infoLeft, infoRight = statRow(1, false)
	infoRow.Size = UDim2.new(1, 0, 0, 18)
	infoRow.BackgroundTransparency = 0.35
	infoLeft.Text = "Grants"
	infoRight.Font = Enum.Font.GothamMedium
	infoRight.TextSize = 11
	infoRight.TextColor3 = UIKit.DIM

	local balanceRow, balanceLeft, balanceRight = statRow(2, false)
	balanceLeft.Text = "Balance"
	balanceRight.TextColor3 = UIKit.GOOD
	balanceRight.Text = Format.money(cashValue.Value)

	local prisonersRow, prisonersLeft, prisonersRight = statRow(3, true)
	prisonersLeft.Text = "Prisoners"
	prisonersRight.Text = "0 / 0"
	prisonersRow.Activated:Connect(function()
		if opts.onPrisoners then
			opts.onPrisoners()
		end
	end)

	-- The gate-stuck warning, top-center where PA floats its alerts.
	local stuckLine = Instance.new("TextLabel")
	stuckLine.AnchorPoint = Vector2.new(0.5, 0)
	stuckLine.Position = UDim2.new(0.5, 0, 0, 12)
	stuckLine.Size = UDim2.new(0, 440, 0, 18)
	stuckLine.BackgroundTransparency = 1
	stuckLine.Font = Enum.Font.GothamBold
	stuckLine.TextScaled = true
	stuckLine.TextColor3 = Color3.fromRGB(255, 170, 110)
	stuckLine.TextStrokeTransparency = 0.5
	stuckLine.Text = ""
	stuckLine.Parent = gui

	-- Security alerts (escapes, catches, lockdowns) under it, in red.
	local alertLine = Instance.new("TextLabel")
	alertLine.AnchorPoint = Vector2.new(0.5, 0)
	alertLine.Position = UDim2.new(0.5, 0, 0, 32)
	alertLine.Size = UDim2.new(0, 480, 0, 20)
	alertLine.BackgroundTransparency = 1
	alertLine.Font = Enum.Font.GothamBold
	alertLine.TextScaled = true
	alertLine.TextColor3 = Color3.fromRGB(255, 140, 125)
	alertLine.TextStrokeTransparency = 0.45
	alertLine.Text = ""
	alertLine.Parent = gui

	gui.Parent = playerGui

	local alertId = 0
	player:GetAttributeChangedSignal("SecurityAlert"):Connect(function()
		local raw = player:GetAttribute("SecurityAlert")
		if type(raw) ~= "string" then
			return
		end
		-- The server prefixes a counter so repeat alerts still fire.
		alertId += 1
		local id = alertId
		alertLine.Text = string.match(raw, "^%d+|(.*)$") or raw
		task.delay(6, function()
			if alertId == id then
				alertLine.Text = ""
			end
		end)
	end)

	-- Cash count-up + blips off the Balance row -------------------------
	local shown = cashValue.Value
	local lastValue = cashValue.Value

	cashValue.Changed:Connect(function(value)
		local delta = value - lastValue
		lastValue = value
		if delta == 0 then
			return
		end
		local blip = Instance.new("TextLabel")
		blip.AnchorPoint = Vector2.new(1, 1)
		blip.Position = UDim2.new(1, -4, 0, -2)
		blip.Size = UDim2.new(0, 110, 0, 18)
		blip.BackgroundTransparency = 1
		blip.Font = Enum.Font.GothamBlack
		blip.TextScaled = true
		blip.TextXAlignment = Enum.TextXAlignment.Right
		blip.TextColor3 = delta > 0 and UIKit.GOOD or UIKit.BAD
		blip.TextStrokeTransparency = 0.5
		blip.Text = (delta > 0 and "+" or "-") .. Format.money(math.abs(delta))
		blip.Parent = balanceRow
		TweenService:Create(blip, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = blip.Position + UDim2.new(0, 0, 0, -24),
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()
		task.delay(1.3, function()
			blip:Destroy()
		end)
	end)

	-- Live refreshes ----------------------------------------------------
	local function refreshStats()
		local housed = player:GetAttribute("PrisonHoused") or 0
		local capacity = player:GetAttribute("PrisonCapacity") or 0
		local waiting = player:GetAttribute("PrisonWaiting") or 0
		if waiting > 0 then
			prisonersRight.Text = ("%d / %d  (+%d)"):format(housed, capacity, waiting)
			prisonersRight.TextColor3 = UIKit.WARN
		else
			prisonersRight.Text = ("%d / %d"):format(housed, capacity)
			prisonersRight.TextColor3 = UIKit.TEXT
		end

		local unrest = player:GetAttribute("PrisonUnrest") or 0
		local perMin = housed * Config.GrantPerPrisoner * (60 / Config.GrantInterval) * (1 - unrest / 200)
		infoRight.Text = ("%s/min · unrest %d%%"):format(Format.money(perMin), unrest)
		infoRight.TextColor3 = unrest >= 60 and UIKit.BAD or (unrest >= 30 and UIKit.WARN or UIKit.DIM)

		stuckLine.Text = player:GetAttribute("IntakeStuck") == true
			and "⚠ Arrivals can't reach a cell — is there a door path?" or ""
	end
	local function refreshClockSub()
		local day = player:GetAttribute("PrisonDay") or 1
		if player:GetAttribute("PrisonLockdown") == true then
			clockSub.Text = ("Day %d — LOCKDOWN"):format(day)
			clockSub.TextColor3 = UIKit.BAD
		else
			clockSub.Text = ("Day %d — %s"):format(day, player:GetAttribute("RegimeActivity") or "FreeTime")
			clockSub.TextColor3 = UIKit.DIM
		end
	end
	for _, attr in ipairs({ "PrisonHoused", "PrisonCapacity", "PrisonWaiting", "IntakeStuck", "PrisonUnrest" }) do
		player:GetAttributeChangedSignal(attr):Connect(refreshStats)
	end
	player:GetAttributeChangedSignal("PrisonDay"):Connect(refreshClockSub)
	player:GetAttributeChangedSignal("RegimeActivity"):Connect(refreshClockSub)
	player:GetAttributeChangedSignal("PrisonLockdown"):Connect(refreshClockSub)
	refreshStats()
	refreshClockSub()

	RunService.RenderStepped:Connect(function(dt)
		-- Smooth cash count-up.
		local target = cashValue.Value
		if shown ~= target then
			shown += (target - shown) * math.min(dt * 6, 1)
			if math.abs(target - shown) < 1 then
				shown = target
			end
			balanceRight.Text = Format.money(shown)
		end

		-- The shared clock, derived from the server's epoch.
		local epoch = workspace:GetAttribute("ClockEpoch")
		if epoch then
			local dayFraction = ((workspace:GetServerTimeNow() - epoch) % Config.DayLength) / Config.DayLength
			local totalMinutes = math.floor(dayFraction * 24 * 60)
			clockLabel.Text = ("%02d:%02d"):format(math.floor(totalMinutes / 60), totalMinutes % 60)
		end
	end)
end

return CashHud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">EmergencyPanel</string>
            <string name="Source"><![CDATA[-- EmergencyPanel: PA's Emergencies tab — live as of Phase 5. Lockdown
-- toggles (confine everyone to cells, cool unrest, half grants); Roll
-- Call is a one-shot round-up on a cooldown. The contraband tools stay
-- listed but dim until that system exists. The tab wears a red alert dot
-- the whole time a lockdown is active.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.UIKit)
local PAIcons = require(script.Parent.PAIcons)
local PAToolbar = require(script.Parent.PAToolbar)

local EmergencyPanel = {}

function EmergencyPanel.start()
	local player = Players.LocalPlayer
	local emergencyRequest = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("EmergencyRequest")

	local menu = PAToolbar.menu("emergencies", "Emergencies", 260)

	local lockdownRow = PAToolbar.row(menu.list, {
		order = 1,
		name = "Lockdown",
		right = "OFF",
		onClick = function()
			pcall(function()
				return emergencyRequest:InvokeServer("lockdown")
			end)
		end,
	})
	PAIcons.draw(lockdownRow.icon, "emergencies", UIKit.BAD, 4)
	lockdownRow.right.TextColor3 = UIKit.DIM

	local rollcallRow
	rollcallRow = PAToolbar.row(menu.list, {
		order = 2,
		name = "Roll Call",
		right = "",
		onClick = function()
			local ok, result = pcall(function()
				return emergencyRequest:InvokeServer("rollcall")
			end)
			if ok and result and not result.ok and result.err then
				rollcallRow.right.Text = result.err
				rollcallRow.right.TextColor3 = UIKit.WARN
				task.delay(2.5, function()
					rollcallRow.right.Text = ""
				end)
			end
		end,
	})
	PAIcons.draw(rollcallRow.icon, "deployment", UIKit.ICON, 4)
	rollcallRow.right.Size = UDim2.new(0, 120, 0, 18)

	-- Waiting on the contraband system.
	for i, entry in ipairs({
		{ name = "Shakedown", icon = "intelligence" },
		{ name = "Tunnel Search", icon = "utilities" },
	}) do
		local row = PAToolbar.row(menu.list, { order = 2 + i, name = entry.name, right = "soon" })
		row.name.TextColor3 = UIKit.DIM
		row.right.TextColor3 = UIKit.DIM
		PAIcons.draw(row.icon, entry.icon, UIKit.ICON_DARK, 4)
	end
	menu.fit()

	PAToolbar.addTab({
		id = "emergencies",
		icon = "emergencies",
		label = "Emergencies",
		order = 27,
		onClick = function()
			PAToolbar.toggleMenu("emergencies")
		end,
	})
	menu.panel:GetPropertyChangedSignal("Visible"):Connect(function()
		PAToolbar.setPressed("emergencies", menu.panel.Visible)
	end)

	local function refresh()
		local on = player:GetAttribute("PrisonLockdown") == true
		lockdownRow.right.Text = on and "ON" or "OFF"
		lockdownRow.right.TextColor3 = on and UIKit.BAD or UIKit.DIM
		lockdownRow.setSelected(on)
		PAToolbar.setAlert("emergencies", on)
	end
	player:GetAttributeChangedSignal("PrisonLockdown"):Connect(refresh)
	refresh()
end

return EmergencyPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">InmateAnimator</string>
            <string name="Source"><![CDATA[-- InmateAnimator: brings the blocky prisoners to life — entirely on each
-- player's own device, so a full prison of them costs the server nothing.
--
-- Every inmate is in one of three states, driven by attributes the
-- server stamps on the model:
--   HANDCUFFED  (Handcuffed = true, no escort running)
--     Stands still at the gate, hands bound in front, tiny nervous bob.
--   ESCORTED    (EscortFrom/To/Start/Dur set)
--     Walks a straight line to their new cell, legs swinging, still cuffed.
--   HOUSED      (cuffs off)
--     Free-roams around their home spot: idle a while, amble to a random
--     nearby point, repeat. This is the "prison feels alive" layer.
--
-- Performance rules: no Humanoids, no physics — just CFrame math on
-- anchored parts, skipped entirely for inmates far from the camera.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local InmateAnimator = {}

local CULL_DISTANCE = 170
local LIMB_NAMES = { "LeftArm", "RightArm", "LeftLeg", "RightLeg" }

function InmateAnimator.start()
	local tracked = {}

	local REQUIRED_PARTS = { "Torso", "Head", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }
	local function rigComplete(model)
		for _, partName in ipairs(REQUIRED_PARTS) do
			if not model:FindFirstChild(partName) then
				return false
			end
		end
		return model.PrimaryPart ~= nil
	end

	local function watch(model)
		task.spawn(function()
			-- Wait for the WHOLE rig to replicate. Animating a half-arrived
			-- inmate leaves the late parts behind — instant body horror.
			local tries = 0
			while not rigComplete(model) and model.Parent ~= nil and tries < 100 do
				tries += 1
				task.wait(0.1)
			end
			if not (rigComplete(model) and model.Parent) then
				return
			end

			-- Work in FEET space: the model's pivot is its torso, 3 studs
			-- above the ground — everything here is measured from the feet
			-- so it lines up with the server's floor-level escort positions.
			local feetCF = model:GetPivot() * CFrame.new(0, -3, 0)
			local info = {
				parts = {},
				offsets = {}, -- part -> resting CFrame relative to the root
				hips = {}, -- limb part -> pivot point at the TOP of the limb
				seed = model:GetAttribute("Seed") or 0,
				pos = feetCF.Position,
				home = feetCF.Position,
				yaw = select(2, feetCF:ToEulerAnglesYXZ()),
				mode = "idle",
				timer = 1 + math.random() * 4,
				target = nil,
				phase = 0,
				escortTo = nil,
				pathKey = nil, -- which EscortStart the cached path belongs to
				path = nil, -- { points = {Vector3...}, lengths = {seg lens}, total }
			}
			for _, part in ipairs(model:GetChildren()) do
				if part:IsA("BasePart") and part.Name ~= "Cuffs" then
					info.parts[part.Name] = part
					info.offsets[part.Name] = feetCF:ToObjectSpace(part.CFrame)
				end
			end
			for _, limbName in ipairs(LIMB_NAMES) do
				if info.offsets[limbName] then
					-- Limbs rotate from their top (the shoulder / hip).
					info.hips[limbName] = info.offsets[limbName] * CFrame.new(0, 1, 0)
				end
			end

			-- When the server finishes an escort it clears EscortStart —
			-- that's the moment this inmate's home becomes the cell.
			model:GetAttributeChangedSignal("EscortStart"):Connect(function()
				if model:GetAttribute("EscortStart") == nil and info.escortTo then
					info.pos = info.escortTo
					info.home = info.escortTo
					info.escortTo = nil
					info.mode = "idle"
					info.timer = 1 + math.random() * 3
				end
			end)

			tracked[model] = info
		end)
	end

	for _, model in ipairs(CollectionService:GetTagged("Inmate")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("Inmate"):Connect(watch)
	CollectionService:GetInstanceRemovedSignal("Inmate"):Connect(function(model)
		tracked[model] = nil
	end)

	RunService.Heartbeat:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		local now = workspace:GetServerTimeNow()
		local t = os.clock()

		for model, info in pairs(tracked) do
			if model.Parent == nil then
				tracked[model] = nil
				continue
			end
			if (info.pos - camPos).Magnitude > CULL_DISTANCE then
				continue
			end

			local cuffed = model:GetAttribute("Handcuffed") == true
			local escortStart = model:GetAttribute("EscortStart")
			local walking = false
			local bob = 0

			local working = model:GetAttribute("Working") == true

			if escortStart then
				-- WALKING: follow the server's waypoint path on a shared
				-- clock, so everyone sees the same walk. (Falls back to a
				-- straight from->to line if no path was stamped.)
				local dur = model:GetAttribute("EscortDur") or 1
				if info.pathKey ~= escortStart then
					info.pathKey = escortStart
					info.path = nil
					local pathString = model:GetAttribute("EscortPath")
					local y = model:GetAttribute("EscortY") or info.pos.Y
					if type(pathString) == "string" then
						local points = {}
						for pair in string.gmatch(pathString, "[^|]+") do
							local xs, zs = string.match(pair, "([^,]+),([^,]+)")
							local px, pz = tonumber(xs), tonumber(zs)
							if px and pz then
								table.insert(points, Vector3.new(px, y, pz))
							end
						end
						if #points >= 2 then
							local lengths, total = {}, 0
							for i = 2, #points do
								local seg = (points[i] - points[i - 1]).Magnitude
								table.insert(lengths, seg)
								total += seg
							end
							info.path = { points = points, lengths = lengths, total = math.max(total, 0.001) }
						end
					end
				end

				local alpha = math.clamp((now - escortStart) / dur, 0, 1)
				if info.path then
					local walked = alpha * info.path.total
					local points = info.path.points
					for i = 1, #info.path.lengths do
						local seg = info.path.lengths[i]
						if walked <= seg or i == #info.path.lengths then
							local t2 = seg > 0 and math.clamp(walked / seg, 0, 1) or 1
							info.pos = points[i]:Lerp(points[i + 1], t2)
							local dir = points[i + 1] - points[i]
							if dir.Magnitude > 0.01 then
								info.yaw = math.atan2(-dir.X, -dir.Z)
							end
							break
						end
						walked -= seg
					end
					info.escortTo = points[#points]
				else
					local from = model:GetAttribute("EscortFrom")
					local to = model:GetAttribute("EscortTo")
					if typeof(from) == "Vector3" and typeof(to) == "Vector3" then
						info.escortTo = to
						info.pos = from:Lerp(to, alpha)
						local dir = to - from
						if dir.Magnitude > 0.01 then
							info.yaw = math.atan2(-dir.X, -dir.Z)
						end
					end
				end
				walking = alpha < 1
			elseif working then
				-- HAMMERING a blueprint: plant the feet, swing the arms.
				bob = math.abs(math.sin(t * 6 + info.seed)) * 0.06
			elseif cuffed then
				-- HANDCUFFED at the gate: stand still, shift nervously.
				bob = math.abs(math.sin(t * 1.4 + info.seed)) * 0.05
			else
				-- HOUSED: the idle/amble loop.
				if info.mode == "idle" then
					bob = math.abs(math.sin(t * 1.7 + info.seed)) * 0.08
					info.yaw += math.sin(t * 0.5 + info.seed) * 0.003
					info.timer -= dt
					if info.timer <= 0 then
						local angle = math.random() * math.pi * 2
						local radius = 1 + math.random() * (Config.WanderRadius - 1)
						info.target = info.home + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
						info.mode = "walk"
					end
				else
					local dir = info.target - info.pos
					local flat = Vector3.new(dir.X, 0, dir.Z)
					if flat.Magnitude < 0.2 then
						info.mode = "idle"
						info.timer = 2 + math.random() * 5
					else
						local step = math.min(Config.WalkSpeed * dt, flat.Magnitude)
						info.pos += flat.Unit * step
						local wantYaw = math.atan2(-flat.X, -flat.Z)
						local diff = math.atan2(math.sin(wantYaw - info.yaw), math.cos(wantYaw - info.yaw))
						info.yaw += diff * math.min(dt * 8, 1)
						walking = true
					end
				end
			end

			if walking then
				info.phase += dt * 9
				bob = math.abs(math.sin(info.phase)) * 0.12
			end

			-- Write the skeleton: root, then each limb with its motion.
			local root = CFrame.new(info.pos + Vector3.new(0, bob, 0)) * CFrame.Angles(0, info.yaw, 0)
			local swing = walking and math.sin(info.phase) * 0.5 or 0

			for name, part in pairs(info.parts) do
				if name == "LeftLeg" or name == "RightLeg" then
					local legSwing = name == "LeftLeg" and swing or -swing
					part.CFrame = root * info.hips[name] * CFrame.Angles(legSwing, 0, 0) * CFrame.new(0, -1, 0)
				elseif name == "LeftArm" or name == "RightArm" then
					local armCF
					if working then
						-- Alternating hammer swings.
						local swingPhase = t * 10 + info.seed + (name == "LeftArm" and 0 or math.pi)
						armCF = CFrame.Angles(-0.6 + math.sin(swingPhase) * 0.55, 0, 0)
					elseif cuffed then
						-- Hands bound in front at the waist.
						armCF = CFrame.Angles(math.rad(-50), 0, name == "LeftArm" and math.rad(12) or math.rad(-12))
					elseif walking then
						armCF = CFrame.Angles(name == "LeftArm" and -swing * 0.7 or swing * 0.7, 0, 0)
					else
						armCF = CFrame.Angles(math.sin(t * 1.1 + info.seed) * 0.04, 0, 0)
					end
					part.CFrame = root * info.hips[name] * armCF * CFrame.new(0, -1, 0)
				else
					part.CFrame = root * info.offsets[name]
				end
			end

			-- The cuffs prop rides along in front of the waist.
			local cuffsPart = model:FindFirstChild("Cuffs")
			if cuffsPart then
				cuffsPart.CFrame = root * CFrame.new(0, 2.3, -1.05)
			end
		end
	end)
end

return InmateAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">IntakePanel</string>
            <string name="Source"><![CDATA[-- IntakePanel: the warden's intake report — accept prisoners by hand or
-- flip on auto-intake. It's the popup behind the Prisoners readout in
-- the bottom-right corner (CashHud wires the click through the client
-- bootstrap), styled as a PA panel and coordinated by UIKit so it never
-- overlaps another menu.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.UIKit)

local IntakePanel = {}

local panel = nil

-- CashHud's Prisoners row calls this.
function IntakePanel.toggle()
	if panel then
		UIKit.showOnly(panel)
	end
end

function IntakePanel.start()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local intakeRequest = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("IntakeRequest")

	local gui = Instance.new("ScreenGui")
	gui.Name = "LockdownIntake"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 6

	panel = UIKit.panel(gui, "IntakePanel")
	panel.AnchorPoint = Vector2.new(1, 1)
	panel.Position = UDim2.new(1, -12, 1, -104)
	panel.Size = UDim2.new(0, 232, 0, 168)
	UIKit.titleBar(panel, "Intake")
	UIKit.registerPanel(panel)

	local function label(y, color)
		local l = Instance.new("TextLabel")
		l.Position = UDim2.new(0, 10, 0, y)
		l.Size = UDim2.new(1, -20, 0, 18)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.GothamMedium
		l.TextSize = 13
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = color or UIKit.TEXT
		l.Parent = panel
		return l
	end
	local housedLabel = label(32)
	local waitingLabel = label(52)
	local statusLabel = label(72, UIKit.DIM)

	local function paButton(y, text)
		local b = Instance.new("TextButton")
		b.Position = UDim2.new(0, 10, 0, y)
		b.Size = UDim2.new(1, -20, 0, 26)
		b.BackgroundColor3 = UIKit.BTN
		b.BorderSizePixel = 0
		b.AutoButtonColor = true
		b.Font = Enum.Font.GothamBold
		b.TextSize = 13
		b.TextColor3 = UIKit.TEXT
		b.Text = text
		UIKit.stroke(b, UIKit.EDGE, 1, 0.35)
		b.Parent = panel
		return b
	end
	local acceptButton = paButton(96, "Accept Prisoner")
	local autoButton = paButton(128, "Auto-Intake: …")

	gui.Parent = playerGui

	local statusId = 0
	local function flash(text, color)
		statusId += 1
		local id = statusId
		statusLabel.Text = text
		statusLabel.TextColor3 = color
		task.delay(3, function()
			if statusId == id then
				statusLabel.Text = ""
			end
		end)
	end

	local function refresh()
		local housed = player:GetAttribute("PrisonHoused") or 0
		local capacity = player:GetAttribute("PrisonCapacity") or 0
		local waiting = player:GetAttribute("PrisonWaiting") or 0
		local auto = player:GetAttribute("AutoIntake")
		housedLabel.Text = ("Housed: %d / %d"):format(housed, capacity)
		waitingLabel.Text = ("At the gate: %d"):format(waiting)
		waitingLabel.TextColor3 = waiting > 0 and UIKit.WARN or UIKit.TEXT
		autoButton.Text = auto and "Auto-Intake: ON" or "Auto-Intake: OFF"
		autoButton.BackgroundColor3 = auto and UIKit.BTN_ON or UIKit.BTN
	end
	for _, attr in ipairs({ "PrisonHoused", "PrisonCapacity", "PrisonWaiting", "AutoIntake" }) do
		player:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	refresh()

	acceptButton.Activated:Connect(function()
		local ok, result = pcall(function()
			return intakeRequest:InvokeServer("accept")
		end)
		if ok and result and result.ok then
			flash("New prisoner at the gate!", UIKit.GOOD)
		elseif ok and result then
			flash(result.err or "Couldn't accept.", UIKit.BAD)
		end
	end)
	autoButton.Activated:Connect(function()
		pcall(function()
			return intakeRequest:InvokeServer("toggleAuto")
		end)
	end)
end

return IntakePanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">MoodDisplay</string>
            <string name="Source"><![CDATA[-- MoodDisplay: a small mood face that floats over unhappy prisoners so
-- you can spot trouble from the top-down view (PA shows need bubbles).
-- Purely cosmetic and client-side; it reads the Mood attribute the
-- server sets on each housed prisoner (staff and workers never get one,
-- so they stay bubble-free).

local CollectionService = game:GetService("CollectionService")

local MoodDisplay = {}

local FACES = {
	safety = "😨",
	food = "🍽️",
	sleep = "😴",
	hygiene = "🚿",
	recreation = "🥱",
	uneasy = "😕",
}

function MoodDisplay.start()
	local shown = {} -- model -> BillboardGui

	local function update(model)
		local mood = model:GetAttribute("Mood")
		local gui = shown[model]
		-- "content" (or nil) shows nothing.
		if not mood or mood == "content" then
			if gui then
				gui.Enabled = false
			end
			return
		end
		if not gui then
			local head = model:FindFirstChild("Head")
			if not head then
				return
			end
			gui = Instance.new("BillboardGui")
			gui.Name = "MoodBubble"
			gui.Size = UDim2.new(0, 30, 0, 30)
			gui.StudsOffset = Vector3.new(0, 2.6, 0)
			gui.AlwaysOnTop = true
			gui.MaxDistance = 120
			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamBold
			label.TextScaled = true
			label.Name = "Face"
			label.Parent = gui
			gui.Parent = head
			shown[model] = gui
		end
		gui.Enabled = true
		gui.Face.Text = FACES[mood] or "😕"
	end

	local function watch(model)
		task.spawn(function()
			-- Only prisoners ever get a Mood attribute set.
			model:GetAttributeChangedSignal("Mood"):Connect(function()
				update(model)
			end)
			update(model)
		end)
	end

	for _, model in ipairs(CollectionService:GetTagged("Inmate")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("Inmate"):Connect(watch)
	CollectionService:GetInstanceRemovedSignal("Inmate"):Connect(function(model)
		shown[model] = nil
	end)
end

return MoodDisplay
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">PAIcons</string>
            <string name="Source"><![CDATA[-- PAIcons: the toolbar's icon art, drawn in code.
--
-- Prison Architect's real icons are copyrighted image files, so shipping
-- them would get the game struck. Instead, every icon here is a tiny
-- picture assembled from plain Frames — rectangles, rotated rectangles
-- and rounded circles — in the same flat single-color style. Original
-- art, nothing to upload, and each icon is one function, so swapping one
-- for a real image later touches exactly one place.

local PAIcons = {}

local function rect(canvas, color, x, y, w, h, rot, round)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.Rotation = rot or 0
	if round then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(round, 0)
		c.Parent = f
	end
	f.Parent = canvas
	return f
end

local function outline(canvas, color, x, y, w, h, thickness, rot, round)
	local f = rect(canvas, color, x, y, w, h, rot, round)
	f.BackgroundTransparency = 1
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
	return f
end

local DRAW = {}

function DRAW.build(c, col) -- hammer
	rect(c, col, 0.42, 0.6, 0.14, 0.62, 45)
	rect(c, col, 0.6, 0.3, 0.46, 0.22, 45)
end

function DRAW.foundations(c, col) -- house plan
	outline(c, col, 0.5, 0.64, 0.56, 0.46, 2)
	rect(c, col, 0.5, 0.28, 0.34, 0.34, 45)
end

function DRAW.walls(c, col) -- brick courses
	rect(c, col, 0.3, 0.26, 0.44, 0.16)
	rect(c, col, 0.76, 0.26, 0.36, 0.16)
	rect(c, col, 0.24, 0.5, 0.32, 0.16)
	rect(c, col, 0.68, 0.5, 0.48, 0.16)
	rect(c, col, 0.3, 0.74, 0.44, 0.16)
	rect(c, col, 0.76, 0.74, 0.36, 0.16)
end

function DRAW.flooring(c, col) -- checkerboard tiles
	rect(c, col, 0.34, 0.34, 0.3, 0.3)
	rect(c, col, 0.68, 0.68, 0.3, 0.3)
	outline(c, col, 0.68, 0.34, 0.3, 0.3, 1.5)
	outline(c, col, 0.34, 0.68, 0.3, 0.3, 1.5)
end

function DRAW.rooms(c, col) -- paint roller
	rect(c, col, 0.46, 0.28, 0.64, 0.26, 0, 0.25)
	rect(c, col, 0.72, 0.52, 0.1, 0.26)
	rect(c, col, 0.72, 0.78, 0.16, 0.24, 0, 0.3)
end

function DRAW.objects(c, col) -- chair, side on
	rect(c, col, 0.34, 0.4, 0.12, 0.56)
	rect(c, col, 0.54, 0.62, 0.52, 0.12)
	rect(c, col, 0.74, 0.82, 0.1, 0.3)
	rect(c, col, 0.38, 0.82, 0.1, 0.3)
end

function DRAW.staff(c, col) -- person with a cap
	rect(c, col, 0.5, 0.1, 0.32, 0.1)
	rect(c, col, 0.5, 0.27, 0.26, 0.26, 0, 0.5)
	rect(c, col, 0.5, 0.68, 0.5, 0.4, 0, 0.25)
end

function DRAW.utilities(c, col) -- lightning bolt
	rect(c, col, 0.56, 0.3, 0.18, 0.44, 20)
	rect(c, col, 0.44, 0.68, 0.18, 0.44, 20)
end

function DRAW.deployment(c, col) -- shield
	outline(c, col, 0.5, 0.5, 0.52, 0.52, 2, 45)
	rect(c, col, 0.5, 0.5, 0.22, 0.22, 45)
end

function DRAW.logistics(c, col) -- shipping crate
	outline(c, col, 0.5, 0.55, 0.62, 0.5, 2)
	rect(c, col, 0.5, 0.42, 0.62, 0.07)
	rect(c, col, 0.5, 0.64, 0.08, 0.32)
end

function DRAW.intelligence(c, col) -- watching eye
	outline(c, col, 0.5, 0.5, 0.8, 0.44, 2, 0, 0.5)
	rect(c, col, 0.5, 0.5, 0.2, 0.2, 0, 0.5)
end

function DRAW.quickbuild(c, col) -- room with a plus
	outline(c, col, 0.5, 0.55, 0.56, 0.46, 2)
	rect(c, col, 0.5, 0.55, 0.3, 0.08)
	rect(c, col, 0.5, 0.55, 0.08, 0.3)
end

function DRAW.planning(c, col) -- pencil
	rect(c, col, 0.56, 0.44, 0.16, 0.6, 45)
	rect(c, col, 0.28, 0.72, 0.13, 0.13, 45)
	rect(c, col, 0.78, 0.22, 0.18, 0.1, 45)
end

function DRAW.emergencies(c, col) -- alarm "!"
	rect(c, col, 0.5, 0.36, 0.16, 0.44)
	rect(c, col, 0.5, 0.76, 0.16, 0.14)
end

function DRAW.move(c, col) -- crossed arrows
	rect(c, col, 0.5, 0.5, 0.8, 0.13)
	rect(c, col, 0.5, 0.5, 0.13, 0.8)
	rect(c, col, 0.5, 0.12, 0.18, 0.18, 45)
	rect(c, col, 0.5, 0.88, 0.18, 0.18, 45)
	rect(c, col, 0.12, 0.5, 0.18, 0.18, 45)
	rect(c, col, 0.88, 0.5, 0.18, 0.18, 45)
end

function DRAW.bulldoze(c, col) -- demolish X
	rect(c, col, 0.5, 0.5, 0.16, 0.9, 45)
	rect(c, col, 0.5, 0.5, 0.16, 0.9, -45)
end

function DRAW.box(c, col) -- generic category crate
	outline(c, col, 0.5, 0.5, 0.6, 0.55, 2)
	rect(c, col, 0.5, 0.35, 0.6, 0.07)
end

-- Draw `name` into `parent` (any square-ish GuiObject). The art scales
-- with the parent, minus `inset` px of breathing room per side.
function PAIcons.draw(parent, name, color, inset)
	local canvas = Instance.new("Frame")
	canvas.Name = "IconArt"
	canvas.AnchorPoint = Vector2.new(0.5, 0.5)
	canvas.Position = UDim2.fromScale(0.5, 0.5)
	canvas.Size = UDim2.new(1, -2 * (inset or 7), 1, -2 * (inset or 7))
	canvas.BackgroundTransparency = 1
	local fn = DRAW[name] or DRAW.box
	fn(canvas, color)
	canvas.Parent = parent
	return canvas
end

return PAIcons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">PAToolbar</string>
            <string name="Source"><![CDATA[-- PAToolbar: Prison Architect's bottom-left toolbar, rebuilt for Roblox.
--
-- A strip of square blueprint-blue buttons hugs the bottom-left corner
-- (icon art drawn in code — see PAIcons). Hovering shows a tooltip;
-- locked tabs render dark exactly like PA's, and clicking a live tab
-- opens a PA-style menu ABOVE the strip: a titled panel of rows, each
-- with an icon, a name and a price. UIKit's coordinator guarantees only
-- one menu is open at a time.
--
-- Other files register their tabs through addTab/menu — the strip builds
-- itself lazily on the first call, so registration order doesn't matter
-- (LayoutOrder decides the on-screen order).

local Players = game:GetService("Players")

local UIKit = require(script.Parent.UIKit)
local PAIcons = require(script.Parent.PAIcons)

local PAToolbar = {}

local BTN = 44 -- toolbar buttons are squares this big

local gui, strip, tooltip
local entries = {} -- id -> { button, enabled, pressed }
local menus = {} -- id -> menu panel frame
local activeTool = nil

local function ensure()
	if gui then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Instance.new("ScreenGui")
	gui.Name = "LockdownToolbar"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5

	strip = Instance.new("Frame")
	strip.Name = "Strip"
	strip.AnchorPoint = Vector2.new(0, 1)
	strip.Position = UDim2.new(0, 12, 1, -12)
	strip.AutomaticSize = Enum.AutomaticSize.X
	strip.Size = UDim2.new(0, 0, 0, BTN + 8)
	strip.BackgroundColor3 = UIKit.STRIP
	strip.BackgroundTransparency = 0.05
	strip.BorderSizePixel = 0
	UIKit.stroke(strip, UIKit.EDGE_DIM, 1, 0)
	UIKit.pad(strip, 4)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = strip
	strip.Parent = gui

	tooltip = Instance.new("TextLabel")
	tooltip.Name = "Tooltip"
	tooltip.AnchorPoint = Vector2.new(0.5, 1)
	tooltip.AutomaticSize = Enum.AutomaticSize.XY
	tooltip.Size = UDim2.new(0, 0, 0, 0)
	tooltip.BackgroundColor3 = UIKit.STRIP
	tooltip.BorderSizePixel = 0
	tooltip.Font = Enum.Font.GothamMedium
	tooltip.TextSize = 13
	tooltip.TextColor3 = UIKit.TEXT
	tooltip.Visible = false
	tooltip.ZIndex = 60
	UIKit.stroke(tooltip, UIKit.EDGE_DIM, 1, 0)
	UIKit.pad(tooltip, 5)
	tooltip.Parent = gui

	gui.Parent = playerGui
end

local function paint(id)
	local e = entries[id]
	if not e then
		return
	end
	if e.pressed then
		e.button.BackgroundColor3 = UIKit.BTN_ON
	elseif e.enabled then
		e.button.BackgroundColor3 = UIKit.BTN
	else
		e.button.BackgroundColor3 = UIKit.BTN_DARK
	end
end

-- Add a square tab. def = { id, icon (PAIcons name), label (tooltip),
-- order, enabled (default true), onClick }.
function PAToolbar.addTab(def)
	ensure()
	local enabled = def.enabled ~= false
	local button = Instance.new("TextButton")
	button.Name = def.id
	button.LayoutOrder = def.order or 0
	button.Size = UDim2.fromOffset(BTN, BTN)
	button.BackgroundColor3 = enabled and UIKit.BTN or UIKit.BTN_DARK
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	UIKit.stroke(button, enabled and UIKit.EDGE or UIKit.EDGE_DIM, 1, 0.35)
	PAIcons.draw(button, def.icon, enabled and UIKit.ICON or UIKit.ICON_DARK)

	-- The little red attention dot (payroll missed, etc.).
	local alert = Instance.new("Frame")
	alert.Name = "Alert"
	alert.AnchorPoint = Vector2.new(1, 0)
	alert.Position = UDim2.new(1, -3, 0, 3)
	alert.Size = UDim2.fromOffset(9, 9)
	alert.BackgroundColor3 = UIKit.BAD
	alert.BorderSizePixel = 0
	alert.Visible = false
	alert.Parent = button

	local entry = { button = button, enabled = enabled, pressed = false }
	entries[def.id] = entry

	button.MouseEnter:Connect(function()
		if enabled and not entry.pressed then
			button.BackgroundColor3 = UIKit.BTN_HOVER
		end
		tooltip.Text = def.label .. (enabled and "" or "  (locked)")
		tooltip.Position = UDim2.fromOffset(
			button.AbsolutePosition.X + button.AbsoluteSize.X / 2,
			button.AbsolutePosition.Y - 6
		)
		tooltip.Visible = true
	end)
	button.MouseLeave:Connect(function()
		paint(def.id)
		tooltip.Visible = false
	end)
	button.Activated:Connect(function()
		tooltip.Visible = false
		if def.onClick then
			def.onClick(button)
		end
	end)
	button.Parent = strip
	return button
end

function PAToolbar.setPressed(id, on)
	local e = entries[id]
	if e then
		e.pressed = on == true
		paint(id)
	end
end

-- Exactly one TOOL tab is pressed at a time (the walk toggle is managed
-- separately with setPressed — it can be lit alongside a tool).
function PAToolbar.setActiveTool(id)
	if activeTool and activeTool ~= id then
		PAToolbar.setPressed(activeTool, false)
	end
	activeTool = id
	if id then
		PAToolbar.setPressed(id, true)
	end
end

function PAToolbar.setAlert(id, on)
	local e = entries[id]
	local a = e and e.button:FindFirstChild("Alert")
	if a then
		a.Visible = on == true
	end
end

-- Create the PA menu that opens above the strip for a tab. Fill its
-- .list with row()s, then call .fit() to size the panel to its contents.
function PAToolbar.menu(id, title, width)
	ensure()
	width = width or 272
	local panel = Instance.new("Frame")
	panel.Name = id .. "Menu"
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.Position = UDim2.new(0, 12, 1, -(12 + BTN + 8 + 6))
	panel.Size = UDim2.new(0, width, 0, 120)
	panel.BackgroundColor3 = UIKit.PANEL
	panel.BackgroundTransparency = 0.03
	panel.BorderSizePixel = 0
	UIKit.stroke(panel, UIKit.EDGE_DIM, 1, 0)
	UIKit.titleBar(panel, title)

	local list = Instance.new("ScrollingFrame")
	list.Name = "List"
	list.Position = UDim2.new(0, 0, 0, 26)
	list.Size = UDim2.new(1, 0, 1, -26)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 4
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = list
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = list
	list.Parent = panel

	panel.Parent = gui
	UIKit.registerPanel(panel)
	menus[id] = panel

	local handle = { panel = panel, list = list }
	function handle.fit()
		local total = 8
		local count = 0
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then
				total += child.Size.Y.Offset
				count += 1
			end
		end
		total += math.max(count - 1, 0) * 2
		panel.Size = UDim2.new(0, width, 0, 26 + math.min(total, 400))
	end
	return handle
end

-- Toggle a tab's menu (closing every other panel). Returns visibility.
function PAToolbar.toggleMenu(id)
	return UIKit.showOnly(menus[id])
end

-- Open a tab's menu if it isn't already the one showing.
function PAToolbar.openMenu(id)
	local panel = menus[id]
	if panel and not panel.Visible then
		UIKit.showOnly(panel)
	end
end

-- One PA menu row: [icon] Name ............ $price. opts = { order,
-- name, right, height, onClick }. Put art in .icon; flip .setSelected.
function PAToolbar.row(list, opts)
	local button = Instance.new("TextButton")
	button.LayoutOrder = opts.order or 0
	button.Size = UDim2.new(1, -8, 0, opts.height or 34)
	button.BackgroundColor3 = UIKit.ROW_HOVER
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""

	local selectedState = false
	local function paintRow(hover)
		if selectedState then
			button.BackgroundColor3 = UIKit.ROW_ON
			button.BackgroundTransparency = 0
		elseif hover then
			button.BackgroundColor3 = UIKit.ROW_HOVER
			button.BackgroundTransparency = 0
		else
			button.BackgroundTransparency = 1
		end
	end
	button.MouseEnter:Connect(function()
		paintRow(true)
	end)
	button.MouseLeave:Connect(function()
		paintRow(false)
	end)

	local iconSlot = Instance.new("Frame")
	iconSlot.Name = "IconSlot"
	iconSlot.AnchorPoint = Vector2.new(0, 0.5)
	iconSlot.Position = UDim2.new(0, 8, 0.5, 0)
	iconSlot.Size = UDim2.fromOffset(26, 26)
	iconSlot.BackgroundTransparency = 1
	iconSlot.Parent = button

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Position = UDim2.new(0, 42, 0, 0)
	nameLabel.Size = UDim2.new(1, -116, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.TextSize = 15
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.TextColor3 = UIKit.TEXT
	nameLabel.Text = opts.name or ""
	nameLabel.Parent = button

	local rightLabel = Instance.new("TextLabel")
	rightLabel.Name = "ItemRight"
	rightLabel.AnchorPoint = Vector2.new(1, 0.5)
	rightLabel.Position = UDim2.new(1, -10, 0.5, 0)
	rightLabel.Size = UDim2.new(0, 64, 0, 18)
	rightLabel.BackgroundTransparency = 1
	rightLabel.Font = Enum.Font.GothamBold
	rightLabel.TextSize = 14
	rightLabel.TextXAlignment = Enum.TextXAlignment.Right
	rightLabel.TextColor3 = UIKit.GOOD
	rightLabel.Text = opts.right or ""
	rightLabel.Parent = button

	if opts.onClick then
		button.Activated:Connect(opts.onClick)
	end
	button.Parent = list

	local handle = { button = button, icon = iconSlot, name = nameLabel, right = rightLabel }
	function handle.setSelected(on)
		selectedState = on == true
		paintRow(false)
	end
	return handle
end

return PAToolbar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">StaffPanel</string>
            <string name="Source"><![CDATA[-- StaffPanel: PA's Staff tab, living in the toolbar like the original.
-- Its menu lists each staff type as a PA row — click a row to pick that
-- hire up, then CLICK THEM DOWN wherever you want them (BuildMode's
-- staff-placement mode handles the ghost and the click). The − lets one
-- go, the payroll footer shows the running wage bill, and the tab grows
-- a red alert dot the moment payroll is missed.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage.Shared:WaitForChild("Format"))
local UIKit = require(script.Parent.UIKit)
local PAIcons = require(script.Parent.PAIcons)
local PAToolbar = require(script.Parent.PAToolbar)

local StaffPanel = {}

-- Icon tints so the trades read apart at a glance.
local TINTS = {
	Workman = Color3.fromRGB(255, 205, 105),
	Guard = Color3.fromRGB(126, 156, 224),
	Cook = Color3.fromRGB(236, 236, 236),
	Janitor = Color3.fromRGB(120, 196, 140),
}

-- `build` is BuildMode's controller (wired in the client bootstrap).
function StaffPanel.start(build)
	local player = Players.LocalPlayer
	local staffRequest = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("StaffRequest")

	local menu = PAToolbar.menu("staff", "Staff", 260)
	local rows = {}
	for i, def in ipairs(Config.StaffTypes) do
		local handle = PAToolbar.row(menu.list, {
			order = i,
			name = def.id,
			right = Format.money(def.wage),
			onClick = function()
				build.placeStaff({ id = def.id, tint = TINTS[def.id] })
			end,
		})
		PAIcons.draw(handle.icon, "staff", TINTS[def.id] or UIKit.ICON, 2)

		-- The little − lets one go (the row itself hires).
		local fire = Instance.new("TextButton")
		fire.AnchorPoint = Vector2.new(1, 0.5)
		fire.Position = UDim2.new(1, -80, 0.5, 0)
		fire.Size = UDim2.new(0, 22, 0, 22)
		fire.BackgroundColor3 = UIKit.PANEL
		fire.BorderSizePixel = 0
		fire.AutoButtonColor = true
		fire.Font = Enum.Font.GothamBold
		fire.TextSize = 16
		fire.TextColor3 = UIKit.BAD
		fire.Text = "−"
		UIKit.stroke(fire, UIKit.EDGE_DIM, 1, 0)
		fire.Activated:Connect(function()
			pcall(function()
				return staffRequest:InvokeServer("fire", def.id)
			end)
		end)
		fire.Parent = handle.button
		rows[def.id] = handle
	end

	-- Payroll footer under the rows.
	local payroll = Instance.new("TextLabel")
	payroll.LayoutOrder = 99
	payroll.Size = UDim2.new(1, -8, 0, 22)
	payroll.BackgroundTransparency = 1
	payroll.Font = Enum.Font.GothamMedium
	payroll.TextSize = 12
	payroll.TextXAlignment = Enum.TextXAlignment.Left
	payroll.TextColor3 = UIKit.DIM
	payroll.Text = ""
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.Parent = payroll
	payroll.Parent = menu.list
	menu.fit()

	PAToolbar.addTab({
		id = "staff",
		icon = "staff",
		label = "Staff",
		order = 12,
		onClick = function()
			PAToolbar.toggleMenu("staff")
		end,
	})
	-- Stay lit exactly while the menu shows (however it gets closed).
	menu.panel:GetPropertyChangedSignal("Visible"):Connect(function()
		PAToolbar.setPressed("staff", menu.panel.Visible)
	end)

	local function refresh()
		local total = player:GetAttribute("StaffWage") or 0
		local unpaid = player:GetAttribute("StaffUnpaid") == true
		payroll.Text = ("Payroll %s / %ds%s"):format(
			Format.money(total), Config.WageInterval, unpaid and " — UNPAID!" or "")
		payroll.TextColor3 = unpaid and UIKit.BAD or UIKit.DIM
		for _, def in ipairs(Config.StaffTypes) do
			local n = player:GetAttribute("Staff_" .. def.id) or 0
			rows[def.id].name.Text = n > 0 and ("%s  ×%d"):format(def.id, n) or def.id
		end
		PAToolbar.setAlert("staff", unpaid)
	end
	for _, def in ipairs(Config.StaffTypes) do
		player:GetAttributeChangedSignal("Staff_" .. def.id):Connect(refresh)
	end
	player:GetAttributeChangedSignal("StaffWage"):Connect(refresh)
	player:GetAttributeChangedSignal("StaffUnpaid"):Connect(refresh)
	refresh()
end

return StaffPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[-- UIKit: the shared Prison Architect look. One palette, a few builders,
-- and a panel coordinator so only one menu is ever open at a time.
--
-- PA's HUD is steel-gray panels with sharp corners, 1px borders and
-- blueprint-blue buttons — so that's what everything here produces. The
-- art itself is ours (see PAIcons); only the layout language is PA's.
-- Every client menu builds through here, so restyling the whole game is
-- one file.

local UIKit = {}

-- Palette -----------------------------------------------------------------

UIKit.STRIP = Color3.fromRGB(24, 28, 33) -- the toolbar strip / tooltips
UIKit.PANEL = Color3.fromRGB(33, 37, 43) -- menu + readout bodies
UIKit.TITLE = Color3.fromRGB(45, 51, 59) -- menu title bars

UIKit.BTN = Color3.fromRGB(42, 58, 76) -- blueprint-blue buttons
UIKit.BTN_HOVER = Color3.fromRGB(54, 74, 96)
UIKit.BTN_ON = Color3.fromRGB(66, 110, 152) -- pressed / active tab
UIKit.BTN_DARK = Color3.fromRGB(27, 32, 38) -- locked tabs (PA's dark ones)

UIKit.EDGE = Color3.fromRGB(106, 137, 168) -- thin border on live buttons
UIKit.EDGE_DIM = Color3.fromRGB(56, 66, 78) -- border on panels/locked tabs

UIKit.ROW_HOVER = Color3.fromRGB(52, 58, 66) -- menu row under the mouse
UIKit.ROW_ON = Color3.fromRGB(45, 95, 138) -- selected menu row

UIKit.ICON = Color3.fromRGB(208, 224, 238) -- icon art on live buttons
UIKit.ICON_DARK = Color3.fromRGB(74, 85, 96) -- icon art on locked ones

UIKit.TEXT = Color3.fromRGB(232, 236, 239)
UIKit.DIM = Color3.fromRGB(154, 164, 173)
UIKit.GOOD = Color3.fromRGB(125, 220, 132)
UIKit.WARN = Color3.fromRGB(232, 179, 75)
UIKit.BAD = Color3.fromRGB(224, 94, 80)

-- Builders ----------------------------------------------------------------

function UIKit.stroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(0, 0, 0)
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return s
end

function UIKit.pad(inst, px)
	local p = Instance.new("UIPadding")
	local u = UDim.new(0, px)
	p.PaddingLeft, p.PaddingRight, p.PaddingTop, p.PaddingBottom = u, u, u, u
	p.Parent = inst
	return p
end

-- A PA panel: sharp corners, PANEL fill, 1px EDGE_DIM border.
function UIKit.panel(parent, name)
	local frame = Instance.new("Frame")
	frame.Name = name or "Panel"
	frame.BackgroundColor3 = UIKit.PANEL
	frame.BackgroundTransparency = 0.03
	frame.BorderSizePixel = 0
	UIKit.stroke(frame, UIKit.EDGE_DIM, 1, 0)
	frame.Parent = parent
	return frame
end

-- The 26px title bar every PA menu carries: name left, × on the right.
function UIKit.titleBar(panel, text)
	local bar = Instance.new("Frame")
	bar.Name = "TitleBar"
	bar.Size = UDim2.new(1, 0, 0, 26)
	bar.BackgroundColor3 = UIKit.TITLE
	bar.BorderSizePixel = 0
	bar.Parent = panel

	local label = Instance.new("TextLabel")
	label.Position = UDim2.new(0, 8, 0, 0)
	label.Size = UDim2.new(1, -40, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = UIKit.TEXT
	label.Text = text
	label.Parent = bar

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, 0, 0, 0)
	close.Size = UDim2.new(0, 26, 0, 26)
	close.BackgroundTransparency = 1
	close.Font = Enum.Font.GothamBold
	close.TextSize = 14
	close.TextColor3 = UIKit.DIM
	close.Text = "×"
	close.Activated:Connect(function()
		UIKit.closeAll()
	end)
	close.Parent = bar
	return bar
end

-- Panel coordination ------------------------------------------------------

local panels = {} -- frame -> true

-- Show `panel` and hide every other registered panel. Showing an already
-- visible panel hides it instead (toggle). Returns the new visibility.
function UIKit.showOnly(panel)
	local wasVisible = panel and panel.Visible
	for other in pairs(panels) do
		other.Visible = false
	end
	if panel and not wasVisible then
		panel.Visible = true
		return true
	end
	return false
end

function UIKit.registerPanel(panel)
	panels[panel] = true
	panel.Visible = false
end

function UIKit.closeAll()
	for other in pairs(panels) do
		other.Visible = false
	end
end

return UIKit
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>