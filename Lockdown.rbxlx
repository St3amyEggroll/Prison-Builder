<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Config: every "game designer number" lives in this one file.
-- Want cells cheaper, inmates to pay more, or a bigger prison?
-- Change a number here and rebuild — no real code needs touching.

local Config = {}

-- Money -----------------------------------------------------------------

-- Cash a brand-new warden starts with. It exactly covers the first cell,
-- so the very first thing a player does is buy something (instant win!).
Config.StartingCash = 50

-- Price of each cell, in order. Cell #1 costs 50, cell #2 costs 100, etc.
-- The list length also decides the max prison size for now (22 cells).
Config.CellCosts = {
	50, 100, 170, 280, 450, 700, 1100, 1700, 2600, 3900,
	5800, 8500, 12000, 17000, 24000, 33000, 45000, 60000,
	80000, 105000, 135000, 170000,
}
Config.MaxCells = #Config.CellCosts

-- Every PayoutInterval seconds, each inmate pays PayoutPerInmate cash.
-- 10 cash every 5 seconds = $2/sec per inmate. With the numbers above, a
-- new player affords cell #2 about 50 seconds in — under the golden-rule
-- 90 seconds for the first real upgrade.
Config.PayoutInterval = 5
Config.PayoutPerInmate = 10

-- World -----------------------------------------------------------------

-- How many player plots the server builds. Each visitor gets their own.
Config.PlotCount = 6

-- Saving ----------------------------------------------------------------

-- How often (seconds) progress is auto-saved, on top of saving when a
-- player leaves. Roblox limits DataStore writes, so keep this >= 60.
Config.AutosaveInterval = 60

-- Flavor ----------------------------------------------------------------

-- Inmate names, assigned by cell number (cell #1 always holds Sneaky
-- Pete). Silly on purpose — this is a cozy prison.
Config.InmateNames = {
	"Sneaky Pete", "Tunnel Tim", "Fingers McGee", "Slippery Sam",
	"Crowbar Carl", "Ladder Larry", "Muddy Marv", "Wall-Eye Wally",
	"Shovel Steve", "Grapple Gus", "Lockpick Lou", "Vent-Crawl Vince",
	"Bedsheet Bill", "Spoon Simon", "Laundry Lee", "Big House Bruno",
	"Quiet Quentin", "Two-Step Tony", "Gopher Gil", "Fence-Hop Fred",
	"Papers Pablo", "Half-Inch Hank",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Format: tiny helpers for turning numbers into friendly text,
-- shared by the server (buy-pad price tags) and the client (cash HUD).

local Format = {}

-- 1234567 -> "1,234,567"
function Format.thousands(n)
	local s = tostring(math.floor(n + 0.5))
	while true do
		local replaced
		s, replaced = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		if replaced == 0 then
			break
		end
	end
	return s
end

-- 1234567 -> "$1,234,567"
function Format.money(n)
	return "$" .. Format.thousands(n)
end

return Format
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Lockdown server bootstrap. This is the first script the game runs.
-- It creates the RemoteEvents (the "phone lines" the server and each
-- player's screen use to talk), then starts every game system in order.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Phone lines to the client:
--   Popup          -> "show a floating +$40 at this spot"
--   PurchaseResult -> "your buy attempt succeeded/failed, react!"
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local popupRemote = Instance.new("RemoteEvent")
popupRemote.Name = "Popup"
popupRemote.Parent = remotes

local purchaseRemote = Instance.new("RemoteEvent")
purchaseRemote.Name = "PurchaseResult"
purchaseRemote.Parent = remotes

remotes.Parent = ReplicatedStorage

-- Start the systems. Order matters: the world must exist before plots
-- are placed on it, and saving must be ready before players get plots.
local World = require(script.World)
local SaveService = require(script.SaveService)
local PlotService = require(script.PlotService)
local Economy = require(script.Economy)

World.build()
SaveService.init()
PlotService.init()
Economy.init()

print("[Lockdown] Server ready — Phase 1 MVP")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[-- Economy: the heartbeat of the money loop. Every few seconds, each
-- inmate pays their daily grant (well — five-secondly grant) to the
-- warden holding them. The client gets a Popup event so a satisfying
-- "+$40" floats up over the buy pad.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SaveService = require(script.Parent.SaveService)
local PlotService = require(script.Parent.PlotService)

local Economy = {}

function Economy.init()
	local popupRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Popup")

	task.spawn(function()
		while true do
			task.wait(Config.PayoutInterval)
			PlotService.eachOwnedPlot(function(player, plot)
				if plot.cellCount <= 0 then
					return
				end
				local amount = plot.cellCount * Config.PayoutPerInmate
				SaveService.addCash(player, amount)
				-- Only the owner sees their own popup — no screen spam
				-- from five other prisons paying out at once.
				popupRemote:FireClient(player, plot.pad.Position + Vector3.new(0, 4, 0), amount)
			end)
		end
	end)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">InmateService</string>
          <string name="Source"><![CDATA[-- InmateService: builds inmates as LIGHTWEIGHT CUSTOM RIGS.
--
-- This is the performance rule from the game plan, made real. A default
-- Roblox character carries a Humanoid — physics, a 20-state machine,
-- network ownership — and a prison full of those melts phones. Our
-- inmates are just 6 anchored blocks in a Model: no Humanoid, no
-- physics, no collisions, no shadows. Dozens of them cost almost
-- nothing. The gentle "idle sway" that makes them feel alive is done on
-- each player's own device (see client/InmateAnimator.luau), which is
-- free for the server.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local InmateService = {}

local SKIN = Color3.fromRGB(234, 184, 146)
local SHOE = Color3.fromRGB(60, 60, 60)

local function makePart(name, size, color, cframe, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.CFrame = cframe
	p.Anchored = true
	p.CanCollide = false -- players walk through inmates, never trip on them
	p.CanQuery = false -- invisible to raycasts (cheap)
	p.CanTouch = false -- fires no touch events (cheap)
	p.CastShadow = false -- shadows are a real cost with many rigs
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Builds one inmate standing at baseCF (feet on the ground at that spot).
-- cellIndex picks the name — cell #1 is always Sneaky Pete.
function InmateService.spawn(baseCF, cellIndex, parent)
	local model = Instance.new("Model")
	model.Name = "Inmate" .. cellIndex

	-- Every inmate gets a slightly different jumpsuit shade and sway
	-- rhythm so a full cellblock doesn't look like a copy-paste army.
	-- Seeding with cellIndex keeps each inmate looking the same each visit.
	local rng = Random.new(cellIndex * 7919)
	local jumpsuit = Color3.fromRGB(255, 120 + rng:NextInteger(0, 40), 25 + rng:NextInteger(0, 25))

	-- Face a random direction inside the cell.
	local root = baseCF * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)

	-- Classic R6 proportions: 2-stud legs, 2-stud torso, 1-stud head.
	makePart("LeftLeg", Vector3.new(1, 2, 1), SHOE, root * CFrame.new(-0.5, 1, 0), model)
	makePart("RightLeg", Vector3.new(1, 2, 1), SHOE, root * CFrame.new(0.5, 1, 0), model)
	local torso = makePart("Torso", Vector3.new(2, 2, 1), jumpsuit, root * CFrame.new(0, 3, 0), model)
	makePart("LeftArm", Vector3.new(1, 2, 1), jumpsuit, root * CFrame.new(-1.5, 3, 0), model)
	makePart("RightArm", Vector3.new(1, 2, 1), jumpsuit, root * CFrame.new(1.5, 3, 0), model)
	local head = makePart("Head", Vector3.new(1.2, 1.2, 1.2), SKIN, root * CFrame.new(0, 4.6, 0), model)

	-- The classic Roblox smile, shipped inside the engine (no download).
	local face = Instance.new("Decal")
	face.Name = "Face"
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head

	-- Floating name tag.
	local nameIndex = ((cellIndex - 1) % #Config.InmateNames) + 1
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.new(0, 130, 0, 26)
	tag.StudsOffset = Vector3.new(0, 1.4, 0)
	tag.MaxDistance = 70 -- vanishes when far away: less to draw
	tag.AlwaysOnTop = false
	local tagText = Instance.new("TextLabel")
	tagText.Size = UDim2.new(1, 0, 1, 0)
	tagText.BackgroundTransparency = 1
	tagText.Font = Enum.Font.GothamBold
	tagText.TextScaled = true
	tagText.TextColor3 = Color3.fromRGB(255, 220, 180)
	tagText.TextStrokeTransparency = 0.4
	tagText.Text = Config.InmateNames[nameIndex]
	tagText.Parent = tag
	tag.Parent = head

	model.PrimaryPart = torso

	-- The client-side animator finds inmates through this tag, and uses
	-- Seed so everyone sways off-beat from their neighbors.
	model:SetAttribute("Seed", rng:NextNumber(0, math.pi * 2))
	CollectionService:AddTag(model, "Inmate")

	model.Parent = parent
	return model
end

return InmateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- PlotService: the heart of Phase 1. Builds the row of prison plots,
-- gives every joining player their own, and handles the one big verb of
-- the MVP: step on the glowing pad -> buy a cell -> an inmate moves in.
--
-- Layout of one plot (bird's-eye view, front gate at the bottom):
--
--        [c1][c2][c3][c4][c5][c6][c7][c8]      <- back row of cells
--      [c9]                          [c16]
--      [c10]                         [c17]
--      [c11]        (yard)           [c18]     <- cells fill the walls
--      [c12]                         [c19]        as you buy them
--      [c13]                         [c20]
--      [c14]         (pad)           [c21]
--      [c15]      __gate gap__       [c22]
--
-- Cells are just decoration + one inmate each. All the money math stays
-- in SaveService; all the rig building stays in InmateService.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local World = require(script.Parent.World)
local SaveService = require(script.Parent.SaveService)
local InmateService = require(script.Parent.InmateService)

local PlotService = {}

local COLOR_WALL = Color3.fromRGB(200, 198, 190)
local COLOR_FLOOR = Color3.fromRGB(120, 120, 125)
local COLOR_CELL_FLOOR = Color3.fromRGB(95, 95, 100)
local COLOR_BARS = Color3.fromRGB(35, 35, 40)
local COLOR_PAD = Color3.fromRGB(80, 255, 100)

-- Where each cell sits inside a plot, in plot-local studs (plot center is
-- 0,0). "face" is the direction the open, barred side points (toward the
-- yard). 8 across the back, 7 down each side = 22, matching Config.
local CELL_SLOTS = {}
do
	for i = 1, 8 do
		CELL_SLOTS[i] = { pos = Vector3.new(-49 + (i - 1) * 14, 0, -52), face = Vector3.new(0, 0, 1) }
	end
	for i = 1, 7 do
		CELL_SLOTS[8 + i] = { pos = Vector3.new(-56, 0, -37 + (i - 1) * 14), face = Vector3.new(1, 0, 0) }
	end
	for i = 1, 7 do
		CELL_SLOTS[15 + i] = { pos = Vector3.new(56, 0, -37 + (i - 1) * 14), face = Vector3.new(-1, 0, 0) }
	end
	assert(#CELL_SLOTS == Config.MaxCells, "CELL_SLOTS must match Config.CellCosts length")
end

local plots = {} -- plot index -> plot record
local playerPlots = {} -- player -> plot record
local lastBuyAttempt = {} -- player -> os.clock() of last pad touch (debounce)

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local purchaseRemote = remotes:WaitForChild("PurchaseResult")

-- Building ---------------------------------------------------------------

local function padText(plot)
	if plot.cellCount >= Config.MaxCells then
		return ("🔒 PRISON FULL!\n%d cells"):format(Config.MaxCells)
	end
	local nextCost = Config.CellCosts[plot.cellCount + 1]
	return ("🔒 Buy Cell #%d\n%s"):format(plot.cellCount + 1, Format.money(nextCost))
end

local function signText(plot)
	if plot.owner then
		return "🔒 " .. plot.owner.DisplayName .. "'s Prison"
	end
	return "Unclaimed Prison"
end

-- One plot: floor slab, four walls with a gate gap, a name sign, and the
-- glowing buy pad. Cells get added later, one purchase at a time.
local function buildPlot(index)
	local originCF = CFrame.new((index - (Config.PlotCount + 1) / 2) * 170, 0, -40)

	local model = Instance.new("Model")
	model.Name = "Plot" .. index

	-- Floor slab; its top sits at Y = 0.5.
	World.part({
		Name = "Slab",
		Size = Vector3.new(130, 1, 130),
		CFrame = originCF,
		Material = Enum.Material.Concrete,
		Color = COLOR_FLOOR,
	}, model)

	-- Perimeter walls, 10 studs tall. The front wall has a 16-stud gate
	-- gap so players can walk in.
	local wallSpecs = {
		{ Vector3.new(130, 10, 1.5), CFrame.new(0, 5.5, -60) }, -- back
		{ Vector3.new(1.5, 10, 118), CFrame.new(-64.25, 5.5, 0) }, -- left
		{ Vector3.new(1.5, 10, 118), CFrame.new(64.25, 5.5, 0) }, -- right
		{ Vector3.new(57, 10, 1.5), CFrame.new(-36.5, 5.5, 60) }, -- front-left of gate
		{ Vector3.new(57, 10, 1.5), CFrame.new(36.5, 5.5, 60) }, -- front-right of gate
	}
	for _, spec in ipairs(wallSpecs) do
		World.part({
			Name = "Wall",
			Size = spec[1],
			CFrame = originCF * spec[2],
			Material = Enum.Material.Concrete,
			Color = COLOR_WALL,
		}, model)
	end

	-- Invisible post above the gate holding the prison's name sign.
	local signPost = World.part({
		Name = "SignPost",
		Size = Vector3.new(1, 1, 1),
		CFrame = originCF * CFrame.new(0, 13, 60),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, model)
	local signGui = Instance.new("BillboardGui")
	signGui.Name = "Sign"
	signGui.Size = UDim2.new(0, 320, 0, 70)
	signGui.MaxDistance = 400
	local signLabel = Instance.new("TextLabel")
	signLabel.Size = UDim2.new(1, 0, 1, 0)
	signLabel.BackgroundTransparency = 1
	signLabel.Font = Enum.Font.GothamBold
	signLabel.TextScaled = true
	signLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	signLabel.TextStrokeTransparency = 0.3
	signGui.Parent = signPost
	signLabel.Parent = signGui

	-- The glowing buy pad: a flat neon cylinder near the gate. Stepping
	-- on it is how you buy (works identically on PC and phones — no UI).
	local pad = World.part({
		Name = "BuyPad",
		Shape = Enum.PartType.Cylinder,
		-- A cylinder's height runs along X, so we lay it flat by rolling
		-- it 90 degrees; it becomes a 8-stud-wide, 0.5-thick disc.
		Size = Vector3.new(0.5, 8, 8),
		CFrame = originCF * CFrame.new(0, 0.85, 45) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = COLOR_PAD,
		CanCollide = false,
	}, model)
	local padGui = Instance.new("BillboardGui")
	padGui.Name = "PriceTag"
	padGui.Size = UDim2.new(0, 220, 0, 64)
	padGui.StudsOffset = Vector3.new(0, 4, 0)
	padGui.MaxDistance = 180
	local padLabel = Instance.new("TextLabel")
	padLabel.Size = UDim2.new(1, 0, 1, 0)
	padLabel.BackgroundTransparency = 1
	padLabel.Font = Enum.Font.GothamBold
	padLabel.TextScaled = true
	padLabel.TextColor3 = Color3.fromRGB(170, 255, 170)
	padLabel.TextStrokeTransparency = 0.3
	padGui.Parent = pad
	padLabel.Parent = padGui

	-- Purchased cells and their inmates live in these folders.
	local cellsFolder = Instance.new("Folder")
	cellsFolder.Name = "Cells"
	cellsFolder.Parent = model
	local inmatesFolder = Instance.new("Folder")
	inmatesFolder.Name = "Inmates"
	inmatesFolder.Parent = model

	model.Parent = workspace.Lockdown

	local plot = {
		index = index,
		originCF = originCF,
		model = model,
		pad = pad,
		padLabel = padLabel,
		signLabel = signLabel,
		cellsFolder = cellsFolder,
		inmatesFolder = inmatesFolder,
		owner = nil,
		cellCount = 0,
	}
	plot.padLabel.Text = padText(plot)
	plot.signLabel.Text = signText(plot)

	pad.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player or plot.owner ~= player then
			return
		end
		-- Walking over the pad fires Touched many times a second; only
		-- consider one buy attempt per second per player.
		local now = os.clock()
		if lastBuyAttempt[player] and now - lastBuyAttempt[player] < 1 then
			return
		end
		lastBuyAttempt[player] = now
		PlotService.tryBuyCell(player)
	end)

	return plot
end

-- One cell: floor, three low walls, jail bars across the yard side, a
-- bed, and its resident inmate.
local function buildCell(plot, cellIndex)
	local slot = CELL_SLOTS[cellIndex]
	-- Cell-local space: -Z points out through the bars toward the yard.
	local base = plot.originCF * CFrame.new(0, 0.5, 0)
		* CFrame.lookAt(slot.pos, slot.pos + slot.face)

	local cell = Instance.new("Model")
	cell.Name = "Cell" .. cellIndex

	World.part({
		Name = "Floor",
		Size = Vector3.new(13.4, 0.4, 11.4),
		CFrame = base * CFrame.new(0, 0.2, 0),
		Material = Enum.Material.Concrete,
		Color = COLOR_CELL_FLOOR,
	}, cell)

	-- Back and side walls (the plot's perimeter wall looms behind).
	World.part({
		Name = "BackWall",
		Size = Vector3.new(13.4, 7, 0.4),
		CFrame = base * CFrame.new(0, 3.9, 5.5),
		Material = Enum.Material.Concrete,
		Color = COLOR_WALL,
	}, cell)
	for _, x in ipairs({ -6.5, 6.5 }) do
		World.part({
			Name = "SideWall",
			Size = Vector3.new(0.4, 7, 11.4),
			CFrame = base * CFrame.new(x, 3.9, 0),
			Material = Enum.Material.Concrete,
			Color = COLOR_WALL,
		}, cell)
	end

	-- Jail bars across the front. Purely decorative in Phase 1 — but they
	-- make it a prison.
	for k = 0, 5 do
		World.part({
			Name = "Bar",
			Size = Vector3.new(0.35, 6.6, 0.35),
			CFrame = base * CFrame.new(-5.4 + k * 2.16, 3.7, -5.5),
			Material = Enum.Material.Metal,
			Color = COLOR_BARS,
		}, cell)
	end
	World.part({
		Name = "BarRail",
		Size = Vector3.new(13.4, 0.4, 0.4),
		CFrame = base * CFrame.new(0, 7.2, -5.5),
		Material = Enum.Material.Metal,
		Color = COLOR_BARS,
	}, cell)

	-- A little bed: frame, mattress, pillow.
	World.part({
		Name = "BedFrame",
		Size = Vector3.new(2.8, 0.5, 5.6),
		CFrame = base * CFrame.new(4.7, 0.65, 1.8),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(70, 70, 75),
	}, cell)
	World.part({
		Name = "Mattress",
		Size = Vector3.new(2.6, 0.6, 5.4),
		CFrame = base * CFrame.new(4.7, 1.2, 1.8),
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(235, 235, 230),
	}, cell)
	World.part({
		Name = "Pillow",
		Size = Vector3.new(2.2, 0.35, 1.3),
		CFrame = base * CFrame.new(4.7, 1.65, -0.4),
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(255, 170, 60),
	}, cell)

	cell.Parent = plot.cellsFolder

	-- The resident moves in, standing on the cell floor.
	InmateService.spawn(base * CFrame.new(-2, 0.4, 1), cellIndex, plot.inmatesFolder)
end

-- Claiming & buying -------------------------------------------------------

local function assignPlot(player)
	-- Wait for the player's save to load so we know how many cells to
	-- rebuild. If they left mid-load, waitForData returns nil.
	local data = SaveService.waitForData(player)
	if not data or not player:IsDescendantOf(game) then
		return
	end

	local plot = nil
	for _, candidate in ipairs(plots) do
		if candidate.owner == nil then
			plot = candidate
			break
		end
	end
	if not plot then
		-- More visitors than plots (7+ players). MVP limitation: they can
		-- wander and watch. Phase 5's Break Out mode gives them a job.
		warn("[Lockdown] No free plot for " .. player.Name)
		return
	end

	plot.owner = player
	playerPlots[player] = plot

	-- Rebuild everything they had saved from previous sessions.
	for i = 1, math.min(data.cells, Config.MaxCells) do
		plot.cellCount = i
		buildCell(plot, i)
	end
	plot.padLabel.Text = padText(plot)
	plot.signLabel.Text = signText(plot)

	-- Walk each new character to their own front gate (they spawn at the
	-- plaza otherwise, which is confusing).
	local function placeCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if not root or plot.owner ~= player then
			return
		end
		task.wait(0.1) -- let the default spawn placement finish first
		local gate = plot.originCF * CFrame.new(0, 3.5, 68)
		local lookAtPad = plot.originCF * CFrame.new(0, 3.5, 45)
		character:PivotTo(CFrame.lookAt(gate.Position, lookAtPad.Position))
	end
	player.CharacterAdded:Connect(placeCharacter)
	if player.Character then
		task.spawn(placeCharacter, player.Character)
	end
end

local function releasePlot(player)
	lastBuyAttempt[player] = nil
	local plot = playerPlots[player]
	if not plot then
		return
	end
	playerPlots[player] = nil
	plot.owner = nil
	plot.cellCount = 0
	plot.cellsFolder:ClearAllChildren()
	plot.inmatesFolder:ClearAllChildren()
	plot.padLabel.Text = padText(plot)
	plot.signLabel.Text = signText(plot)
end

function PlotService.tryBuyCell(player)
	local plot = playerPlots[player]
	if not plot then
		return
	end

	if plot.cellCount >= Config.MaxCells then
		purchaseRemote:FireClient(player, false, { reason = "full" })
		return
	end

	local cost = Config.CellCosts[plot.cellCount + 1]
	if not SaveService.trySpend(player, cost) then
		purchaseRemote:FireClient(player, false, {
			reason = "poor",
			shortfall = cost - SaveService.getCash(player),
		})
		return
	end

	plot.cellCount += 1
	SaveService.setCells(player, plot.cellCount)
	buildCell(plot, plot.cellCount)
	plot.padLabel.Text = padText(plot)

	purchaseRemote:FireClient(player, true, {
		cellIndex = plot.cellCount,
		cost = cost,
	})
end

-- Used by Economy to pay every prison owner each tick.
function PlotService.eachOwnedPlot(callback)
	for player, plot in pairs(playerPlots) do
		callback(player, plot)
	end
end

function PlotService.init()
	for i = 1, Config.PlotCount do
		plots[i] = buildPlot(i)
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(assignPlot, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(assignPlot, player)
	end
	Players.PlayerRemoving:Connect(releasePlot)
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">SaveService</string>
          <string name="Source"><![CDATA[-- SaveService: owns every player's money and progress, and saves it to
-- Roblox's DataStores (cloud storage tied to the published game).
--
-- Plain-English rules this file enforces:
--   * The SERVER is the only thing that ever changes your cash. A hacked
--     client can ask, but never take. This is Roblox security 101.
--   * If loading a player's save fails, we give them a fresh session but
--     REFUSE to save over their cloud data — a network hiccup must never
--     wipe someone's prison.
--   * Saves happen when you leave, every 60s (autosave), and when the
--     server shuts down.
--
-- Note for Studio: saving only works after the game is published with
-- "Studio Access to API Services" enabled (see SETUP.md). Before that,
-- everything still plays fine — progress just resets each session.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local SaveService = {}

-- The cloud storage bucket. The "_v1" suffix lets us switch to a fresh
-- bucket later if the save format ever changes drastically.
local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("Lockdown_v1")
	end)
	if ok then
		store = result
	else
		warn("[Lockdown] DataStores unavailable (normal in unpublished Studio). Progress won't save this session.")
	end
end

-- Live data for everyone currently in the server: player -> state table.
local state = {}

local function keyFor(player)
	return "p_" .. player.UserId
end

local function defaultData()
	return {
		cash = Config.StartingCash,
		cells = 0,
		totalEarned = 0,
	}
end

-- Try a DataStore read up to 3 times before giving up (Roblox services
-- occasionally hiccup; retrying quietly fixes most of it).
local function loadData(player)
	if not store then
		return nil, false
	end
	local key = keyFor(player)
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:GetAsync(key)
		end)
		if ok then
			return result, true -- result may be nil for a first-time player
		end
		warn(("[Lockdown] Load attempt %d failed for %s"):format(attempt, player.Name))
		task.wait(attempt) -- back off a little more each try
	end
	return nil, false
end

local function onPlayerAdded(player)
	local saved, loadOk = loadData(player)
	local data = saved or defaultData()

	-- leaderstats is a magic folder name: Roblox shows its values in the
	-- player list automatically. Free UI!
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local cashValue = Instance.new("IntValue")
	cashValue.Name = "Cash"
	cashValue.Value = data.cash
	cashValue.Parent = leaderstats

	local inmatesValue = Instance.new("IntValue")
	inmatesValue.Name = "Inmates"
	inmatesValue.Value = data.cells
	inmatesValue.Parent = leaderstats

	leaderstats.Parent = player

	state[player] = {
		cash = data.cash,
		cells = data.cells,
		totalEarned = data.totalEarned or 0,
		-- Only allowed to write to the cloud if the read worked. A failed
		-- read must never let default data overwrite a real save.
		canSave = store ~= nil and loadOk,
		cashValue = cashValue,
		inmatesValue = inmatesValue,
	}
end

local function saveNow(player)
	local st = state[player]
	if not st or not st.canSave then
		return
	end
	local snapshot = {
		cash = st.cash,
		cells = st.cells,
		totalEarned = st.totalEarned,
	}
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function()
			return snapshot
		end)
	end)
	if not ok then
		warn("[Lockdown] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
end

-- Public API used by the other systems ---------------------------------

-- Waits until the player's data has loaded (returns nil if they left).
function SaveService.waitForData(player)
	while state[player] == nil and player:IsDescendantOf(game) do
		task.wait(0.05)
	end
	return state[player]
end

function SaveService.getCash(player)
	local st = state[player]
	return st and st.cash or 0
end

-- Income and refunds go through here so leaderstats always stays in sync.
function SaveService.addCash(player, amount)
	local st = state[player]
	if not st then
		return
	end
	st.cash += amount
	if amount > 0 then
		st.totalEarned += amount
	end
	st.cashValue.Value = st.cash
end

-- Spending: only succeeds if the player can actually afford it.
function SaveService.trySpend(player, amount)
	local st = state[player]
	if not st or st.cash < amount then
		return false
	end
	st.cash -= amount
	st.cashValue.Value = st.cash
	return true
end

function SaveService.setCells(player, count)
	local st = state[player]
	if not st then
		return
	end
	st.cells = count
	st.inmatesValue.Value = count
end

function SaveService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	-- Catch anyone who joined before this script connected (rare, but
	-- classic Studio race condition).
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		saveNow(player)
		state[player] = nil
	end)

	-- Autosave loop, so a server crash can only ever lose ~1 minute.
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in pairs(state) do
				task.spawn(saveNow, player)
			end
		end
	end)

	-- When Roblox shuts this server down, save everyone before it dies.
	game:BindToClose(function()
		for player in pairs(state) do
			saveNow(player)
		end
	end)
end

return SaveService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- World: builds the shared map — the grass ground, the welcome plaza
-- where players first spawn, and pleasant daytime lighting. The prisons
-- themselves are built per-player by PlotService.

local Lighting = game:GetService("Lighting")

local World = {}

-- Small helper used all over the server: make an anchored Part in one
-- call. Everything in this game is anchored (nothing needs physics),
-- which is a big part of why it runs well on phones.
function World.part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		p[key] = value
	end
	p.Parent = parent
	return p
end

function World.build()
	-- One folder to hold everything we generate, so the Explorer window
	-- in Studio stays tidy.
	local root = Instance.new("Folder")
	root.Name = "Lockdown"

	-- The ground: one huge grass slab. Its top surface sits at Y = 0,
	-- which every other measurement in the game builds up from.
	World.part({
		Name = "Ground",
		Size = Vector3.new(1600, 4, 1600),
		CFrame = CFrame.new(0, -2, 0),
		Material = Enum.Material.Grass,
		Color = Color3.fromRGB(106, 153, 85),
	}, root)

	-- The welcome plaza, in front of the row of prisons. Players spawn
	-- here for a split second before PlotService walks them to their plot.
	World.part({
		Name = "Plaza",
		Size = Vector3.new(40, 1, 40),
		CFrame = CFrame.new(0, 0.25, 110),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(163, 162, 165),
	}, root)

	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "Spawn"
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.CFrame = CFrame.new(0, 0.9, 110)
	spawnLocation.Anchored = true
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0 -- no forcefield bubble
	spawnLocation.Material = Enum.Material.SmoothPlastic
	spawnLocation.Color = Color3.fromRGB(80, 109, 84)
	spawnLocation.Parent = root

	root.Parent = workspace

	-- Sunny mid-afternoon, always.
	Lighting.ClockTime = 14
	Lighting.Brightness = 2
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="11">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="12">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="13">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Lockdown client bootstrap. Runs on each player's own device and starts
-- everything the player personally sees: the cash HUD, the floating
-- "+$" popups, and the little idle sway that brings inmates to life.

require(script.CashHud).start()
require(script.Popups).start()
require(script.InmateAnimator).start()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CashHud</string>
            <string name="Source"><![CDATA[-- CashHud: the on-screen money display, built entirely from code.
--   * Big cash counter, top-center, that smoothly counts up (juice!).
--   * An income line: "4 inmates · $8/sec".
--   * A hint bar at the bottom that doubles as the feedback line for
--     purchases ("Cell #3 built!" / "Need $120 more!").
-- Everything uses scale-friendly sizes and TextScaled so it reads fine
-- on a phone.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Format = require(ReplicatedStorage.Shared:WaitForChild("Format"))

local CashHud = {}

local DEFAULT_HINT = "Walk onto the glowing green pad to buy a cell 🔑"

local function playBuiltInSound(fileName, volume)
	-- These sounds ship inside the Roblox engine itself — nothing to
	-- download, they can never go missing.
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxasset://sounds/" .. fileName
	sound.Volume = volume
	SoundService:PlayLocalSound(sound)
	sound:Destroy()
end

function CashHud.start()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local leaderstats = player:WaitForChild("leaderstats")
	local cashValue = leaderstats:WaitForChild("Cash")
	local inmatesValue = leaderstats:WaitForChild("Inmates")

	local gui = Instance.new("ScreenGui")
	gui.Name = "LockdownHUD"
	gui.ResetOnSpawn = false -- HUD survives respawns

	-- Cash panel -------------------------------------------------------
	local panel = Instance.new("Frame")
	panel.Name = "CashPanel"
	panel.AnchorPoint = Vector2.new(0.5, 0)
	panel.Position = UDim2.new(0.5, 0, 0, 10)
	panel.Size = UDim2.new(0, 250, 0, 74)
	panel.BackgroundColor3 = Color3.fromRGB(20, 24, 20)
	panel.BackgroundTransparency = 0.25
	panel.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = panel

	local cashLabel = Instance.new("TextLabel")
	cashLabel.Name = "Cash"
	cashLabel.Size = UDim2.new(1, -16, 0, 44)
	cashLabel.Position = UDim2.new(0, 8, 0, 4)
	cashLabel.BackgroundTransparency = 1
	cashLabel.Font = Enum.Font.GothamBlack
	cashLabel.TextScaled = true
	cashLabel.TextColor3 = Color3.fromRGB(140, 255, 150)
	cashLabel.Text = Format.money(cashValue.Value)
	cashLabel.Parent = panel

	local incomeLabel = Instance.new("TextLabel")
	incomeLabel.Name = "Income"
	incomeLabel.Size = UDim2.new(1, -16, 0, 20)
	incomeLabel.Position = UDim2.new(0, 8, 0, 48)
	incomeLabel.BackgroundTransparency = 1
	incomeLabel.Font = Enum.Font.Gotham
	incomeLabel.TextScaled = true
	incomeLabel.TextColor3 = Color3.fromRGB(210, 210, 210)
	incomeLabel.Parent = panel

	panel.Parent = gui

	-- Hint / feedback bar ---------------------------------------------
	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -14)
	hint.Size = UDim2.new(0.9, 0, 0, 30)
	hint.BackgroundTransparency = 1
	hint.Font = Enum.Font.GothamBold
	hint.TextScaled = true
	hint.TextColor3 = Color3.fromRGB(255, 255, 255)
	hint.TextStrokeTransparency = 0.4
	hint.Text = DEFAULT_HINT
	hint.Parent = gui

	gui.Parent = playerGui

	-- Smooth count-up: the shown number chases the real number every
	-- frame instead of teleporting. Cheap and very satisfying.
	local shown = cashValue.Value
	RunService.RenderStepped:Connect(function(dt)
		local target = cashValue.Value
		if shown ~= target then
			shown += (target - shown) * math.min(dt * 6, 1)
			if math.abs(target - shown) < 1 then
				shown = target
			end
			cashLabel.Text = Format.money(shown)
		end
	end)

	local function refreshIncome()
		local n = inmatesValue.Value
		local perSec = n * Config.PayoutPerInmate / Config.PayoutInterval
		incomeLabel.Text = ("%d inmate%s · %s/sec"):format(n, n == 1 and "" or "s", Format.money(perSec))
	end
	refreshIncome()
	inmatesValue.Changed:Connect(refreshIncome)

	-- Purchase feedback ------------------------------------------------
	-- Each message bumps this counter; a message only clears itself if a
	-- newer one hasn't replaced it in the meantime.
	local messageId = 0
	local function flashHint(text, color)
		messageId += 1
		local id = messageId
		hint.Text = text
		hint.TextColor3 = color
		task.delay(2.5, function()
			if messageId == id then
				hint.Text = DEFAULT_HINT
				hint.TextColor3 = Color3.fromRGB(255, 255, 255)
			end
		end)
	end

	local purchaseRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PurchaseResult")
	purchaseRemote.OnClientEvent:Connect(function(success, info)
		if success then
			flashHint(
				("Cell #%d built — a new inmate moved in! 🔒"):format(info.cellIndex),
				Color3.fromRGB(140, 255, 150)
			)
			playBuiltInSound("electronicpingshort.wav", 0.6)
		elseif info.reason == "poor" then
			flashHint(
				("Need %s more for the next cell!"):format(Format.money(info.shortfall)),
				Color3.fromRGB(255, 120, 110)
			)
			playBuiltInSound("uuhhh.mp3", 0.4)
		elseif info.reason == "full" then
			flashHint("Your prison is full — max cells reached! 🏆", Color3.fromRGB(255, 215, 120))
		end
	end)
end

return CashHud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">InmateAnimator</string>
            <string name="Source"><![CDATA[-- InmateAnimator: makes the blocky inmates feel alive without costing
-- anything. Server-side they are frozen statues; on each player's own
-- device this script gives nearby ones a slow idle sway (a little turn
-- of the shoulders, a tiny breathing bob).
--
-- Performance rules baked in:
--   * Inmates farther than CULL_DISTANCE from the camera don't animate
--     at all — you can't see a 0.1-stud bob from 60 studs away.
--   * Everything is plain CFrame math on anchored parts: no Humanoids,
--     no physics, no animation tracks. A phone shrugs at 100 of these.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local InmateAnimator = {}

local CULL_DISTANCE = 160

function InmateAnimator.start()
	-- model -> { base = original pose, seed = personal rhythm offset }
	local tracked = {}

	local function watch(model)
		-- The model streams in part-by-part; wait until its PrimaryPart
		-- (the torso) exists before measuring its resting pose.
		task.spawn(function()
			local tries = 0
			while model.PrimaryPart == nil and model.Parent ~= nil and tries < 100 do
				tries += 1
				task.wait(0.1)
			end
			if model.PrimaryPart and model.Parent then
				tracked[model] = {
					base = model:GetPivot(),
					seed = model:GetAttribute("Seed") or 0,
				}
			end
		end)
	end

	for _, model in ipairs(CollectionService:GetTagged("Inmate")) do
		watch(model)
	end
	CollectionService:GetInstanceAddedSignal("Inmate"):Connect(watch)
	CollectionService:GetInstanceRemovedSignal("Inmate"):Connect(function(model)
		tracked[model] = nil
	end)

	RunService.Heartbeat:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		local t = os.clock()

		for model, info in pairs(tracked) do
			if model.Parent == nil then
				tracked[model] = nil
				continue
			end
			local distance = (info.base.Position - camPos).Magnitude
			if distance > CULL_DISTANCE then
				continue
			end
			-- Slow shoulder sway + faint breathing bob, offset by each
			-- inmate's personal seed so the cellblock never syncs up.
			local sway = math.sin(t * 0.9 + info.seed) * 0.25
			local bob = math.abs(math.sin(t * 1.7 + info.seed)) * 0.08
			model:PivotTo(info.base * CFrame.new(0, bob, 0) * CFrame.Angles(0, sway, 0))
		end
	end)
end

return InmateAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Popups</string>
            <string name="Source"><![CDATA[-- Popups: floating "+$40" text in the world whenever your inmates pay
-- up. Each popup is a tiny invisible part with a BillboardGui that
-- drifts upward and fades — created on this player's device only, so it
-- costs the server nothing.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Format"))

local Popups = {}

function Popups.start()
	local popupRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Popup")

	popupRemote.OnClientEvent:Connect(function(worldPosition, amount)
		local anchor = Instance.new("Part")
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.CFrame = CFrame.new(worldPosition)

		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.new(0, 130, 0, 40)
		gui.StudsOffset = Vector3.new(0, 0, 0)
		gui.AlwaysOnTop = true
		gui.MaxDistance = 250

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(140, 255, 150)
		label.TextStrokeTransparency = 0.3
		label.Text = "+" .. Format.money(amount)
		label.Parent = gui
		gui.Parent = anchor
		anchor.Parent = workspace

		-- Drift up 4 studs while the text fades out, then self-destruct.
		local drift = TweenService:Create(gui, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			StudsOffset = Vector3.new(0, 4, 0),
		})
		local fade = TweenService:Create(label, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		drift:Play()
		fade:Play()
		Debris:AddItem(anchor, 1.6)
	end)
end

return Popups
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>